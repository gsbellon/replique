# Replication package: "Who Owns Granularity?"
#
#   make all       regenerate every result and figure reported in the article
#   make results   run the simulations only
#   make figures   regenerate the eight figures at 600 dpi
#   make verify    re-run and check the headline numbers against the article
#   make clean     remove generated artefacts
#
# Requires Python 3.11+ and the pinned versions in requirements.txt.
# Everything is deterministic: seed 20260823, NumPy default_rng (PCG64).

PY := python3
FIGS := figures/Figure_1.png figures/Figure_2.png figures/Figure_3.png \
        figures/Figure_4.png figures/Figure_5.png figures/Figure_6.png \
        figures/Figure_7.png figures/Figure_8.png

.PHONY: all results figures verify clean deps

all: results figures

deps:
	$(PY) -m pip install -r requirements.txt

results: archetype_results.json extended_results.json robustness_results.json

archetype_results.json: archetypes.py
	$(PY) archetypes.py

extended_results.json: extended_analyses.py archetype_results.json
	$(PY) extended_analyses.py

robustness_results.json: robustness_analyses.py archetypes.py
	$(PY) robustness_analyses.py

figures: $(FIGS)

$(FIGS): archetype_figures.py extended_figures.py archetype_results.json extended_results.json
	mkdir -p figures
	$(PY) archetype_figures.py
	$(PY) extended_figures.py
	mv -f f1_states.png      figures/Figure_1.png
	mv -f f2_premium.png     figures/Figure_2.png
	mv -f f3_optimum.png     figures/Figure_3.png
	mv -f Figure_4.png       figures/Figure_4.png
	mv -f f5_mechanisms.png  figures/Figure_5.png
	mv -f f6_scale.png       figures/Figure_6.png
	mv -f Figure_7.png       figures/Figure_7.png
	mv -f Figure_8.png       figures/Figure_8.png
	rm -f f4_tornado.png
	@echo "Figures written to figures/ at 600 dpi."

verify: results
	$(PY) verify.py

clean:
	rm -f archetype_results.json extended_results.json robustness_results.json arch_*.npy
	rm -f f*_*.png Figure_*.png
	rm -rf figures __pycache__
# Pinned to the versions used to produce every result and figure in the article.
# Verified on Python 3.12.3, Linux x86_64.
#
# Numerical results depend only on numpy (seeded PCG64 via default_rng) and
# scipy; matplotlib affects figure rendering only, not any reported number.
numpy==2.4.4
scipy==1.17.1
matplotlib==3.10.9
