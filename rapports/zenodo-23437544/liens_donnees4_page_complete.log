<script>
const dsNameEl = document.getElementById('dsName');
const parts = window.location.pathname.split('/').filter(Boolean);
dsNameEl.textContent = parts[parts.length - 1] || 'Dataset';

const form = document.getElementById('regForm');
const overlay = document.getElementById('popupOverlay');
const titleEl = document.getElementById('popupTitle');
const msgEl = document.getElementById('popupMsg');
const btn = document.getElementById('popupBtn');
const serverError = document.getElementById('serverError');
const retry = document.getElementById('retryLink');

function showPopup(title, msg) {
  titleEl.textContent = title;
  msgEl.textContent = msg;
  overlay.style.display = 'block';
}

btn.onclick = () => overlay.style.display = 'none';

form.addEventListener('submit', async (e) => {
  e.preventDefault();
  serverError.style.display = 'none';
  retry.style.display = 'none';

  try {
    const res = await fetch(form.action, { method: 'POST', body: new FormData(form) });
    const data = await res.json();

    if (!data.ok) {
      if (data.type === 'server') serverError.style.display = 'block';
      showPopup('Error', data.message || 'Something went wrong.');
      return;
    }

    showPopup('Ready', data.message || 'Registration complete.');

    btn.textContent = 'Browse files';
    btn.onclick = () => {
      overlay.style.display = 'none';
      window.open((data.redirect || 'browse.php') + '?t=' + Date.now(), '_blank', 'noopener');
    };

    retry.style.display = 'inline';
    retry.onclick = (ev) => {
      ev.preventDefault();
      window.open((data.redirect || 'browse.php') + '?t=' + Date.now(), '_blank', 'noopener');
    };

  } catch (err) {
    serverError.style.display = 'block';
    showPopup('Server error', 'Server error. Please try again later.');
  }
});
</script>

