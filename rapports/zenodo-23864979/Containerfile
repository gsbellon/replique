FROM docker.io/library/python:3.12-slim
# Le paquet n'a pas de requirements.txt ; son README (Requirements) liste : sympy numpy scipy networkx matplotlib, sans version.
# Versions installées relevées dans build.log. Réseau nécessaire à la construction seulement (PyPI) ; les exécutions restent --network none.
RUN pip install --no-cache-dir sympy numpy scipy networkx matplotlib
