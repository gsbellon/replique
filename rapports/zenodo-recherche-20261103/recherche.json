modification": "https://zenodo.org/api/records/23700240/file-modification", "quota_increase": "https://zenodo.org/api/records/23700240/quota-increase", "requests": "https://zenodo.org/api/records/23700240/requests"}, "updated": "2026-10-27T19:24:48.198642+00:00", "recid": "23700240", "revision": 4, "files": [{"id": "e343a934-c7f3-4c3e-bb50-39b52f56afed", "key": "Bogota_water_rationing_replication-v2.0.0.zip", "size": 22044828, "checksum": "md5:0d14e0596043fa1e7935669e32ee2e97", "links": {"self": "https://zenodo.org/api/records/23700240/files/Bogota_water_rationing_replication-v2.0.0.zip/content"}}], "swh": null, "owners": [{"id": "1873340"}], "status": "published", "stats": {"downloads": 15, "unique_downloads": 15, "views": 26, "unique_views": 25, "version_downloads": 12, "version_unique_downloads": 12, "version_unique_views": 8, "version_views": 9}, "state": "done", "submitted": true}, {"created": "2026-10-27T13:28:55.714619+00:00", "modified": "2026-10-27T13:28:56.021317+00:00", "id": 23691533, "conceptrecid": "23691532", "doi": "10.5281/zenodo.23691533", "conceptdoi": "10.5281/zenodo.23691532", "doi_url": "https://doi.org/10.5281/zenodo.23691533", "metadata": {"title": "Replication package for \"A Fuzzy Hybrid Decision Support System (DSS) to Govern Non-linear Dynamics and Uncertainty in AI-Augmented Software Development\"", "doi": "10.5281/zenodo.23691533", "publication_date": "2026-10-27", "description": "<p>Replication package for the manuscript \"A Fuzzy Hybrid Decision Support System (DSS) to Govern Non-linear Dynamics and Uncertainty in AI-Augmented Software Development\".</p>\n<p>oss-dora-fuzzy.zip &mdash; longitudinal feasibility study : 110,481 merged pull requests of six GitHub repositories (microsoft/vscode, facebook/react, kubernetes/kubernetes, django/django, numpy/numpy, rust-lang/rust), 2019-Q1 to 2024-Q4, with the per-window completeness log; collection, proxy, analysis, robustness, diagnostic and figure scripts. `bash run.sh` regenerates all reported values.</p>\n<p>dora-fuzzy.zip &mdash; reference implementation of the Mamdani fuzzy inference system (three inputs, twelve rules, centroid defuzzification), REST API and web interface; squad-level inputs and expert ranks.</p>\n<p>&nbsp;</p>", "access_right": "open", "creators": [{"name": "Udrescu, Alexandru", "affiliation": "Valahia University of Targoviste", "orcid": "0009-0009-3553-9704"}, {"name": "Udrescu, Elena", "affiliation": "Valahia University of Targoviste", "orcid": "0009-0000-2468-0133"}, {"name": "Suduc, Ana-Maria", "affiliation": "Valahia University of Targoviste", "orcid": "0000-0002-6462-7609"}, {"name": "B\u00eezoi, Mihai", "affiliation": "Valahia University of Targoviste", "orcid": "0000-0001-5467-0825"}], "keywords": ["fuzzy inference", "Mamdani"], "related_identifiers": [{"identifier": "https://github.com/gadinaelena3/oss-dora-fuzzy", "relation": "isSupplementedBy", "resource_type": "software", "scheme": "url"}, {"identifier": "https://github.com/gadinaelena3/dora-fuzzy", "relation": "isSupplementedBy", "resource_type": "software", "scheme": "url"}], "version": "1.0", "resource_type": {"title": "Software", "type": "software"}, "license": {"id": "cc-by-4.0"}, "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "23691532"}}]}}, "title": "Replication package for \"A Fuzzy Hybrid Decision Support System (DSS) to Govern Non-linear Dynamics and Uncertainty in AI-Augmented Software Development\"", "links": {"self": "https://zenodo.org/api/records/23691533", "self_html": "https://zenodo.org/records/23691533", "preview_html": "https://zenodo.org/records/23691533?preview=1", "doi": "https://doi.org/10.5281/zenodo.23691533", "self_doi": "https://doi.org/10.5281/zenodo.23691533", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23691533", "reserve_doi": "https://zenodo.org/api/records/23691533/draft/pids/doi", "parent": "https://zenodo.org/api/records/23691532", "parent_html": "https://zenodo.org/records/23691532", "parent_doi": "https://doi.org/10.5281/zenodo.23691532", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23691532", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:23691533/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:23691533/sequence/default", "files": "https://zenodo.org/api/records/23691533/files", "media_files": "https://zenodo.org/api/records/23691533/media-files", "latest": "https://zenodo.org/api/records/23691533/versions/latest", "latest_html": "https://zenodo.org/records/23691533/latest", "versions": "https://zenodo.org/api/records/23691533/versions", "draft": "https://zenodo.org/api/records/23691533/draft", "access_links": "https://zenodo.org/api/records/23691533/access/links", "access_grants": "https://zenodo.org/api/records/23691533/access/grants", "access_users": "https://zenodo.org/api/records/23691533/access/users", "access_request": "https://zenodo.org/api/records/23691533/access/request", "access": "https://zenodo.org/api/records/23691533/access", "communities": "https://zenodo.org/api/records/23691533/communities", "communities-suggestions": "https://zenodo.org/api/records/23691533/communities-suggestions", "request_deletion": "https://zenodo.org/api/records/23691533/request-deletion", "file_modification": "https://zenodo.org/api/records/23691533/file-modification", "quota_increase": "https://zenodo.org/api/records/23691533/quota-increase", "requests": "https://zenodo.org/api/records/23691533/requests"}, "updated": "2026-10-27T13:28:56.021317+00:00", "recid": "23691533", "revision": 4, "files": [{"id": "63aa8d22-cacc-4d86-b4d2-cdee07fb0bda", "key": "dora-fuzzy.zip", "size": 102120, "checksum": "md5:fe2a2839f7927d307ff1d6f51e698380", "links": {"self": "https://zenodo.org/api/records/23691533/files/dora-fuzzy.zip/content"}}, {"id": "5b072106-2bda-48d5-8789-26eb0b809e04", "key": "oss-dora-fuzzy.zip", "size": 5666210, "checksum": "md5:f13f368831239c80a8381d9afe34c2bd", "links": {"self": "https://zenodo.org/api/records/23691533/files/oss-dora-fuzzy.zip/content"}}], "swh": null, "owners": [{"id": "1880504"}], "status": "published", "stats": {"downloads": 2, "unique_downloads": 2, "views": 13, "unique_views": 9, "version_downloads": 2, "version_unique_downloads": 2, "version_unique_views": 9, "version_views": 13}, "state": "done", "submitted": true}, {"created": "2026-10-27T08:29:33.242949+00:00", "modified": "2026-10-27T08:29:33.394243+00:00", "id": 23685753, "conceptrecid": "23312552", "doi": "10.5281/zenodo.23685753", "conceptdoi": "10.5281/zenodo.23312552", "doi_url": "https://doi.org/10.5281/zenodo.23685753", "metadata": {"title": "Replication package: Explainable machine-learning nowcasting in small samples", "doi": "10.5281/zenodo.23685753", "publication_date": "2026-10-27", "description": "<p>Replication package for the article \"Explainable machine-learning nowcasting in small samples with an application to energy-related inflation in T&uuml;rkiye\".</p>\n<p>The package nowcasts the monthly inflation rate of the Housing, Water, Electricity, Gas and Other Fuels component of the Turkish CPI from monthly macroeconomic variables, daily Brent oil prices and USD/TRY exchange rates, and hourly EP\u0130A\u015e day-ahead electricity prices (2012&ndash;2025). It contains the raw and processed data, the code for Elastic Net, XGBoost, LightGBM, forecast combinations, U-MIDAS and exponential-Almon MIDAS benchmarks, Diebold-Mariano tests with the Harvey-Leybourne-Newbold correction, the model confidence set, origin-wise SHAP values, robustness analyses, all result files (63 CSV) and figures.</p>\n<p>A single command (python reproduce_all.py) rebuilds the panel from the raw data, runs the smoke tests, estimates all models, and writes every table and figure reported in the article. Software versions are pinned in requirements.txt; the environment of the reference run is recorded in results/environment_report.txt. See README.md and REPRODUCIBILITY.md for details.</p>\n<p>Data sources: Central Bank of the Republic of T&uuml;rkiye (EVDS and one-week repo rate page), U.S. Energy Information Administration, and the EP\u0130A\u015e transparency platform. Raw data remain subject to the terms of their providers.</p>", "access_right": "open", "creators": [{"name": "Ye\u015filyayla, Hamid", "affiliation": "Pamukkale University", "orcid": "0000-0002-7309-615X"}], "keywords": ["nowcasting", "explainable machine learning", "SHAP", "gradient boosting", "mixed-frequency data", "MIDAS", "energy inflation", "T\u00fcrkiye", "Turkey"], "version": "1.0.1", "language": "eng", "custom": {"code:programmingLanguage": [{"id": "python", "title": {"en": "Python"}}], "code:developmentStatus": {"id": "active", "title": {"en": "Active"}}}, "resource_type": {"title": "Software", "type": "software"}, "license": {"id": "mit-license"}, "relations": {"version": [{"index": 1, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "23312552"}}]}, "notes": "<p>Version 1.0.1 updates README.md (final article title; institution name \"Central Bank of the Republic of T&uuml;rkiye\") and CITATION.cff (version and release date). Code, data and result files are identical to version 1.0.0.</p>"}, "title": "Replication package: Explainable machine-learning nowcasting in small samples", "links": {"self": "https://zenodo.org/api/records/23685753", "self_html": "https://zenodo.org/records/23685753", "preview_html": "https://zenodo.org/records/23685753?preview=1", "doi": "https://doi.org/10.5281/zenodo.23685753", "self_doi": "https://doi.org/10.5281/zenodo.23685753", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23685753", "reserve_doi": "https://zenodo.org/api/records/23685753/draft/pids/doi", "parent": "https://zenodo.org/api/records/23312552", "parent_html": "https://zenodo.org/records/23312552", "parent_doi": "https://doi.org/10.5281/zenodo.23312552", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23312552", "self_iiif_manifest": "https://