fc0a9286e89330fe9a87b63dd62c2", "links": {"self": "https://zenodo.org/api/records/23675983/files/build_ivs_2_codes.py/content"}}, {"id": "5e7608f7-c5e5-4fcd-ae4e-93537b7b6643", "key": "build_sampleB.py", "size": 2181, "checksum": "md5:c3cd614884a67913085475f62964d833", "links": {"self": "https://zenodo.org/api/records/23675983/files/build_sampleB.py/content"}}], "swh": null, "owners": [{"id": "1799149"}], "status": "published", "stats": {"downloads": 18, "unique_downloads": 18, "views": 7, "unique_views": 6, "version_downloads": 18, "version_unique_downloads": 18, "version_unique_views": 6, "version_views": 7}, "state": "done", "submitted": true}, {"created": "2026-10-26T18:29:03.795127+00:00", "modified": "2026-10-26T18:29:03.893389+00:00", "id": 23673342, "conceptrecid": "23673341", "doi": "10.5281/zenodo.23673342", "conceptdoi": "10.5281/zenodo.23673341", "doi_url": "https://doi.org/10.5281/zenodo.23673342", "metadata": {"title": "Fixed-reference Benefit-of-the-Doubt index on Alkire-Foster censored headcounts: replication package", "doi": "10.5281/zenodo.23673342", "publication_date": "2026-10-26", "description": "<p>Replication package accompanying manuscript version 4 of &ldquo;Pesos end&oacute;genos e refer&ecirc;ncia fixa na mensura&ccedil;&atilde;o territorial da pobreza multidimensional: evid&ecirc;ncia para o Brasil, 1991 a 2022&rdquo;. The method evaluates Alkire-Foster censored deprivation headcounts against a frozen 2010 state-level reference with a proportional coefficient restriction. The archive contains the R implementation, run_all.R, English replication instructions, variable documentation, aggregate results for 2010 and 2022 with a historical extension to 1991 and 2000, robustness results, tests and SHA-256 manifests. Census microdata and household intermediate bases are excluded. The main 2010/2022 scripts obtain official public IBGE inputs; the historical extension requires separately obtained SPSS samples identified in the documentation. Scalar subgroup consistency applies to groups of whole states with fixed population shares, not arbitrary within-state partitions. The v4 review re-estimated aggregate scores and relevant checks, rather than rerunning all raw-data processing. Release 1.0.0 corresponds to manuscript v4 (26 October 2026). The manuscript is unpublished. Code and documentation: MIT license. Repository: https://github.com/moisesluna2026/bod-fixed-mpi</p>", "access_right": "open", "creators": [{"name": "Brand\u00e3o, Mois\u00e9s Luna", "affiliation": null}, {"name": "Mariano, Enzo Barberio", "affiliation": null}, {"name": "Rebelatto, Daisy Aparecida do Nascimento", "affiliation": null}], "keywords": ["multidimensional poverty"], "version": "1.0.0", "custom": {"code:codeRepository": "https://github.com/moisesluna2026/bod-fixed-mpi", "code:programmingLanguage": [{"id": "r", "title": {"en": "R"}}]}, "resource_type": {"title": "Software", "type": "software"}, "license": {"id": "mit-license"}, "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "23673341"}}]}}, "title": "Fixed-reference Benefit-of-the-Doubt index on Alkire-Foster censored headcounts: replication package", "links": {"self": "https://zenodo.org/api/records/23673342", "self_html": "https://zenodo.org/records/23673342", "preview_html": "https://zenodo.org/records/23673342?preview=1", "doi": "https://doi.org/10.5281/zenodo.23673342", "self_doi": "https://doi.org/10.5281/zenodo.23673342", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23673342", "reserve_doi": "https://zenodo.org/api/records/23673342/draft/pids/doi", "parent": "https://zenodo.org/api/records/23673341", "parent_html": "https://zenodo.org/records/23673341", "parent_doi": "https://doi.org/10.5281/zenodo.23673341", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23673341", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:23673342/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:2