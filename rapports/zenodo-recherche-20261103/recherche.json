e_views": 5, "version_views": 5}, "state": "done", "submitted": true}, {"created": "2026-10-27T21:28:19.098827+00:00", "modified": "2026-10-27T21:28:19.228744+00:00", "id": 23706750, "conceptrecid": "23073508", "doi": "10.5281/zenodo.23706750", "conceptdoi": "10.5281/zenodo.23073508", "doi_url": "https://doi.org/10.5281/zenodo.23706750", "metadata": {"title": "Replication package: maps of credit and gold mining in colonial New Granada, 1703\u20131790", "doi": "10.5281/zenodo.23706750", "publication_date": "2026-10-27", "description": "<p>Adds Map 3.1 from Chapter 3: mining camps of the 1755 census and areas worked by free mazamorreros in N\u00f3vita and Caj\u00f3n, ca. 1755-1790, with its data and sources. Adds the Taparral and other streams to the river file. The earlier maps for introduction and chapters 1 and 2 are unchanged. The package title is changed to &quot;maps of credit and gold mining in colonial New Granada, 1703-1790.&quot;</p>", "access_right": "open", "creators": [{"name": "Ortiz Molina, Amanda Carolina", "affiliation": "Binghamton University, State University of New York"}], "related_identifiers": [{"identifier": "https://github.com/aortizm1/ortiz_dissertation_maps_2026/tree/v1.2.0", "relation": "isSupplementTo", "resource_type": "software", "scheme": "url"}], "version": "v1.2.0", "custom": {"code:codeRepository": "https://github.com/aortizm1/ortiz_dissertation_maps_2026"}, "resource_type": {"title": "Software", "type": "software"}, "license": {"id": "mit-license"}, "relations": {"version": [{"index": 2, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "23073508"}}]}, "notes": "If you use these maps, data or code, please cite them as below."}, "title": "Replication package: maps of credit and gold mining in colonial New Granada, 1703\u20131790", "links": {"self": "https://zenodo.org/api/records/23706750", "self_html": "https://zenodo.org/records/23706750", "preview_html": "https://zenodo.org/records/23706750?preview=1", "doi": "https://