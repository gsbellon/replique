cords/23595425/request-deletion", "file_modification": "https://zenodo.org/api/records/23595425/file-modification", "quota_increase": "https://zenodo.org/api/records/23595425/quota-increase", "requests": "https://zenodo.org/api/records/23595425/requests"}, "updated": "2026-10-24T01:32:18.071422+00:00", "recid": "23595425", "revision": 4, "files": [{"id": "c5bfd4e2-da33-467d-91c5-14be9bf92459", "key": "replication_package.zip", "size": 185156429, "checksum": "md5:4218a296a4f25c89bc1b8c4d5b810dd4", "links": {"self": "https://zenodo.org/api/records/23595425/files/replication_package.zip/content"}}], "swh": null, "owners": [{"id": "599469"}], "status": "published", "stats": {"downloads": 1, "unique_downloads": 1, "views": 17, "unique_views": 16, "version_downloads": 0, "version_unique_downloads": 0, "version_unique_views": 5, "version_views": 5}, "state": "done", "submitted": true}, {"created": "2026-10-24T01:20:18.280190+00:00", "modified": "2026-10-24T01:20:18.434748+00:00", "id": 23607619, "conceptrecid": "23598207", "doi": "10.5281/zenodo.23607619", "conceptdoi": "10.5281/zenodo.23598207", "doi_url": "https://doi.org/10.5281/zenodo.23607619", "metadata": {"title": "Replication Package for \"Microservice Infrastructure Patterns and Where to Find Them: Evidence from Practitioners\"", "doi": "10.5281/zenodo.23607619", "publication_date": "2026-10-24", "description": "<p>This package accompanies the ICSE 2027 Software Engineering in Practice (SEIP) paper \"Microservice Infrastructure Patterns and Where to Find Them: Evidence from Practitioners\". The paper itself is in paper/.</p>\n<p>&nbsp;</p>\n<p>It holds the survey data, the outputs of the LLM-based approach, the experts' judgments of those outputs, and the code and notebooks that analyse them. With it you can recompute every result, table and figure of the paper, inspect each answer, model decision and expert judgment behind them, and rerun the approach on these or other answers. The survey answers and model outputs ship with personal information replaced by pseudonyms. One command (docker compose run --rm reproduce) recomputes every number and figure from the shipped data and checks the run against the shipped results. README.md explains the contents and how to use them.</p>", "access_right": "open", "creators": [{"name": "Duarte, Carlos Eduardo", "affiliation": "INESC TEC", "orcid": "0000-0002-5141-2641"}, {"name": "Esposito, Matteo", "affiliation": "University of Oulu", "orcid": "0000-0002-8451-3668"}, {"name": "Lenarduzzi, Valentina", "affiliation": "University of Oulu", "orcid": "0000-0003-0511-5133"}, {"name": "Taibi, Davide", "affiliation": "Tampere University", "orcid": "0000-0002-3210-3990"}, {"name": "Harrison, Neil", "affiliation": "Utah Valley University", "orcid": "0009-0007-4620-8818"}, {"name": "Aguiar, Ademar", "affiliation": "Universidade do Porto Faculdade de Engenharia", "orcid": "0000-0002-4046-4729"}, {"name": "Correia, Filipe", "affiliation": "Universidade do Porto Faculdade de Engenharia", "orcid": "0000-0002-6653-1598"}], "keywords": ["microservices", "architectural patterns", "infrastructure patterns", "architectural knowledge", "practitioner survey", "large language models"], "related_identifiers": [{"identifier": "10.1109/ICSA66085.2026.00010", "relation": "requires", "resource_type": "dataset", "scheme": "doi"}], "dates": [{"type": "submitted"}], "language": "eng", "resource_type": {"title": "Dataset", "type": "dataset"}, "license": {"id": "cc-by-4.0"}, "relations": {"version": [{"index": 3, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "23598207"}}]}}, "title": "Replication Package for \"Microservice Infrastructure Patterns and Where to Find Them: Evidence from Practitioners\"", "links": {"self": "https://zenodo.org/api/records/23607619", "self_html": "https://zenodo.org/records/23607619", "preview_html": "https://zenodo.org/records/23607619?preview=1", "doi": "https://doi.org/10.5281/zenodo.23607619", "self_doi": "https://doi.org/10.5281/zenodo.23607619", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23607619", "reserve_doi": "https://zenodo.org/api/records/23607619/draft/pids/doi", "parent": "https://zenodo.org/api/records/23598207", "parent_html": "https://zenodo.org/records/23598207", "parent_doi": "https://doi.org/10.5281/zenodo.23598207", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23598207", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:23607619/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:23607619/sequence/default", "files": "https://zenodo.org/api/records/23607619/files", "media_files": "https://zenodo.org/api/records/23607619/media-files", "latest": "https://zenodo.org/api/records/23607619/versions/latest", "latest_html": "https://zenodo.org/records/23607619/latest", "versions": "https://zenodo.org/api/records/23607619/versions", "draft": "https://zenodo.org/api/records/23607619/draft", "access_links": "https://zenodo.org/api/records/23607619/access/links", "access_grants": "https://zenodo.org/api/records/23607619/access/grants", "access_users": "https://zenodo.org/api/records/23607619/access/users", "access_request": "https://zenodo.org/api/records/23607619/access/request", "access": "https://zenodo.org/api/records/23607619/access", "communities": "https://zenodo.org/api/records/23607619/communities", "communities-suggestions": "https://zenodo.org/api/records/23607619/communities-suggestions", "request_deletion": "https://zenodo.org/api/records/23607619/request-deletion", "file_modification": "https://zenodo.org/api/records/23607619/file-modification", "quota_increase": "https://zenodo.org/api/records/23607619/quota-increase", "requests": "https://zenodo.org/api/records/23607619/requests"}, "updated": "2026-10-24T01:20:18.434748+00:00", "recid": "23607619", "revision": 4, "files": [{"id": "5c987967-b812-4903-8bf2-c0b397786614", "key": "microservice-pattern-evidence-replication-package-v1.0.3.zip", "size": 3684335, "checksum": "md5:4c2452b674de8329d55bb0b9deeeffd9", "links": {"self": "https://zenodo.org/api/records/23607619/files/microservice-pattern-evidence-replication-package-v1.0.3.zip/content"}}], "swh": null, "owners": [{"id": "1459856"}], "status": "published", "stats": {"downloads": 0, "unique_downloads": 0, "views": 25, "unique_views": 20, "version_downloads": 0, "version_unique_downloads": 0, "version_unique_views": 10, "version_views": 11}, "state": "done", "submitted": true}, {"created": "2026-10-24T00:35:25.612245+00:00", "modified": "2026-10-24T00:35:26.843720+00:00", "id": 23607297, "conceptrecid": "23607296", "doi": "10.5281/zenodo.23607297", "conceptdoi": "10.5281/zenodo.23607296", "doi_url": "https://doi.org/10.5281/zenodo.23607297", "metadata": {"title": "Per-model language z-scores on LTBv1 (Chinese-source subset): replication package", "doi": "10.5281/zenodo.23607297", "publication_date": "2026-10-24", "description": "Replication package for the manuscript <i>Accumulating Invisibility: How Platformised AI Translation Converts Cultural Discount into a National-Image Externality</i> (submitted to <i>Global Media and China</i>).\n\n<p><b>Contents.</b> (1) <code>ltb_per_model_zscores.csv</code> - per-model within-model language z-scores computed on the Chinese-source items of the Last Translation Benchmark (LTBv1). 32 rows = 31 machine-translation systems (7 China-developed, 24 non-China-developed) plus one human baseline row, which is excluded from the model-level group comparison reported in the manuscript. Columns: <code>model</code>, <code>origin</code>, <code>zho_n</code> (number of Chinese-source cases scored), <code>within_model_z</code> (within-model standardised pass rate). (2) <code>recompute_from_release.py</code> - a self-contained replication script (Python standard library only, no network access). Run as <code>python recompute_from_release.py</code> on the CSV: it regenerates every figure reported in section 4.2 of the manuscript - China-developed n = 7, mean z = +1.3841, median +1.1851, 7/7 positive; non-China-developed n = 24, mean z = +0.0089, median z = -0.1221 (exact value -0.12215), 9/24 positive; Mann-Whitney U = 156; two-sided exact p = 1.8710e-04 (exact enumeration of all C(31,7) = 2,629,575 splits; no ties). (3) <code>README.md</code> and <code>ATTRIBUTION.md</code> - contents, provenance and licensing.</p>\n\n<p><b>Scope and interpretation.</b> The z-score standardises each model's pass rate on Chinese-source items against that same model's own cross-language pass-rate distribution. It is a capability-consistency diagnostic, not a measure of ideological stance, and it is a model-level statistic rather than a catalogue-level one.</p>\n\n<p><b>Upstream data.</b> This package does not redistribute LTBv1. The underlying benchmark is reported by Zouhar, V. et al. (2026), <i>The Last Translation Benchmark</i>, arXiv:2609.04173; dataset CC BY 4.0 (Hugging Face: zouhar/last-translation-benchmark), code MIT (GitHub: zouharvi/last-translation-benchmark). Only derived measurements are deposited here, under CC BY 4.0.</p>\n\n<p><b>Anonymity.</b> The deposit is made under an anonymous creator name to preserve the journal's double-anonymised review process.</p>", "access_right": "open", "creators": [{"name": "Anonymous", "affiliation": null}], "keywords": ["machine translation", "translation evaluation", "cultural discount", "within-model language z-score", "LTBv1", "Chinese-source translation", "replication package"], "related_identifiers": [{"identifier": "10.48550/arXiv.2609.04173", "relation": "isDerivedFrom", "scheme": "doi"}], "resource_type": {"title": "Dataset", "type": "dataset"}, "license": {"id": "cc-by-4.0"}, "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "23607296"}}]}}, "title": "Per-model language z-scores on LTBv1 (Chinese-source subset): replication package", "links": {"self": "https://zenodo.org/api/records/23607297", "self_html": "https://zenodo.org/records/23607297", "preview_html": "https://zenodo.org/records/23607297?preview=1", "doi": "https://doi.org/10.5281/zenodo.23607297", "self_doi": "https://doi.org/10.5281/zenodo.23607297", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23607297", "reserve_doi": "https://zenodo.org/api/records/23607297/draft/pids/doi", "parent": "https://zenodo.org/api/records/23607296", "parent_html": "https://zenodo.org/records/23607296", "parent_doi": "https://doi.org/10.5281/zenodo.23607296", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23607296", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:23607297/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:23607297/sequence/default", "files": "https://zenodo.org/api/records/23607297/files", "media_files": "https://zenodo.org/api/records/23607297/media-files", "latest": "https://zenodo.org/api/records/23607297/versions/latest", "latest_html": "https://zenodo.org/records/23607297/latest", "versions": "https://zenodo.org/api/records/23607297/versions", "draft": "https://zenodo.org/api/records/23607297/draft", "access_links": "https://zenodo.org/api/records/23607297/access/links", "access_grants": "https://zenodo.org/api/records/23607297/access/grants", "access_users": "https://zenodo.org/api/records/23607297/access/users", "access_request": "https://zenodo.org/api/records/23607297/access/request", "access": "https://zenodo.org/api/records/23607297/access", "communities": "https://zenodo.org/api/records/23607297/communities", "communities-suggestions": "https://zenodo.org/api/records/23607297/communities-suggestions", "request_deletion": "https://zenodo.org/api/records/23607297/request-deletion", "file_modification": "https://zenodo.org/api/records/23607297/file-modification", "quota_increase": "https://zenodo.org/api/records/23607297/quota-increase", "requests": "https://zenodo.org/api/records/23607297/requests"}, "updated": "2026-10-24T00:35:26.843720+00:00", "recid": "23607297", "revision": 4, "files": [{"id": "760d38a7-ba83-412f-a3f5-5e4bbba854fe", "key": "README.md", "size": 2011, "checksum": "md5:ac0aae2699ac7b0ee894428ad11ecea2", "links": {"self": "https://zenodo.org/api/records/23607297/files/README.md/content"}}, {"id": "d5dad128-ffbc-4f56-862a-94b20c322c26", "key": "ltb_per_model_zscores.csv", "size": 1102, "checksum": "md5:f8136fae24f386bb7bd619e79ca3623b", "links": {"self": "https://zenodo.org/api/records/23607297/files/ltb_per_model_zscores.csv/content"}}, {"id": "15bc24a8-787a-4dba-b650-d20ef64b9b74", "key": "recompute_from_release.py", "size": 4544, "checksum": "md5:d5b73c3ddec49226af754c17fb5e6aed", "links": {"self": "https://zenodo.org/api/records/23607297/files/recompute_from_release.py/content"}}, {"id": "b09cd60e-02ae-4848-b380-3a78989019bf", "key": "ATTRIBUTION.md", "size": 902, "checksum": "md5:9d488016fe58bc71ea2e32e2d32fee13", "links": {"self": "https://zenodo.org/api/records/23607297/files/ATTRIBUTION.md/content"}}], "swh": null, "owners": [{"id": "1953581"}], "status": "published", "stats": {"downloads": 0, "unique_downloads": 0, "views": 3, "unique_views": 2, "version_downloads": 0, "version_unique_downloads": 0, "version_unique_views": 2, "version_views": 3}, "state": "done", "submitted": true}, {"created": "2026-10-24T00:31:56.402204+00:00", "modified": "2026-10-24T00:31:56.663236+00:00", "id": 23606274, "conceptrecid": "23606273", "doi": "10.5281/zenodo.23606274", "conceptdoi": "10.5281/zenodo.23606273", "doi_url": "https://doi.org/10.5281/zenodo.23606274", "metadata": {"title": "Replication package for \"CorpusRetrieve: Lessons from Carrying Provenance through a Portable RAG Pipeline in Practice\"", "doi": "10.5281/zenodo.23606274", "publication_date": "2026-10-23", "description": "<p>Replication package for the ICSE 2027 Software Engineering in Practice (SEIP) paper &ldquo;CorpusRetrieve: Lessons from Carrying Provenance through a Portable RAG Pipeline in Practice&rdquo;.</p>\n<p>CorpusRetrieve turns a document corpus into a portable bundle of four plain-file retrieval artifacts: typed retrieval units with element-level provenance, dense and sparse vectors, a structural knowledge graph, and a hash-verified manifest. The paper reports where this provenance survived and where it failed in BioAI, a bilingual Finnish&ndash;English decision-support assistant built on 2,026 publications of the Natural Resources Institute Finland (Luke).</p>\n<p>The package contains:</p>\n<ul>\n<li>the deployed bundle without source texts, page images, and figure crops;</li>\n<li>the collection manifest with the Jukuri handle of every publication;</li>\n<li>outputs of the provenance checks (RQ1);</li>\n<li>the 51 test questions with gold pages and all retrieval results (RQ2);</li>\n<li>the backend and graph results (RQ3);</li>\n<li>153 BioAI answer runs and 40 scope-gate runs, without source text, and the coding of out-of-scope answers (RQ4a);</li>\n<li>anonymised questionnaire responses of 12 consenting workshop participants and observation notes (RQ4b);</li>\n<li>all evaluation scripts.</li>\n</ul>\n<p>Source texts and images of the Luke publications are not redistributed, because their licences differ per item. All reported statistics can be recomputed from the run files. README.md describes what can be rerun, and RECOVERY.md describes the recovery of the knowledge-graph exports and the state of the integrity catalog.</p>", "access_right": "open", "creators": [{"name": "Khan, Ayman Asad", "affiliation": "Tampere University", "orcid": "0009-0004-0134-8313"}, {"name": "Saari, Mika", "affiliation": "Tampere University", "orcid": "0000-0001-7677-2355"}, {"name": "Zhang, Zheying", "affiliation": "Tampere University", "orcid": "0000-0002-6205-4210"}, {"name": "Abrahamsson, Pekka", "affiliation": "Tampere University", "orcid": "0000-0002-4360-2226"}], "keywords": ["retrieval-augmented generation", "RAG", "provenance", "traceability", "document processing; information retrieval", "software engineering in practice", "case study", "Finnish", "decision support"], "related_identifiers": [{"identifier": "https://bioai.gpt-lab.eu/", "relation": "isSupplementedBy", "resource_type": "software", "scheme": "url"}, {"identifier": "https://corpusretrieve.gpt-lab.eu/", "relation": "isSupplementTo", "resource_type": "software", "scheme": "url"}], "dates": [{"type": "collected", "description": "from the bundle build to the workshop", "start": "2026-08-11", "end": "2026-10-22"}], "version": "1.0", "references": ["https://jukuri.luke.fi/"], "language": "eng", "custom": {"code:codeRepository": "https://github.com/GPT-Laboratory/CorpusRetrieve", "code:programmingLanguage": [{"id": "python", "title": {"en": "Python"}}], "code:developmentStatus": {"id": "active", "title": {"en": "Active"}}}, "resource_type": {"title": "Dataset", "type": "dataset"}, "alternate_identifiers": [{"identifier": "https://github.com/GPT-Laboratory/CorpusRetrieve/tree/db0ad14"}], "license": {"id": "cc-by-4.0"}, "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "23606273"}}]}}, "title": "Replication package for \"CorpusRetrieve: Lessons from Carrying Provenance through a Portable RAG Pipeline in Practice\"", "links": {"self": "https://zenodo.org/api/records/23606274", "self_html": "https://zenodo.org/records/23606274", "preview_html": "https://zenodo.org/records/23606274?preview=1", "doi": "https://doi.org/10.5281/zenodo.23606274", "self_doi": "https://doi.org/10.5281/zenodo.23606274", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23606274", "reserve_doi": "https://zenodo.org/api/records/23606274/draft/pids/doi", "parent": "https://zenodo.org/api/records/23606273", "parent_html": "https://zenodo.org/records/23606273", "parent_doi": "https://doi.org/10.5281/zenodo.23606273", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23606273", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:23606274/manifest", "self_iiif_sequence": "https://