url"}], "version": "v1.0.0", "custom": {"code:codeRepository": "https://github.com/aegreene/datadriven_electrolytes_AFSMBs"}, "resource_type": {"title": "Software", "type": "software"}, "license": {"id": "mit-license"}, "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "23624173"}}]}}, "title": "aegreene/datadriven_electrolytes_AFSMBs: Zenodo Release", "links": {"self": "https://zenodo.org/api/records/23624174", "self_html": "https://zenodo.org/records/23624174", "preview_html": "https://zenodo.org/records/23624174?preview=1", "doi": "https://doi.org/10.5281/zenodo.23624174", "self_doi": "https://doi.org/10.5281/zenodo.23624174", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23624174", "reserve_doi": "https://zenodo.org/api/records/23624174/draft/pids/doi", "parent": "https://zenodo.org/api/records/23624173", "parent_html": "https://zenodo.org/records/23624173", "parent_doi": "https://doi.org/10.5281/zenodo.23624173", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23624173", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:23624174/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:23624174/sequence/default", "files": "https://zenodo.org/api/records/23624174/files", "media_files": "https://zenodo.org/api/records/23624174/media-files", "latest": "https://zenodo.org/api/records/23624174/versions/latest", "latest_html": "https://zenodo.org/records/23624174/latest", "versions": "https://zenodo.org/api/records/23624174/versions", "draft": "https://zenodo.org/api/records/23624174/draft", "access_links": "https://zenodo.org/api/records/23624174/access/links", "access_grants": "https://zenodo.org/api/records/23624174/access/grants", "access_users": "https://zenodo.org/api/records/23624174/access/users", "access_request": "https://zenodo.org/api/records/23624174/access/request", "access": "https://zenodo.org/api/records/23624174/access", "communities": "https://zenodo.org/api/records/23624174/communities", "communities-suggestions": "https://zenodo.org/api/records/23624174/communities-suggestions", "request_deletion": "https://zenodo.org/api/records/23624174/request-deletion", "file_modification": "https://zenodo.org/api/records/23624174/file-modification", "quota_increase": "https://zenodo.org/api/records/23624174/quota-increase", "requests": "https://zenodo.org/api/records/23624174/requests"}, "updated": "2026-10-24T18:37:22.321073+00:00", "recid": "23624174", "revision": 4, "files": [{"id": "e9ef49ac-2d9a-461c-9a6d-094d0b08a572", "key": "aegreene/datadriven_electrolytes_AFSMBs-v1.0.0.zip", "size": 568942058, "checksum": "md5:93489f3e685c3de394f8e8842ef44773", "links": {"self": "https://zenodo.org/api/records/23624174/files/aegreene/datadriven_electrolytes_AFSMBs-v1.0.0.zip/content"}}], "swh": null, "owners": [{"id": "1960649"}], "status": "published", "stats": {"downloads": 0, "unique_downloads": 0, "views": 0, "unique_views": 0, "version_downloads": 0, "version_unique_downloads": 0, "version_unique_views": 0, "version_views": 0}, "state": "done", "submitted": true}, {"created": "2026-10-24T18:36:51.590223+00:00", "modified": "2026-10-24T18:36:51.788586+00:00", "id": 23624179, "conceptrecid": "17501957", "doi": "10.5281/zenodo.23624179", "conceptdoi": "10.5281/zenodo.17501957", "doi_url": "https://doi.org/10.5281/zenodo.23624179", "metadata": {"title": "heart-gen/localQTL: v0.2.0", "doi": "10.5281/zenodo.23624179", "publication_date": "2026-10-24", "description": "<p><code>pip install localqtl==0.2.0</code></p>\n<p>Ancestry-resolved cis-xQTL mapping with external allele-frequency QC, and\nfeature parity with tensorQTL (trans mapping, eigenMT, multi-term interactions,\npost-processing and a command line). Two regression fixes change numeric\noutput; see <em>Upgrading from 0.1</em> in the README.</p>\n<h3>Added</h3>\n<ul>\n<li><strong>Posterior-aware ancestry-specific dosage model.</strong> <code>map_nominal(ancestry_model=&quot;dosage&quot;)</code>\nfits one effect per ancestry from the expected ancestry-specific alternate-allele dosage\n(<code>D_k = G * L_k / 2</code>), reports <code>slope_anc{k}</code>, the joint test <code>fstat_joint</code> / <code>pval_joint</code>,\npairwise <code>z_diff_anc{i}_anc{j}</code> / <code>pval_diff_anc{i}_anc{j}</code> from the full covariance of the\nancestry betas, and the per-ancestry in-sample allele statistics <code>an_anc{k}</code>, <code>ac_anc{k}</code>,\n<code>af_anc{k}</code>, <code>ma_count_anc{k}</code>. <code>min_ancestry_ac</code> masks ancestries with too few minor alleles.\n<code>LocalAncestryPanel(use_posterior=True)</code> serves posterior-expected counts from RFMix <code>.fb</code> output.</li>\n<li><strong>Allele metadata.</strong> <code>PgenReader.variant_df</code>, <code>PlinkReader.variant_df</code> and <code>load_genotypes</code>\ncarry <code>chrom, pos, ref, alt</code> with <code>alt</code> the counted (dosage) allele;\n<code>genotypeio.alleles_from_variant_ids</code> parses <code>chr1_123_A_G_b38</code>-style IDs.</li>\n<li><strong><code>localqtl.freq</code>: external allele frequencies and ancestry-aware QC.</strong> <code>FrequencyTable</code>\n(GRCh38, keyed by <code>chrom, pos, ref, alt</code>, allele-aware lookup that re-orients swapped alleles\nand flags strand-ambiguous sites), importers for gnomAD v4 sites VCFs (including the\nlocal-ancestry-tract fields, detected from the header), the gnomAD local-ancestry release,\nNCBI ALFA, and <code>bcftools query</code> output (no pysam needed); <code>ancestry_allele_frequencies</code>\n(in-sample per-ancestry AF), <code>compare_allele_frequencies</code> / <code>summarize_af_concordance</code>,\n<code>annotate_with_frequency</code>, frequency- and ancestry-stratified calibration\n(<code>calibration_by_frequency</code>, <code>calibration_by_frequency_dosage</code>, genomic-control lambda,\nQQ tables) and <code>run_frequency_benchmark</code> with a permutation null. Ancestry labels map to\nreference groups only through an explicit <code>ancestry_map</code>. Optional extra <code>annotate</code> (pysam)\nfor tabix access.</li>\n<li><strong><code>map_nominal_loci</code></strong> (exported; pads the window exactly once; several loci per phenotype)\nand <code>CisMapper.map_nominal_loci</code>.</li>\n<li><strong>tensorQTL parity.</strong><ul>\n<li><code>localqtl.trans</code>: <code>GenotypeGeneratorTrans</code>, <code>map_trans</code> (sparse or dense output, single\n<code>interaction_s</code>, optional <code>LocalAncestryPanel</code> main-effect covariates), <code>filter_cis</code>,\n<code>map_trans_permutations</code> (genome-wide or leave-one-chromosome-out null) and\n<code>apply_permutations</code>.</li>\n<li><code>localqtl.eigenmt</code>: <code>lw_shrink</code>, <code>compute_tests</code>, <code>run_eigenmt</code>, <code>padjust_bh</code>.</li>\n<li><code>map_nominal</code>: <code>interaction_df</code> (one or several terms, tensorQTL column naming),\n<code>maf_threshold_interaction</code>, <code>paired_covariate_df</code>, <code>write_top</code> / <code>write_stats</code>\n(<code>--best_only</code>), <code>run_eigenmt</code> and <code>top_assoc_path</code>; the top association per phenotype\n(or group) is written to <code>&lt;out_prefix&gt;.top_assoc.txt.gz</code> or returned in\n<code>results.attrs[&quot;top_assoc&quot;]</code>. <code>map_permutations</code> accepts <code>paired_covariate_df</code>.</li>\n<li><code>localqtl.post</code>: <code>calculate_afc</code> (mixQTL total-read-count model), <code>calculate_replication</code>\n(with <code>compute_pi1</code>, interaction and paired covariates), <code>annotate_genes</code>, <code>linreg</code>, <code>trc</code>;\nre-exports <code>calculate_qvalues</code> and <code>get_significant_pairs</code>.</li>\n<li><code>localqtl.compat</code>: <code>to_tensorqtl_columns</code> / <code>from_tensorqtl_columns</code>\n(<code>true_dof</code> &lt;-&gt; <code>true_df</code>, <code>se_gi</code> &lt;-&gt; <code>b_gi_se</code>, ...).</li>\n<li><code>genotypeio.get_sample_ids</code>, <code>parse_genotypes</code>, <code>get_vcf_region</code>, <code>get_vcf_variants</code>\n(pysam when installed, otherwise the <code>tabix</code> binary); <code>pgen.get_chunk_size</code> and\n<code>pgen.generate_paired_chunks</code>.</li>\n<li><code>stats.fit_beta_parameters</code>; <code>preproc.filter_maf_interaction</code> and <code>interaction_half_mask</code>.</li>\n<li><strong>Command line</strong> <code>python -m localqtl</code> / <code>localqtl</code> with tensorQTL's modes (<code>cis</code>,\n<code>cis_nominal</code>, <code>cis_independent</code>, <code>cis_susie</code>, <code>trans</code>, <code>trans_susie</code>), arguments and output\nfile names, plus <code>--haplotypes</code>, <code>--la_format</code>, <code>--la_source</code>, <code>--la_cache_dir</code>,\n<code>--use_posterior</code>, <code>--ancestry_model</code>, <code>--min_ancestry_ac</code>, <code>--device</code>, <code>--perm_chunk</code> and\n<code>--localqtl_names</code>. Output columns use tensorQTL's spelling unless <code>--localqtl_names</code> is given.</li>\n</ul>\n</li>\n<li>API stubs for the planned <code>localqtl.annotate.alphagenome</code> and <code>localqtl.annotate.igvf</code>\nmodules (they raise <code>NotImplementedError</code>).</li>\n<li>Continuous integration: tests on Python 3.11\u20133.13 and a docs build on every push and pull\nrequest; tagged releases build, publish to PyPI (trusted publishing) and create a GitHub\nrelease whose body is this file's section.</li>\n</ul>\n<h3>Changed</h3>\n<ul>\n<li><strong>Degrees of freedom.</strong> <code>Residualizer.k_eff</code> now counts the centring (intercept) degree of\nfreedom in addition to the covariate rank, and every kernel uses <code>dof = n - k_eff - p</code>. Standard\nerrors from the batched kernels were previously too small by a factor of\n<code>sqrt((n - k - 1) / (n - k - 2))</code> and inconsistent with the correlation-based p-values.</li>\n<li><strong>No-covariate runs fit an intercept.</strong> With <code>covariates_df=None</code> the residualizer has rank 0\nand centres every matrix, instead of fitting through the origin.</li>\n<li><strong>Interaction models match full OLS.</strong> The <code>g:i</code> column is built from the raw genotypes and the\ninteraction main effect is residualized against the covariates (Frisch\u2013Waugh), in the nominal,\npermutation and independent cores; previously the product used the residualized genotype,\nwhich biased all interaction coefficients whenever covariates were present. <code>map_nominal</code>\nwith a local-ancestry panel now keeps the ancestry main effects in the GxC model, as the\npermutation and independent scans already did.</li>\n<li><code>ancestry_model</code> is validated everywhere (<code>'main'</code>, <code>'interaction'</code>, <code>'dosage'</code>); misspelled\nvalues no longer run the main model silently.</li>\n<li><code>map_nominal_loci</code> padded <code>position</code> by the window twice; it now pads once.</li>\n<li><code>impute_mean_and_filter</code> drops rows that become monomorphic only after mean imputation.</li>\n<li><code>read_phenotype_bed</code> keeps the case of sample IDs (they were lowercased).</li>\n<li>The dosage-model Parquet schema gained the per-ancestry allele-count columns (appended after\nthe pairwise-difference block). The <code>af</code> column is documented as the in-sample frequency of\nthe counted (<code>alt</code>) allele.</li>\n<li>Build backend: <code>poetry-dynamic-versioning</code> (the version is read from the git tag, also for\n<code>pip install</code> from a checkout).</li>\n</ul>\n<h3>Fixed</h3>\n<ul>\n<li><code>map_independent</code>: the grouped core referenced an undefined name; the forward pass could loop\nforever when a conditioned variant was re-selected; the Beta fit could hang on degenerate\npermutation sets (it now returns NaN and callers fall back to <code>pval_perm</code>); a NaN <code>true_dof</code>\nwith <code>beta_approx=False</code> crashed the integer result buffer.</li>\n<li><code>PgenReader(select_samples=...)</code> passed a Python list to pgenlib, which rejected it.</li>\n<li>Tests that asserted group columns on an ungrouped run, and a permutation test that hung on\nthe forward-pass loop above, were corrected.</li>\n</ul>\n<h2>What's Changed</h2>\n<ul>\n<li>Rfmix reader 0.6 by @KrotosBenjamin in https://github.com/heart-gen/localQTL/pull/75</li>\n<li>Bump soupsieve from 2.8 to 2.9 by @dependabot[bot] in https://github.com/heart-gen/localQTL/pull/69</li>\n<li>Bump soupsieve from 2.8 to 2.9 in /docs by @dependabot[bot] in https://github.com/heart-gen/localQTL/pull/70</li>\n<li>Bump urllib3 from 2.6.3 to 2.8.0 in /docs by @dependabot[bot] in https://github.com/heart-gen/localQTL/pull/71</li>\n<li>Bump tornado from 6.5.5 to 6.5.9 by @dependabot[bot] in https://github.com/heart-gen/localQTL/pull/72</li>\n<li>Bump tornado from 6.5.5 to 6.5.9 in /docs by @dependabot[bot] in https://github.com/heart-gen/localQTL/pull/73</li>\n<li>Bump fsspec from 2025.9.0 to 2026.6.0 by @dependabot[bot] in https://github.com/heart-gen/localQTL/pull/76</li>\n<li>Bump cairosvg from 2.9.0 to 2.9.1 by @dependabot[bot] in https://github.com/heart-gen/localQTL/pull/77</li>\n<li>Bump pyarrow from 22.0.0 to 23.0.1 by @dependabot[bot] in https://github.com/heart-gen/localQTL/pull/78</li>\n<li>Bump pillow from 12.3.0 to 13.0.0 in /docs by @dependabot[bot] in https://github.com/heart-gen/localQTL/pull/79</li>\n<li>Bump certifi from 2025.10.5 to 2026.10.19 by @dependabot[bot] in https://github.com/heart-gen/localQTL/pull/80</li>\n<li>Bump setuptools from 84.0.0 to 84.1.0 by @dependabot[bot] in https://github.com/heart-gen/localQTL/pull/81</li>\n<li>Bump pyarrow from 22.0.0 to 23.0.1 by @dependabot[bot] in https://github.com/heart-gen/localQTL/pull/82</li>\n<li>Feature/ancestry frequency qc by @KrotosBenjamin in https://github.com/heart-gen/localQTL/pull/83</li>\n<li>Add tensorQTL feature parity: trans, eigenMT, post, interaction_df, CLI by @KrotosBenjamin in https://github.com/heart-gen/localQTL/pull/84</li>\n<li>Prepare the 0.2.0 release: changelog, upgrade notes, CI and release w\u2026 by @KrotosBenjamin in https://github.com/heart-gen/localQTL/pull/85</li>\n</ul>\n<p><strong>Full Changelog</strong>: https://github.com/heart-gen/localQTL/compare/v0.1.4...v0.2.0</p>", "access_right": "open", "creators": [{"name": "Kynon J.M. Benjamin", "affiliation": "@northwestern-university"}], "related_identifiers": [{"identifier": "https://github.com/heart-gen/localQTL/tree/v0.2.0", "relation": "isSupplementTo", "resource_type": "software", "scheme": "url"}], "version": "v0.2.0", "custom": {"code:codeRepository": "https://github.com/heart-gen/localQTL"}, "resource_type": {"title": "Software", "type": "software"}, "license": {"id": "cc-by-4.0"}, "relations": {"version": [{"index": 5, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "17501957"}}]}}, "title": "heart-gen/localQTL: v0.2.0", "links": {"self": "https://zenodo.org/api/records/23624179", "self_html": "https://zenodo.org/records/23624179", "preview_html": "https://zenodo.org/records/23624179?preview=1", "doi": "https://doi.org/10.5281/zenodo.23624179", "self_doi": "https://doi.org/10.5281/zenodo.23624179", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23624179", "reserve_doi": "https://zenodo.org/api/records/23624179/draft/pids/doi", "parent": "https://zenodo.org/api/records/17501957", "parent_html": "https://zenodo.org/records/17501957", "parent_doi": "https://doi.org/10.5281/zenodo.17501957", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.17501957", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:23624179/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:23624179/sequence/default", "files": "https://zenodo.org/api/records/23624179/files", "media_files": "https://zenodo.org/api/records/23624179/media-files", "latest": "https://zenodo.org/api/recor