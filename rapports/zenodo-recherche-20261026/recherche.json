nodo.org/api/records/23619187/communities-suggestions", "request_deletion": "https://zenodo.org/api/records/23619187/request-deletion", "file_modification": "https://zenodo.org/api/records/23619187/file-modification", "quota_increase": "https://zenodo.org/api/records/23619187/quota-increase", "requests": "https://zenodo.org/api/records/23619187/requests"}, "updated": "2026-10-24T14:01:04.012936+00:00", "recid": "23619187", "revision": 4, "files": [{"id": "cb0d283a-0c8d-4604-a8a9-129910de2d39", "key": "Homeworking_Access_Replication.zip", "size": 186369, "checksum": "md5:18d0351c6ff25a1cb8c7380b13747ba3", "links": {"self": "https://zenodo.org/api/records/23619187/files/Homeworking_Access_Replication.zip/content"}}], "swh": null, "owners": [{"id": "1671942"}], "status": "published", "stats": {"downloads": 0, "unique_downloads": 0, "views": 3, "unique_views": 3, "version_downloads": 0, "version_unique_downloads": 0, "version_unique_views": 3, "version_views": 3}, "state": "done", "submitted": true}, {"created": "2026-10-24T11:11:27.315553+00:00", "modified": "2026-10-24T11:11:27.548987+00:00", "id": 23614843, "conceptrecid": "23614842", "doi": "10.5281/zenodo.23614843", "conceptdoi": "10.5281/zenodo.23614842", "doi_url": "https://doi.org/10.5281/zenodo.23614843", "metadata": {"title": "Replication Package for \"InfraLink: Can LLM Agents Infer Missing Infrastructure as Code Dependencies?\"", "doi": "10.5281/zenodo.23614843", "publication_date": "2026-10-24", "description": "<p>To be able to use the replication package follow the steps:</p>\n<ul>\n<li>Install Docker by following the instructions for your operating system described&nbsp;<a href=\"https://docs.docker.com/engine/install/\">here</a>.</li>\n<li>Run <code>docker load &lt; infralink.tar</code> in the folder with the tar file previously downloaded.</li>\n<li>Run <code>docker run -it --name infralink infralink:v1 /bin/bash</code> if you only want to run the steps that do not require LLM inference. If you want to run the steps that involve using LLM inference, you will need to have an <a href=\"https://openrouter.ai/\">OpenRouter</a> key with credits (we estimate a cost of around $100 to run everything) and you can run instead <code>docker run -e OPENROUTER_API_KEY:&lt;your-api-key&gt; -it --name infralink infralink:v1 /bin/bash</code>.</li>\n<li>To be able to return to the container, run <code>docker attach infralink</code>.</li>\n</ul>\n<p>The docker container is ready to use!</p>\n<p>It is important to mention that these instructions were tested with a MacOS Tahoe 26.2 system. For other operating systems, some adjustments may need to be made.</p>\n<p>After these steps, check the README on the root folder.</p>\n<h2>Running on x86 machines</h2>\n<p>To run this image in an x86 machine, you might need to use emulation.</p>\n<ul>\n<li>On the first time, run&nbsp;<code>docker run --privileged --rm tonistiigi/binfmt --install all</code>.</li>\n<li>Then, simply add the flag <code>--platform=linux/arm64</code> on the <code>docker run</code> command shown in the replication steps.</li>\n</ul>\n<p>The Docker container includes depends-off's code, the code to replicate the evaluation, and the obtained results.</p>", "access_right": "open", "creators": [{"name": "Anonymous", "affiliation": null}], "resource_type": {"title": "Software", "type": "software"}, "license": {"id": "cc-by-4.0"}, "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "23614842"}}]}}, "title": "Replication Package for \"InfraLink: Can LLM Agents Infer Missing Infrastructure as Code Dependencies?\"", "links": {"self": "https://zenodo.org/api/records/23614843", "self_html": "https://zenodo.org/records/23614843", "preview_html": "https://zenodo.org/records/23614843?preview=1", "doi": "https://doi.org/10.5281/zenodo.23614843", "self_doi": "https://doi.org/10.5281/zenodo.23614843", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23614843", "reserve_doi": "https://zenodo.org/api/records/23614843/draft/pids/doi", "parent": "https://zenodo.org/api/records/23614842", "parent_html": "https://zenodo.org/records/23614842", "parent_doi": "https://doi.org/10.5281/zenodo.23614842", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23614842", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:23614843/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:23614843/sequence/default", "files": "https://zenodo.org/api/records/23614843/files", "media_files": "https://zenodo.org/api/records/23614843/media-files", "latest": "https://zenodo.org/api/records/23614843/versions/latest", "latest_html": "https://zenodo.org/records/23614843/latest", "versions": "https://zenodo.org/api/records/23614843/versions", "draft": "https://zenodo.org/api/records/23614843/draft", "access_links": "https://zenodo.org/api/records/23614843/access/links", "access_grants": "https://zenodo.org/api/records/23614843/access/grants", "access_users": "https://zenodo.org/api/records/23614843/access/users", "access_request": "https://zenodo.org/api/records/23614843/access/request", "access": "https://zenodo.org/api/records/23614843/access", "communities": "https://zenodo.org/api/records/23614843/communities", "communities-suggestions": "https://zenodo.org/api/records/23614843/communities-suggestions", "request_deletion": "https://zenodo.org/api/records/23614843/request-deletion", "file_modification": "https://zenodo.org/api/records/23614843/file-modification", "quota_increase": "https://zenodo.org/api/records/23614843/quota-increase", "requests": "https://zenodo.org/api/records/23614843/requests"}, "updated": "2026-10-24T11:11:27.548987+00:00", "recid": "23614843", "revision": 4, "files": [{"id": "c68ad019-daa6-467b-9083-584f9f22247d", "key": "infralink.tar", "size": 988676608, "checksum": "md5:75ca1ab521d770314d955817bb49dd01", "links": {"self": "https://zenodo.org/api/records/23614843/files/infralink.tar/content"}}], "swh": null, "owners": [{"id": "1836331"}], "status": "published", "stats": {"downloads": 0, "unique_downloads": 0, "views": 8, "unique_views": 3, "version_downloads": 0, "version_unique_downloads": 0, "version_unique_views": 3, "version_views": 8}, "state": "done", "submitted": true}, {"created": "2026-10-24T10:40:34.015794+00:00", "modified": "2026-10-24T10:40:34.166057+00:00", "id": 23614142, "conceptrecid": "23614141", "doi": "10.5281/zenodo.23614142", "conceptdoi": "10.5281/zenodo.23614141", "doi_url": "https://doi.org/10.5281/zenodo.23614142", "metadata": {"title": "Replication Package for: Does Graph Structure Still Help? Replicating and Extending IR-Augmented LLM Vulnerability Detection", "doi": "10.5281/zenodo.23614142", "publication_date": "2026-10-24", "description": "<p>This is the replication package for the paper:<br>\"Does Graph Structure Still Help? Replicating and Extending IR-Augmented LLM Vulnerability Detection\"</p>\n<p><strong>Overview:</strong><br>This package contains all code, prompts, intermediate representations (IR), evaluation scripts, and experimental results for:</p>\n<ol>\n<li>Replicating the GRACE vulnerability detection framework on the Devign and ReVeal datasets using three LLMs (GPT-5.6-Luna, DeepSeek-Flash, and Claude Sonnet 5).</li>\n<li>Extending IR-augmented vulnerability detection across 7 programming languages using the REEF benchmark.</li>\n<li>Evaluating the impact of IR generation environments and representations (no IR, legacy IR, modern IR, aligned IR, and incremental transformation stages G1-G4).</li>\n</ol>\n<p><strong>Contents:</strong></p>\n<ul>\n<li>data/: Raw benchmark data, external reproduction subsets, and generated inputs (including all IR conditions: no_ir, old_ir, modern_ir, aligned_ir, and RQ4 ablation variants).</li>\n<li>scripts/: Python and bash scripts for data preparation, IR extraction and transformation via Joern, LLM inference, and evaluation metric calculation.</li>\n<li>results/: Complete experimental outputs (predictions, metrics, raw responses) matching the findings reported in the paper.</li>\n</ul>\n<p>Note on terminology:<br>The condition referred to as \"legacy IR\" in the paper is labeled as \"old_ir\" (or \"old IR\") in the directory names, data files, and experimental scripts within this package.</p>\n<p>For prerequisites, environment setup, and instructions to reproduce the results, please see README.md inside the package.<br>See the LICENSE file in the package for the specific scope of each component.</p>", "access_right": "open", "creators": [{"name": "Anonymous, Author(s)", "affiliation": null}], "resource_type": {"title": "Software", "type": "software"}, "license": {"id": "mit-license"}, "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "23614141"}}]}}, "title": "Replication Package for: Does Graph Structure Still Help? Replicating and Extending IR-Augmented LLM Vulnerability Detection", "links": {"self": "https://zenodo.org/api/records/23614142", "self_html": "https://zenodo.org/records/23614142", "preview_html": "https://zenodo.org/records/23614142?preview=1", "doi": "https://doi.org/10.5281/zenodo.23614142", "self_doi": "https://doi.org/10.5281/zenodo.23614142", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23614142", "reserve_doi": "https://zenodo.org/api/records/23614142/draft/pids/doi", "parent": "https://zenodo.org/api/records/23614141", "parent_html": "https://zenodo.org/records/23614141", "parent_doi": "https://doi.org/10.5281/zenodo.23614141", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23614141", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:23614142/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:23614142/sequence/default", "files": "https://zenodo.org/api/records/23614142/files", "media_files": "https://zenodo.org/api/records/23614142/media-files", "latest": "https://zenodo.org/api/records/23614142/versions/latest", "latest_html": "https://zenodo.org/records/23614142/latest", "versions": "https://zenodo.org/api/records/23614142/versions", "draft": "https://zenodo.org/api/records/23614142/draft", "access_links": "https://zenodo.org/api/records/23614142/access/links", "access_grants": "https://zenodo.org/api/records/23614142/access/grants", "access_users": "https://zenodo.org/api/records/23614142/access/users", "access_request": "https://zenodo.org/api/records/23614142/access/request", "access": "https://zenodo.org/api/records/23614142/access", "communities": "https://zenodo.org/api/records/23614142/communities", "communities-suggestions": "https://zenodo.org/api/records/23614142/communities-suggestions", "request_deletion": "https://zenodo.org/api/records/23614142/request-deletion", "file_modification": "https://zenodo.org/api/records/23614142/file-modification", "quota_increase": "https://zenodo.org/api/records/23614142/quota-increase", "requests": "https://zenodo.org/api/records/23614142/requests"}, "updated": "2026-10-24T10:40:34.166057+00:00", "recid": "23614142", "revision": 4, "files": [{"id": "6c22f7b1-015c-4d2a-bb8f-f754aef0748d", "key": "replication_package.zip", "size": 111338442, "checksum": "md5:99151a6f5286661552f46682285b3b12", "links": {"self": "https://zenodo.org/api/records/23614142/files/replication_package.zip/content"}}], "swh": null, "owners": [{"id": "1962579"}], "status": "published", "stats": {"downloads": 1, "unique_downloads": 1, "views": 3, "unique_views": 3, "version_downloads": 1, "version_unique_downloads": 1, "version_unique_views": 3, "version_views": 3}, "state": "done", "submitted": true}, {"created": "2026-10-24T10:16:18.209159+00:00", "modified": "2026-10-24T10:16:18.654338+00:00", "id": 23615180, "conceptrecid": "23615179", "doi": "10.5281/zenodo.23615180", "conceptdoi": "10.5281/zenodo.23615179", "doi_url": "https://doi.org/10.5281/zenodo.23615180", "metadata": {"title": "STRATUM: Repository Memory for Coding Agents \u2014 Replication Package", "doi": "10.5281/zenodo.23615180", "publication_date": "2026-10-24", "description": "<p>Anonymous replication package for a double-blind submission arguing that coding agents need persistent, experience-aware repository memory rather than a larger context window.</p><p>Contains every script and raw measurement behind the paper's motivating study and preliminary experiments:</p><ul><li><b>F1</b> \u2014 token census of six open-source repositories and the representation-cost gap between storing knowledge as indexed text vs. as model key-value (KV) cache state (e.g. ~4 GB as text vs. ~298 TB as fp16 KV state per billion tokens, 70B model).</li><li><b>F2</b> \u2014 the working-set size of 752 real bug-fix commits: the median fix touches two files, and the one-hop import closure is 2.7-9.9% of the repository.</li><li><b>F3</b> \u2014 how much of real file co-change is visible to static analysis (852 commits, 4 repositories): 47.3% of co-edited file pairs remain disconnected even under transitive import reachability and test-name links.</li><li><b>E4</b> \u2014 retrieval latency over a synthetic 10^6-node SQLite+HNSW store: 1.70 ms median / 2.76 ms p99 end-to-end.</li><li><b>E5</b> \u2014 a real multi-session agent experiment on 8 real bugs using the Claude API: a reader model that inherits a different (writer) model's memory diagnoses the bug correctly in 21/24 trials vs. 6/24 for a retrieval-only baseline (one-sided Fisher exact p = 1.27e-05), at 4.5x lower median token cost; accumulated memory (26 pooled notes) stays at 8/8; a whole-repository-in-context baseline matches memory's success rate at 3.8x the per-call token cost and no persistence.</li></ul><p>The package also includes the paper's architecture figure (hand-authored SVG, no third-party icon assets) and a full requirements/setup README.</p><p><b>Anonymity note:</b> creator metadata is intentionally set to Anonymous for double-blind review. Author identity will be added after the review process concludes.</p>", "access_right": "open", "creators": [{"name": "Anonymous", "affiliation": null}], "keywords": ["coding agents", "LLM memory", "repository mining", "software engineering", "replication package", "context management", "retrieval-augmented generation"], "resource_type": {"title": "Software", "type": "software"}, "license": {"id": "cc-by-4.0"}, "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "23615179"}}]}, "notes": "Prepared for anonymous double-blind peer review. Does not include the LaTeX paper source or third-party repository source code (regenerable from the included scripts)."}, "title": "STRATUM: Repository Memory for Coding Agents \u2014 Replication Package", "links": {"self": "https://zenodo.org/api/records/23615180", "self_html": "https://zenodo.org/records/23615180", "preview_html": "https://zenodo.org/records/23615180?preview=1", "doi": "https://doi.org/10.5281/zenodo.23615180", "self_doi": "https://doi.org/10.5281/zenodo.23615180", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23615180", "reserve_doi": "https://zenodo.org/api/records/23615180/draft/pids/doi", "parent": "https://zenodo.org/api/records/23615179", "parent_html": "https://zenodo.org/records/23615179", "parent_doi": "https://doi.org/10.5281/zenodo.23615179", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23615179", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:23615180/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:23615180/sequence/default", "files": "https://zenodo.org/api/records/23615180/files", "media_files": "https://zenodo.org/api/records/23615180/media-files", "thumbnails": {"10": "https://zenodo.org/api/iiif/record:23615180:stratum-overview.png/full/%5E10,/0/default.jpg", "50": "https://zenodo.org/api/iiif/record:23615180:stratum-overview.png/full/%5E50,/0/default.jpg", "100": "https://zenodo.org/api/iiif/record:23615180:stratum-overview.png/full/%5E100,/0/default.jpg", "250": "https://zenodo.org/api/iiif/rec