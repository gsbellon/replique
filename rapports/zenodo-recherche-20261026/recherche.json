, "requests": "https://zenodo.org/api/records/23604942/requests"}, "updated": "2026-10-25T23:13:12.763217+00:00", "recid": "23604942", "revision": 4, "files": [{"id": "ff330b6a-78f6-46f5-aaac-cc0c3797e644", "key": "hindsight-replication.zip", "size": 508322451, "checksum": "md5:3b7e65245d9268a09699653bd59830a2", "links": {"self": "https://zenodo.org/api/records/23604942/files/hindsight-replication.zip/content"}}], "swh": null, "owners": [{"id": "1961995"}], "status": "published", "stats": {"downloads": 0, "unique_downloads": 0, "views": 2, "unique_views": 2, "version_downloads": 0, "version_unique_downloads": 0, "version_unique_views": 2, "version_views": 2}, "state": "done", "submitted": true}, {"created": "2026-10-25T21:50:09.183448+00:00", "modified": "2026-10-25T21:50:09.563858+00:00", "id": 22817811, "conceptrecid": "22817810", "doi": "10.5281/zenodo.22817811", "conceptdoi": "10.5281/zenodo.22817810", "doi_url": "https://doi.org/10.5281/zenodo.22817811", "metadata": {"title": "Replication package for The Roles of Borrower Private Information and Mortgage Relief Design in Foreclosure Prevention", "doi": "10.5281/zenodo.22817811", "publication_date": "2026-10-23", "description": "<p class=\"p2\">Kyt&ouml;maa, Lauri. \"The Roles of Borrower Private Information and Mortgage Relief Design in Foreclosure Prevention.\" <em>The Review of Economic Studies</em>, forthcoming.<br><br>This replication package reproduces the data construction, structural estimation, reduced-form selectiontests, counterfactuals, and all exhibits in the paper.</p>\n<p class=\"p2\">The package ships code, estimation results, and exhibits. The underlying loan-level data are obtained from Fannie Mae under that provider's terms of use and&nbsp;cannot be redistributed (see <em>Data Availability and Provenance Statements</em>); the replicator supplies the raw archives and the pipeline regenerates every intermediate and analysis dataset.</p>", "access_right": "open", "creators": [{"name": "Kyt\u00f6maa, Lauri", "affiliation": "Cornell University", "orcid": "0009-0006-8157-5050"}], "language": "eng", "custom": {"code:programmingLanguage": [{"id": "python", "title": {"en": "Python"}}, {"id": "stata", "title": {"en": "Stata"}}]}, "resource_type": {"title": "Software", "type": "software"}, "thesis": {}, "license": {"id": "mit-license"}, "communities": [{"id": "restud-replication"}], "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "22817810"}}]}}, "title": "Replication package for The Roles of Borrower Private Information and Mortgage Relief Design in Foreclosure Prevention", "links": {"self": "https://zenodo.org/api/records/22817811", "self_html": "https://zenodo.org/records/22817811", "preview_html": "https://zenodo.org/records/22817811?preview=1", "doi": "https://doi.org/10.5281/zenodo.22817811", "self_doi": "https://doi.org/10.5281/zenodo.22817811", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.22817811", "reserve_doi": "https://zenodo.org/api/records/22817811/draft/pids/doi", "parent": "https://zenodo.org/api/records/22817810", "parent_html": "https://zenodo.org/records/22817810", "parent_doi": "https://doi.org/10.5281/zenodo.22817810", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.22817810", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:22817811/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:22817811/sequence/default", "files": "https://zenodo.org/api/records/22817811/files", "media_files": "https://zenodo.org/api/records/22817811/media-files", "thumbnails": {"10": "https://zenodo.org/api/iiif/record:22817811:README_34951_Kytomaa.pdf/full/%5E10,/0/default.jpg", "50": "https://zenodo.org/api/iiif/record:22817811:README_34951_Kytomaa.pdf/full/%5E50,/0/default.jpg", "100": "https://zenodo.org/api/iiif/record:22817811:README_34951_Kytomaa.pdf/full/%5E100,/0/default.jpg", "250": "https://zenodo.org/api/iiif/record:22817811:README_34951_Kytomaa.pdf/full/%5E250,/0/default.jpg", "750": "https://zenodo.org/api/iiif/record:22817811:README_34951_Kytomaa.pdf/full/%5E750,/0/default.jpg", "1200": "https://zenodo.org/api/iiif/record:22817811:README_34951_Kytomaa.pdf/full/%5E1200,/0/default.jpg"}, "latest": "https://zenodo.org/api/records/22817811/versions/latest", "latest_html": "https://zenodo.org/records/22817811/latest", "versions": "https://zenodo.org/api/records/22817811/versions", "draft": "https://zenodo.org/api/records/22817811/draft", "access_links": "https://zenodo.org/api/records/22817811/access/links", "access_grants": "https://zenodo.org/api/records/22817811/access/grants", "access_users": "https://zenodo.org/api/records/22817811/access/users", "access_request": "https://zenodo.org/api/records/22817811/access/request", "access": "https://zenodo.org/api/records/22817811/access", "communities": "https://zenodo.org/api/records/22817811/communities", "communities-suggestions": "https://zenodo.org/api/records/22817811/communities-suggestions", "request_deletion": "https://zenodo.org/api/records/22817811/request-deletion", "file_modification": "https://zenodo.org/api/records/22817811/file-modification", "quota_increase": "https://zenodo.org/api/records/22817811/quota-increase", "requests": "https://zenodo.org/api/records/22817811/requests"}, "updated": "2026-10-25T21:50:09.563858+00:00", "recid": "22817811", "revision": 4, "files": [{"id": "87c85784-32bb-48ea-ad4d-fe9eab28f033", "key": "README_34951_Kytomaa.pdf", "size": 993474, "checksum": "md5:98e99bf918e8783cb20b43bcb35b54b7", "links": {"self": "https://zenodo.org/api/records/22817811/files/README_34951_Kytomaa.pdf/content"}}, {"id": "bf1981c4-fd28-49a5-96cb-074dd650ba13", "key": "34951_Kytomaa_Replication.zip", "size": 3809023337, "checksum": "md5:71c1992c65a3451f21c36de4a9ed89a2", "links": {"self": "https://zenodo.org/api/records/22817811/files/34951_Kytomaa_Replication.zip/content"}}], "swh": null, "owners": [{"id": "1886509"}], "status": "published", "stats": {"downloads": 10, "unique_downloads": 7, "views": 39, "unique_views": 27, "version_downloads": 10, "version_unique_downloads": 7, "version_unique_views": 27, "version_views": 39}, "state": "done", "submitted": true}, {"created": "2026-10-25T20:33:56.818196+00:00", "modified": "2026-10-25T20:33:57.033394+00:00", "id": 23511350, "conceptrecid": "23511349", "doi": "10.5281/zenodo.23511350", "conceptdoi": "10.5281/zenodo.23511349", "doi_url": "https://doi.org/10.5281/zenodo.23511350", "metadata": {"title": "Decision-Free Algebraic Rejection for Post-Quantum Key Encapsulation: Replication Package", "doi": "10.5281/zenodo.23511350", "publication_date": "2026-10-25", "description": "<p>This record provides the replication materials for the study <strong>&ldquo;Decision-Free Algebraic Rejection for Post-Quantum Key Encapsulation&rdquo; (DFAR)</strong>.</p>\n<p>DFAR investigates an alternative to the conventional validity-controlled rejection path in Fujisaki&ndash;Okamoto-style key-encapsulation mechanisms. The construction replaces the ciphertext-consistency decision and conditional candidate-key selection with two keyed evaluations that cancel for self-consistent ciphertexts and produce a pseudorandom deformation otherwise.</p>\n<p>The package contains C implementations covering ML-KEM-512, ML-KEM-768, and ML-KEM-1024; an independent Go implementation for ML-KEM-768; native AArch64 validation material; controlled software-fault experiments; raw performance measurements; experimental protocols; environment records; analysis scripts; and verification procedures. It also includes the supplementary technical material and the proofs supporting the main security results.</p>\n<p>The primary x86-64 evaluation uses matched source-level implementations and paired complete-decapsulation measurements. The package retains the experimental records and scripts needed to examine the reported results, together with secondary implementation and diagnostic evidence.</p>\n<p>The security claims are subject to the assumptions and query models stated in the manuscript. The implementation is a research profile and is not presented as a bit-for-bit FIPS 203 replacement for inconsistent ciphertexts. The software-fault experiments do not establish immunity to arbitrary implementation faults.</p>\n<p><strong>Associated manuscript:</strong> Decision-Free Algebraic Rejection for Post-Quantum Key Encapsulation.</p>\n<p><strong>Replication entry point:</strong> <code>python3 run_verification_suite.py</code></p>\n<p>Additional reproduction instructions and environment requirements are provided in <code>REPLICATION_GUIDE.txt</code>.</p>", "access_right": "open", "creators": [{"name": "Alsawalqah, Hamad", "affiliation": "The University of Jordan"}, {"name": "Abadleh, Ahmad", "affiliation": "Mutah University"}], "keywords": ["Post-quantum cryptography", "ML-KEM", "Key encapsulation mechanisms", "Fujisaki\u2013Okamoto transformation", "Implicit rejection", "Decision-Free Algebraic Rejection", "IND-CCA security", "Cryptographic implementation security", "Software fault testing", "Reproducible research"], "version": "V1.0.0", "language": "eng", "resource_type": {"title": "Software", "type": "software"}, "license": {"id": "cc-by-4.0"}, "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "23511349"}}]}}, "title": "Decision-Free Algebraic Rejection for Post-Quantum Key Encapsulation: Replication Package", "links": {"self": "https://zenodo.org/api/records/23511350", "self_html": "https://zenodo.org/records/23511350", "preview_html": "https://zenodo.org/records/23511350?preview=1", "doi": "https://doi.org/10.5281/zenodo.23511350", "self_doi": "https://doi.org/10.5281/zenodo.23511350", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23511350", "reserve_doi": "https://zenodo.org/api/records/23511350/draft/pids/doi", "parent": "https://zenodo.org/api/records/23511349", "parent_html": "https://zenodo.org/records/23511349", "parent_doi": "https://doi.org/10.5281/zenodo.23511349", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23511349", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:23511350/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:23511350/sequence/default", "files": "https://zenodo.org/api/records/23511350/files", "media_files": "https://zenodo.org/api/records/23511350/media-files", "latest": "https://zenodo.org/api/records/23511350/versions/latest", "latest_html": "https://zenodo.org/records/23511350/latest", "versions": "https://zenodo.org/api/records/23511350/versions", "draft": "https://zenodo.org/api/records/23511350/draft", "access_links": "https://zenodo.org/api/records/23511350/access/links", "access_grants": "https://zenodo.org/api/records/23511350/access/grants", "access_users": "https://zenodo.org/api/records/23511350/access/users", "access_request": "https://zenodo.org/api/records/23511350/access/request", "access": "https://zenodo.org/api/records/23511350/access", "communities": "https://zenodo.org/api/records/23511350/communities", "communities-suggestions": "https://zenodo.org/api/records/23511350/communities-suggestions", "request_deletion": "https://zenodo.org/api/records/23511350/request-deletion", "file_modification": "https://zenodo.org/api/records/23511350/file-modification", "quota_increase": "https://zenodo.org/api/records/23511350/quota-increase", "requests": "https://zenodo.org/api/records/23511350/requests"}, "updated": "2026-10-25T20:33:57.033394+00:00", "recid": "23511350", "revision": 4, "files": [{"id": "a20f784c-1b9d-4f28-8b08-8116b7a3740e", "key": "DFAR_Replication_Package_Final_Zenodo.zip", "size": 407114, "checksum": "md5:bcbdf663c698f3709e974efbad0604c0", "links": {"self": "https://zenodo.org/api/records/23511350/files/DFAR_Replication_Package_Final_Zenodo.zip/content"}}], "swh": null, "owners": [{"id": "1822025"}], "status": "published", "stats": {"downloads": 0, "unique_downloads": 0, "views": 1, "unique_views": 1, "version_downloads": 0, "version_unique_downloads": 0, "version_unique_views": 1, "version_views": 1}, "state": "done", "submitted": true}, {"created": "2026-10-25T17:49:27.303922+00:00", "modified": "2026-10-25T17:49:27.470324+00:00", "id": 23647165, "conceptrecid": "23647164", "doi": "10.5281/zenodo.23647165", "conceptdoi": "10.5281/zenodo.23647164", "doi_url": "https://doi.org/10.5281/zenodo.23647165", "metadata": {"title": "Replication package for \"A parity frontier between all-electric and hydrocarbon regimes: the required EROI under changing final energy demand\"", "doi": "10.5281/zenodo.23647165", "publication_date": "2026-10-25", "description": "<p>Python code that reproduces every number, table and figure of the manuscript &ldquo;A parity frontier between all-electric and hydrocarbon regimes: the required EROI under changing final energy demand&rdquo; (Benyahia and Ait Hsain, submitted to Ecological Economics), together with the numerical verification of its propositions. The code takes as input the dataset of Aramendia et al. (2024), available at https://doi.org/10.6084/m9.figshare.25311358. The paper derives, in closed form, the life-cycle EROI that an all-electric supply system, storage and networks included, requires to match hydrocarbons as a function of the growth rate of final energy demand. With 2020 global data, the baseline requirement at 2% annual growth is 5.5.</p>", "access_right": "open", "creators": [{"name": "Benyahia, Georges Ali", "affiliation": "Universit\u00e9 Mohammed VI Polytechnique"}, {"name": "Ait Hsain, Tareq", "affiliation": "Universit\u00e9 Mohammed VI Polytechnique"}], "keywords": ["EROI", "Net energy analysis", "Energy transition", "Final energy demand", "Growth", "Useful energy", "Renewable electricity"], "related_identifiers": [{"identifier": "10.6084/m9.figshare.25311358", "relation": "requires", "resource_type": "dataset", "scheme": "doi"}, {"identifier": "10.1038/s41560-024-01518-6", "relation": "references", "resource_type": "publication-article", "scheme": "doi"}], "version": "1.0", "resource_type": {"title": "Software", "type": "software"}, "license": {"id": "mit-license"}, "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "23647164"}}]}}, "title": "Replication package for \"A parity frontier between all-electric and hydrocarbon regimes: the required EROI under changing final energy demand\"", "links": {"self": "https://zenodo.org/api/records/23647165", "self_html": "https://zenodo.org/records/23647165", "preview_html": "https://zenodo.org/records/23647165?preview=1", "doi": "https://doi.org/10.5281/zenodo.23647165", "self_doi": "https://doi.org/10.5281/zenodo.23647165", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23647165", "reserve_doi": "https://zenodo.org/api/records/23647165/draft/pids/doi", "parent": "https://zenodo.org/api/records/23647164", "parent_html": "https://zenodo.org/records/23647164", "parent_doi": "https://doi.org/10.5281/zenodo.23647164", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23647164", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:23647165/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:23647165/sequence/default", "files": "https://zenodo.org/api/records/23647165/files", "media_files": "https://zenodo.org/api/records/23647165/media-files", "latest": "https://zenodo.org/api/records/23647165/versions/latest", "latest_html": "https://zenodo.org/records/23647165/latest", "versions": "https://zenodo.org/api/records/23647165/versions", "draft": "https://zenodo.org/api/records/23647165/draft", "access_links": "https://zenodo.org/api/records/23647165/access/links", "access_grants": "https://zenodo.org/api/records/23647165/access/grants", "access_users": "https://zenodo.org/api/records/23647165/access/users", "access_request": "https://zenodo.org/api/records/23647165/access/request", "access": "https://zenodo.org/api/records/23647165/access", "communities": "https://zenodo.org/api/records/23647165/communities", "communities-suggestions": "https://zenodo.org/api/records/23647165/communities-suggestions", "request_deletion": "https://zenodo.org/api/records/23647165/request-deletion", "file_modification": "https://zenodo.org/api/records/23647165/file-modification", "quota_increase": "https://zenodo.org/api/records/23647165/quota-increase", "requests": "https://zenodo.org/api/records/23647165/requests"}, "updated": "2026-10-25T17:49:27.470324+00:00", "recid": "23647165", "revision": 4, "files": [{"id": "5a578437-84dd-415b-89fb-728249cd4659", "key": "Benyahia_EROI_frontier_replication_package.zip", "size": 1014922, "checksum": "md5:61a59bcbe8148148e8b1d39d4e927e9e", "links": {"self": "https://zenodo.org/api/records/23647165/files/Benyahia_EROI_frontier_replication_package.zip/content"}}], "swh": null, "owners": [{"id": "1769142"}], "status": "published", "stats": {"downloads": 0, "unique_downloads": 0, "views": 3, "unique_views": 3, "version_downloads": 0, "version_unique_downloads": 0, "version_unique_views": 3, "version_views": 3}, "state": "done", "submitted": true}, {"created": "2026-10-24T20:41:15.372466+00:00", "modified": "2026-10-24T20:41:15.574170+00:00", "id": 23625231, "conceptrecid": "23625230", "doi": "10.5281/zenodo.23625231", "conceptdoi": "10.5281/zenodo.23625230", "doi_url": "https://doi.org/10.5281/zenodo.23625231", "metadata": {"title": "Replication Package for \"Household Vulnerability Screening Under Temporal Drift\"", "doi": "10.5281/zenodo.23625231", "publication_date": "2026-10-24", "description": "<p>This repository provides the replication package for the manuscript <em>Household Vulnerability Screening under Temporal Drift: </em><em>Evaluation Design, Calibration and Coverage</em>. It contains the code, documentation, generated figures, generated tables, software requirements, and workflow automation scripts designed to support reproduction of the reported analyses.</p>\n<p>The package is centred on a Python-based analytical workflow covering data preparation, quality checks, variable construction, operationalisation of the Stress &times; Savings framework, four-state household vulnerability classification, predictive modelling, probability calibration, validation, robustness analyses, and out-of-time performance assessment. A detailed replication guide documents the computational environment, execution sequence, expected inputs, and procedures used to reproduce the reported results. A separate base-R script is provided as an independent cross-check of selected statistical outputs.</p>\n<div>The underlying survey microdata are not redistributed in this repository. Researchers must obtain the data separately from the World Bank Microdata Library's&nbsp;<em>Listening to the Citizens of Uzbekistan Survey 2018&ndash;2025</em> (study identifier UZB_2018-2025_L2CU_v03_M), subject to the provider's access conditions. The study is available at: https://microdata.worldbank.org/catalog/6412.&nbsp;</div>", "access_right": "open", "creators": [{"name": "Khaydarov, Ravshan", "affiliation": "TU Dublin", "orcid": "0009-0006-8859-9995"}, {"name": "Hofmann, Markus", "affiliation": "TU Dublin", "orcid": "0000-0002-9215-8862"}], "keywords": ["social protection", "household vulnerability", "public policy", "development economics", "data science", "machine learning", "survey data", "targeting"], "dates": [{"type": "created"}], "version": "v1.0", "language": "eng", "custom": {"code:programmingLanguage": [{"id": "python", "title": {"en": "Python"}}, {"id": "r", "title": {"en": "R"}}], "code:developmentStatus": {"id": "active", "title": {"en": "Active"}}}, "resource_type": {"title": "Computational notebook", "type": "software", "subtype": "computationalnotebook"}, "license": {"id": "mit-license"}, "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "23625230"}}]}}, "title": "Replication Package for \"Household Vulnerability Screening Under Temporal Drift\"", "links": {"self": "https://zenodo.org/api/records/23625231", "self_html": "https://zenodo.org/records/23625231", "preview_html": "https://zenodo.org/records/23625231?preview=1", "doi": "https://doi.org/10.5281/zenodo.23625231", "self_doi": "https://doi.org/10.5281/zenodo.23625231", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23625231", "reserve_doi": "https://zenodo.org/api/records/23625231/draft/pids/doi", "parent": "https://zenodo.org/api/records/23625230", "parent_html": "https://zenodo.org/records/23625230", "parent_doi": "https://doi.org/10.5281/zenodo.23625230", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23625230", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:23625231/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:23625231/sequence/default", "files": "https://zenodo.org/api/records/23625231/files", "media_files": "https://zenodo.org/api/records/23625231/media-files", "latest": "https://zenodo.org/api/records/23625231/versions/latest", "latest_html": "https://zenodo.org/records/23625231/latest", "versions": "https://zenodo.org/api/records/23625231/versions", "draft": "https://zenodo.org/api/records/23625231/draft", "access_links": "https://zenodo.org/api/records/23625231/access/links", "access_grants": "https://zenodo.org/api/records/23625231/access/grants", "access_users": "https://zenodo.org/api/records/23625231/access/users", "access_request": "https://zenodo.org/api/records/23625231/access/request", "access": "https://zenodo.org/api/records/23625231/access", "communities": "https://zenodo.org/api/records/23625231/communities", "communities-suggestions": "https://zenodo.org/api/records/23625231/communities-suggestions", "request_deletion": "https://zenodo.org/api/records/23625231/request-deletion", "file_modification": "https://zenodo.org/api/records/23625231/file-modification", "quota_increase": "https://zenodo.org/api/records/23625231/quota-increase", "requests": "https://zenodo.org/api/records/23625231/requests"}, "updated": "2026-10-24T20:41:15.574170+00:00", "recid": "23625231", "revision": 4, "files": [{"id": "e4d73545-678c-47d0-a6d7-ce82b64460b7", "key": "Household_Vulnerability_Screening_Under_Temporal_Drift_Replication.zip", "size": 6547241, "checksum": "md5:4c84153521ecf661c2d98508bf2315a2", "links": {"self": "https://zenodo.org/api/records/23625231/files/Household_Vulnerability_Screening_Under_Temporal_Drift_Replication.zip/content"}}], "swh": null, "owners": [{"id": "1963702"}], "status": "published", "stats": {"downloads": 1, "unique_downloads": 1, "views": 5, "unique_views": 4, "version_downloads": 1, "version_unique_downloads": 1, "version_unique_views": 4, "version_views": 5}, "state": "done", "submitted": true}, {"created": "2026-10-24T18:57:36.388662+00:00", "modified": "2026-10-24T18:57:36.546804+00:00", "id": 23624408, "conceptrecid": "23624407", "doi": "10.5281/zenodo.23624408", "conceptdoi": "10.5281/zenodo.23624407", "doi_url": "https://doi.org/10.5281/zenodo.23624408", "metadata": {"title": "DEA-MP/H: replication package for household multidimensional poverty measurement", "doi": "10.5281/zenodo.23624408", "publication_date": "2026-10-24", "description": "<p>Replication package accompanying manuscript version 11 of &ldquo;Pesos end&oacute;genos e monotonicidade na mensura&ccedil;&atilde;o da pobreza multidimensional&rdquo;. DEA-MP/H measures relative multidimensional deprivation at household level using a fixed DEA reference, nested categorical comparison groups, resource share floors and iterative screening of reference households.<br><br>The archive contains the R implementation, a single entry point (run_all.R), variable documentation, aggregate empirical results for the Brazilian Demographic Censuses of 2010 and 2022, robustness analyses, computational checks, execution log and SHA-256 manifests. Census microdata and individual intermediate bases are excluded; the scripts obtain official public inputs from IBGE. Empirical applications illustrate the proposed method.<br><br>Version 1.1.0 corresponds to manuscript v11 (24 October 2026). Code and documentation: MIT license. Repository: https://github.com/moisesluna2026/dea-mp-h</p>", "access_right": "open", "creators": [{"name": "Brand\u00e3o, Mois\u00e9s Luna", "affiliation": "Escola de Engenharia de S\u00e3o Carlos, Universidade de S\u00e3o Paulo"}, {"name": "Mariano, Enzo Barberio", "affiliation": "Universidade Estadual Paulista (UNESP)"}, {"name": "Rebelatto, Daisy Aparecida do Nascimento", "affiliation": "Escola de Engenharia de S\u00e3o Carlos, Universidade de S\u00e3o Paulo"}], "keywords": ["multidimensional poverty"], "version": "1.1.0", "custom": {"code:codeRepository": "https://github.com/moisesluna2026/dea-mp-h", "code:programmingLanguage": [{"id": "r", "title": {"en": "R"}}]}, "resource_type": {"title": "Software", "type": "software"}, "license": {"id": "mit-license"}, "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "23624407"}}]}}, "title": "DEA-MP/H: replication package for household multidimensional poverty measurement", "links": {"self": "https://zenodo.org/api/records/23624408", "self_html": "https://zenodo.org/records/23624408", "preview_html": "https://zenodo.org/records/23624408?preview=1", "doi": "https://doi.org/10.5281/zenodo.23624408", "self_doi": "https://doi.org/10.5281/zenodo.23624408", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23624408", "reserve_doi": "https://zenodo.org/api/records/23624408/draft/pids/doi", "parent": "https://zenodo.org/api/records/23624407", "parent_html": "https://zenodo.org/records/23624407", "parent_doi": "https://doi.org/10.5281/zenodo.23624407", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23624407", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:23624408/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:23624408/sequence/default", "files": "https://zenodo.org/api/records/23624408/files", "media_files": "https://zenodo.org/api/records/23624408/media-files", "latest": "https://zenodo.org/api/records/23624408/versions/latest", "latest_html": "https://zenodo.org/records/23624408/latest", "versions": "https://zenodo.org/api/records/23624408/versions", "draft": "https://zenodo.org/api/records/23624408/draft", "access_links": "https://zenodo.org/api/records/23624408/access/links", "access_grants": "https://zenodo.org/api/records/23624408/access/grants", "access_users": "https://zenodo.org/api/records/23624408/access/users", "access_request": "https://zenodo.org/api/records/23624408/access/request", "access": "https://zenodo.org/api/records/23624408/access", "communities": "https://zenodo.org/api/records/23624408/communities", "communities-suggestions": "https://zenodo.org/api/records/23624408/communities-suggestions", "request_deletion": "https://zenodo.org/api/records/23624408/request-deletion", "file_modification": "https://zenodo.org/api/records/23624408/file-modification", "quota_increase": "https://zenodo.org/api/records/23624408/quota-increase", "requests": "https://zenodo.org/api/records/23624408/requests"}, "updated": "2026-10-24T18:57:36.546804+00:00", "recid": "23624408", "revision": 4, "files": [{"id": "9fd344d8-bb35-4dfd-8d01-91411c180f71", "key": "DEA-MP-H_v1.1.0_artigo_v11.zip", "size": 121764, "checksum": "md5:f9755f3b9de2fa4fc2346ebeb3257be1", "links": {"self": "https://zenodo.org/api/records/23624408/files/DEA-MP-H_v1.1.0_artigo_v11.zip/content"}}], "swh": null, "owners": [{"id": "1669653"}], "status": "published", "stats": {"downloads": 1, "unique_downloads": 1, "views": 7, "unique_views": 6, "version_downloads": 1, "version_unique_downloads": 1, "version_unique_views": 6, "version_views": 7}, "state": "done", "submitted": true}, {"created": "2026-10-24T16:48:57.849631+00:00", "modified": "2026-10-24T16:49:39.972040+00:00", "id": 23622666, "conceptrecid": "23622665", "doi": "10.5281/zenodo.23622666", "conceptdoi": "10.5281/zenodo.23622665", "doi_url": "https://doi.org/10.5281/zenodo.23622666", "metadata": {"title": "Replication package for: Software issue triage without the ticket text: what metadata delivers, what local language models recover, and what masking costs", "doi": "10.5281/zenodo.23622666", "publication_date": "2026-10-24", "description": "<div>\n<div>Code, configuration, pre-registered protocol, prompts, harmonisation maps and aggregate results for a two-sided&nbsp;study of automated software issue triage without ticket text: the value of text over creation-time metadata on eight&nbsp;open-source software projects' public Jira trackers (term-frequency and fine-tuned transformer models, locally run open-weight language models&nbsp;of 9 and 27 billion parameters), metadata-only triage on the de-identified issue tracker of an industrial software&nbsp;organisation, the agreement of the metadata signal across trackers, and the accuracy cost of entity masking.&nbsp;Every number, table and figure in the accompanying article is traced to a file in `results/`. The industrial&nbsp;records are confidential and not included; the public issues are available from the Public Jira Dataset under&nbsp;its licence. Code: Apache License 2.0. Documents, tables and figures: CC BY 4.0.</div>\n</div>", "access_right": "open", "creators": [{"name": "Nuviadenu, Johnson", "affiliation": "University of South Africa", "orcid": "0009-0002-2994-8797"}, {"name": "Masombuka, Themba", "affiliation": "University of South Africa", "orcid": "0000-0002-8855-2445"}, {"name": "Mnkandla, Ernest", "affiliation": "University of South Africa", "orcid": "0000-0003-3989-5617"}, {"name": "Sibiya, Malusi", "affiliation": "University of South Africa", "orcid": "0000-0001-5617-768X"}], "keywords": ["software engineering", "issue triage", "priority prediction", "bug assignment", "data privacy", "large language models", "survival   analysis", "industrial case study"], "dates": [{"type": "available"}], "language": "eng", "resource_type": {"title": "Software", "type": "software"}, "license": {"id": "cc-by-4.0"}, "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "23622665"}}]}}, "title": "Replication package for: Software issue triage without the ticket text: what metadata delivers, what local language models recover, and what masking costs", "links": {"self": "https://zenodo.org/api/records/23622666", "self_html": "https://zenodo.org/records/23622666", "preview_html": "https://zenodo.org/records/23622666?preview=1", "doi": "https://doi.org/10.5281/zenodo.23622666", "self_doi": "https://doi.org/10.5281/zenodo.23622666", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23622666", "reserve_doi": "https://zenodo.org/api/records/23622666/draft/pids/doi", "parent": "https://zenodo.org/api/records/23622665", "parent_html": "https://zenodo.org/records/23622665", "parent_doi": "https://doi.org/10.5281/zenodo.23622665", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23622665", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:23622666/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:23622666/sequence/default", "files": "https://zenodo.org/api/records/23622666/files", "media_files": "https://zenodo.org/api/records/23622666/media-files", "latest": "https://zenodo.org/api/records/23622666/versions/latest", "latest_html": "https://zenodo.org/records/23622666/latest", "versions": "https://zenodo.org/api/records/23622666/versions", "draft": "https://zenodo.org/api/records/23622666/draft", "access_links": "https://zenodo.org/api/records/23622666/access/links", "access_grants": "https://zenodo.org/api/records/23622666/access/grants", "access_users": "https://zenodo.org/api/records/23622666/access/users", "access_request": "https://zenodo.org/api/records/23622666/access/request", "access": "https://zenodo.org/api/records/23622666/access", "communities": "https://zenodo.org/api/records/23622666/communities", "communities-suggestions": "https://zenodo.org/api/records/23622666/communities-suggestions", "request_deletion": "https://zenodo.org/api/records/23622666/request-deletion", "file_modification": "https://zenodo.org/api/records/23622666/file-modification", "quota_increase": "https://zenodo.org/api/records/23622666/quota-increase", "requests": "https://zenodo.org/api/records/23622666/requests"}, "updated": "2026-10-24T16:49:39.972040+00:00", "recid": "23622666", "revision": 6, "files": [{"id": "654bdfd1-d95c-4fe4-85d4-6b538c8605c4", "key": "replication_package_v1.0.0.zip", "size": 45317786, "checksum": "md5:e3e9d86ec10fd2557c059c9a876b2f27", "links": {"self": "https://zenodo.org/api/records/23622666/files/replication_package_v1.0.0.zip/content"}}], "swh": null, "owners": [{"id": "1535914"}], "status": "published", "stats": {"downloads": 2, "unique_downloads": 2, "views": 5, "unique_views": 4, "version_downloads": 2, "version_unique_downloads": 2, "version_unique_views": 4, "version_views": 5}, "state": "done", "submitted": true}, {"created": "2026-10-24T14:18:28.676365+00:00", "modified": "2026-10-24T14:18:28.785490+00:00", "id": 23619914, "conceptrecid": "23601278", "doi": "10.5281/zenodo.23619914", "conceptdoi": "10.5281/zenodo.23601278", "doi_url": "https://doi.org/10.5281/zenodo.23619914", "metadata": {"title": "FAST: Fair Assessment of Student\u2013Teacher Distillation for Issue Classification", "doi": "10.5281/zenodo.23619914", "publication_date": "2026-10-24", "description": "<h2>FAST: replication package</h2>\n<p>Code, data, teacher models and results for <em>FAST</em> . The study distils released DistilRoBERTa issue classifiers (teachers) into cheaper students: a TF-IDF SVM, a DAN, CatBoost, fastText, and fine-tuned MiniLM.</p>\n<h3>Contents</h3>\n<table>\n<tbody>\n<tr>\n<th>Path</th>\n<th>What</th>\n</tr>\n</tbody>\n<tbody>\n<tr>\n<td><code>scripts/r12.py</code></td>\n<td>Drives the whole study: <code>data</code>, <code>rq</code>, <code>search</code>, <code>explore</code>, <code>design</code>, <code>report</code></td>\n</tr>\n<tr>\n<td><code>scripts/r12_revision.py</code></td>\n<td>Extra analyses: fastText, label channels, teacher&ndash;gold agreement, OOD saliency sweep, substring relabelling, energy calibration, ONNX serving</td>\n</tr>\n<tr>\n<td><code>scripts/r12_report.py</code>, <code>scripts/r12_paper_tables.py</code></td>\n<td>Result tables (<code>results/r12_spark/report/</code>) and LaTeX tables (<code>paper/</code>)</td>\n</tr>\n<tr>\n<td><code>scripts/r12_qualitative.py</code></td>\n<td>Samples items for human annotation and scores the returned sheets</td>\n</tr>\n<tr>\n<td><code>scripts/build_fresh_testset.py</code></td>\n<td>Builds the post-cutoff (temporal) test set; its cleaning rules are reused by <code>r12.py</code></td>\n</tr>\n<tr>\n<td><code>src/fast/</code>, <code>configs/</code>, <code>tests/</code></td>\n<td>Library code, hyperparameters, unit tests</td>\n</tr>\n<tr>\n<td><code>models/binary_classification_train_*</code></td>\n<td>The 9 teacher heads (7 quality attributes, TD, test debt)</td>\n</tr>\n<tr>\n<td><code>cache/frames/</code>, <code>cache/onnx/</code></td>\n<td>Raw labelled issue corpora; ONNX exports of the two heads released without one</td>\n</tr>\n<tr>\n<td><code>data/fresh/</code></td>\n<td>Post-cutoff GitHub issues (2024-11 to 2026-09), the temporal OOD set</td>\n</tr>\n<tr>\n<td><code>results/r12_spark/</code></td>\n<td>All outputs: cleaned splits and OOD sets (<code>data/</code>), RQ1&ndash;RQ4 (<code>rq/</code>), RQ2b (<code>rq2b/</code>), students &times; signals (<code>explore/</code>), serving design (<code>design/</code>), revision analyses (<code>revision/</code>), tables (<code>report/</code>), hardware (<code>ENV.json</code>)</td>\n</tr>\n<tr>\n<td><code>Qualitative-annotations/</code></td>\n<td>Human annotation sheets from three annotators (see below)</td>\n</tr>\n</tbody>\n</table>\n<h3>Where each research question comes from</h3>\n<table>\n<tbody>\n<tr>\n<th>RQ</th>\n<th>Stage</th>\n<th>Output</th>\n</tr>\n</tbody>\n<tbody>\n<tr>\n<td><strong>RQ1</strong> &ndash; Teacher vs. students, in and out of distribution</td>\n<td><code>r12.py rq</code>, <code>explore</code></td>\n<td><code>rq/</code>, <code>explore/</code>, <code>report/summary_vs_teacher.csv</code></td>\n</tr>\n<tr>\n<td><strong>RQ2</strong> &ndash; Which teacher signals help which students (vs. placebos)</td>\n<td><code>r12.py rq</code>, <code>search</code>, <code>explore</code>; <code>r12_revision.py sweep_ood</code></td>\n<td><code>rq2b/</code>, <code>report/signals.csv</code>, <code>revision/sweep_ood/</code></td>\n</tr>\n<tr>\n<td><strong>RQ3</strong> &ndash; Teacher as annotator</td>\n<td><code>r12_revision.py channels</code>, <code>agree</code></td>\n<td><code>revision/channels/</code>, <code>revision/agree/</code></td>\n</tr>\n<tr>\n<td><strong>RQ4</strong> &ndash; Serving cost, break-even, best config per latency budget</td>\n<td><code>r12.py design</code>, <code>report</code>; <code>r12_revision.py calib</code>, <code>onnx</code></td>\n<td><code>design/</code>, <code>report/cost.csv</code>, <code>report/design_*.csv</code></td>\n</tr>\n</tbody>\n</table>\n<h3>Reproduce</h3>\n<p>Run from this directory (teacher paths are relative to it).</p>\n<pre><code>python3 -m venv .venv &amp;&amp; . .venv/bin/activate\npip install -r requirements.txt\nmake test PY=python                      # offline unit tests\n\nexport R12_ALLOW_ANY_HOST=1              # the driver otherwise insists on the GB10 it ran on\nexport FAST_TRUST_UNSIGNED_CACHE=1       # accept the shipped extraction pickles\nmake r12 PY=python                       # main study\nmake revision PY=python                  # extra analyses (run energy stages on an idle GPU)\nmake tables PY=python                    # LaTeX tables -&gt; paper/paper_r12/tables</code></pre>\n<p><strong>Notes</strong></p>\n<ul>\n<li>Stages skip outputs that already exist. To rerun one, move its directory under <code>results/r12_spark/</code> aside.</li>\n<li>Extraction pickles are HMAC-signed with a per-machine key that is not shipped, hence <code>FAST_TRUST_UNSIGNED_CACHE=1</code>. Unpickling runs code, so set it only for files from this archive; otherwise delete <code>results/r12_spark/data/extract/</code> and the teachers re-extract (GPU recommended).</li>\n<li><code>sentence-transformers/all-MiniLM-L6-v2</code>, <code>-L12-v2</code> and the <code>distilroberta-base</code> tokenizer download from Hugging Face on first use.</li>\n<li>Teachers load with <code>attn_implementation=\"eager\"</code>; SDPA/flash kernels return no attention.</li>\n<li>Seeds 13, 17, 19. Latency and energy depend on hardware: the original run used an NVIDIA DGX Spark (GB10, 20-core Arm), see <code>results/r12_spark/ENV.json</code>.</li>\n</ul>\n<h3>Qualitative annotations</h3>\n<p><code>Qualitative-annotations/annotator_{A,B,C}.csv</code> hold the returned human annotation sheets. Each annotator labelled 60 issues (<code>item_id</code> <code>TS-NNNN</code>); 20 items are shared by all three (inter-annotator agreement), the other 40 per sheet are unique, 140 issues in total.</p>\n<p>Every item is a disagreement: two models, blinded as A and B, tag the same quality attribute, one as <code>&lt;attribute&gt;</code> and the other as <code>NOT &lt;attribute&gt;</code>. Model identities and annotators are anonymised; the A/B keys will be released on publication.</p>\n<table>\n<tbody>\n<tr>\n<th>Column</th>\n<th>Meaning</th>\n</tr>\n</tbody>\n<tbody>\n<tr>\n<td><code>item_id</code></td>\n<td>Pseudonymous item ID</td>\n</tr>\n<tr>\n<td><code>issue</code></td>\n<td>Issue title and body, as shown to the annotator</td>\n</tr>\n<tr>\n<td><code>model_A_tag</code>, <code>model_B_tag</code></td>\n<td>The two blinded model predictions</td>\n</tr>\n<tr>\n<td><code>your_label</code></td>\n<td>Annotator's own quality attribute (free text; <code>none</code>/<code>unusable</code> when no attribute applies)</td>\n</tr>\n<tr>\n<td><code>your_label_confidence (1-5)</code></td>\n<td>Annotator's confidence in <code>your_label</code></td>\n</tr>\n<tr>\n<td><code>A_correct (yes/no)</code>, <code>B_correct (yes/no)</code></td>\n<td>Whether each model's tag is right</td>\n</tr>\n</tbody>\n</table>\n<p><code>annotator_A.csv</code> is <code>;</code>-separated, B and C are <code>,</code>-separated with a UTF-8 BOM. A few rows are left blank (8, 2 and 6 in A, B, C). The labels are kept as returned, spelling included.</p>\n<h3>Anonymisation</h3>\n<p>Identifying Hugging Face IDs were rewritten: teachers point to the bundled <code>models/</code>, datasets read <code>anonymous/...</code> (never fetched, the corpora ship in <code>cache/frames/</code>). Host names and local paths are scrubbed, and the code no longer records host names, git commits or local time zones. Original IDs will be restored on publication.</p>\n<p><strong>Release.</strong> This package is shared for review only. The full, de-anonymised replication package will be released publicly after the review.</p>", "access_right": "open", "creators": [{"name": "anon", "affiliation": null}], "resource_type": {"title": "Software", "type": "software"}, "license": {"id": "cc-by-4.0"}, "relations": {"version": [{"index": 1, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "23601278"}}]}}, "title": "FAST: Fair Assessment of Student\u2013Teacher Distillation for Issue Classification", "links": {"self": "https://zenodo.org/api/records/23619914", "self_html": "https://zenodo.org/records/23619914", "preview_html": "https://zenodo.org/records/23619914?preview=1", "doi": "https://doi.org/10.5281/zenodo.23619914", "self_doi": "https://doi.org/10.5281/zenodo.23619914", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23619914", "reserve_doi": "https://zenodo.org/api/records/23619914/draft/pids/doi", "parent": "https://zenodo.org/api/records/23601278", "parent_html": "https://zenodo.org/records/23601278", "parent_doi": "https://doi.org/10.5281/zenodo.23601278", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23601278", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:23619914/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:23619914/sequence/default", "files": "https://zenodo.org/api/records/23619914/files", "media_files": "https://zenodo.org/api/records/23619914/media-files", "latest": "https://zenodo.org/api/records/23619914/versions/latest", "latest_html": "https://zenodo.org/records/23619914/latest", "versions": "https://zenodo.org/api/records/23619914/versions", "draft": "https://zenodo.org/api/records/23619914/draft", "access_links": "https://zenodo.org/api/records/23619914/access/links", "access_grants": "https://zenodo.org/api/records/23619914/access/grants", "access_users": "https://zenodo.org/api/records/23619914/access/users", "access_request": "https://zenodo.org/api/records/23619914/access/request", "access": "https://zenodo.org/api/records/23619914/access", "communities": "https://zenodo.org/api/records/23619914/communities", "communities-suggestions": "https://zenodo.org/api/records/23619914/communities-suggestions", "request_deletion": "https://zenodo.org/api/records/23619914/request-deletion", "file_modification": "https://zenodo.org/api/records/23619914/file-modification", "quota_increase": "https://zenodo.org/api/records/23619914/quota-increase", "requests": "https://zenodo.org/api/records/23619914/requests"}, "updated": "2026-10-24T14:18:28.785490+00:00", "recid": "23619914", "revision": 4, "files": [{"id": "d5b4907f-05bf-4817-8ad6-09a20c211d39", "key": "FAST-replication.zip", "size": 7456629377, "checksum": "md5:f492eb893ff6deb4fe4b3463a90463cc", "links": {"self": "https://zenodo.org/api/records/23619914/files/FAST-replication.zip/content"}}], "swh": null, "owners": [{"id": "328280"}], "status": "published", "stats": {"downloads": 0, "unique_downloads": 0, "views": 12, "unique_views": 9, "version_downloads": 0, "version_unique_downloads": 0, "version_unique_views": 4, "version_views": 5}, "state": "done", "submitted": true}, {"created": "2026-10-24T14:01:03.848788+00:00", "modified": "2026-10-24T14:01:04.012936+00:00", "id": 23619187, "conceptrecid": "23619186", "doi": "10.5281/zenodo.23619187", "conceptdoi": "10.5281/zenodo.23619186", "doi_url": "https://doi.org/10.5281/zenodo.23619187", "metadata": {"title": "Replication package for \"Paid for the extra hours? Homeworking access, unpaid overtime and the sectoral terms of discretion in UK employment\"", "doi": "10.5281/zenodo.23619187", "publication_date": "2026-10-24", "description": "<p>This package provides Stata/SE 19.5 code, aggregate analysis tables, a construct dictionary and execution instructions for research on homeworking access and the remuneration of extra working time. The analyses use 119,332 employee interviews from 42,839 people in Understanding Society Waves 2, 4, 6, 8, 10, 12 and 14, covering 2010-2024. Files cover data preparation, measurement checks, pooled and person-fixed-effects models, sector comparisons, sensitivity analyses and secondary bootstrap calculations. A standalone Stata script reproduces the coefficient figure without microdata. All findings are associational. No person-level survey data or respondent identifiers are included.</p>", "access_right": "open", "creators": [{"name": "Naqvi, Ariz", "affiliation": "American University of the Middle East", "orcid": "0000-0002-8539-7953"}, {"name": "Naqvi, Farah", "affiliation": "University of Wolverhampton", "orcid": "0000-0002-2944-3425"}], "keywords": ["homeworking; unpaid overtime; paid overtime; working time; employment relations; Understanding Society; panel data; Stata."], "related_identifiers": [{"identifier": "10.5255/UKDA-SN-6614-22", "relation": "isSourceOf", "resource_type": "dataset", "scheme": "doi"}], "version": "1.0.0", "resource_type": {"title": "Computational notebook", "type": "software", "subtype": "computationalnotebook"}, "licen