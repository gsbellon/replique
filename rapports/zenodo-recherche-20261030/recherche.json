equests"}, "updated": "2026-10-30T05:55:35.331897+00:00", "recid": "23792430", "revision": 6, "files": [{"id": "9b6f84ea-f490-4159-bad9-800797360364", "key": "ASOC_Replication_Zenodo_R6_20261030_DOI23792430.zip", "size": 3706066, "checksum": "md5:4a16785b2d5cc0503db6a9bba1e627c8", "links": {"self": "https://zenodo.org/api/records/23792430/files/ASOC_Replication_Zenodo_R6_20261030_DOI23792430.zip/content"}}], "swh": null, "owners": [{"id": "1964382"}], "status": "published", "stats": {"downloads": 2, "unique_downloads": 2, "views": 5, "unique_views": 3, "version_downloads": 2, "version_unique_downloads": 2, "version_unique_views": 3, "version_views": 5}, "state": "done", "submitted": true}, {"created": "2026-10-30T03:30:48.848008+00:00", "modified": "2026-10-30T03:30:49.077207+00:00", "id": 23790141, "conceptrecid": "23790140", "doi": "10.5281/zenodo.23790141", "conceptdoi": "10.5281/zenodo.23790140", "doi_url": "https://doi.org/10.5281/zenodo.23790141", "metadata": {"title": "Supplementary Repository for \"Between Accuracy and Privacy: Rethinking Developer-Identity De-Aliasing in Git Repositories\"", "doi": "10.5281/zenodo.23790141", "publication_date": "2026-10-30", "description": "<p>This supplementary repository consists of two parts:</p>\n<ul>\n<li><a href=\"https://github.com/bockthom/gitauthority/#gitauthority\"><strong>GitAuthority</strong></a>: the implementation of our configurable de-aliasing tool, which can be used on its own to de-alias author information in any set of name and email pairs.</li>\n<li><a href=\"https://github.com/bockthom/gitauthority/#evaluation\"><strong>Evaluation</strong></a>: the replication package of our article <em>Between Accuracy and Privacy: Rethinking Developer-Identity De-Aliasing in Git Repositories</em> (see <a href=\"https://github.com/bockthom/gitauthority/#cite-as\">Cite as</a>), containing all scripts to reproduce the analyses reported in the article.</li>\n</ul>\n<p>Note that the datasets used to validate GitAuthority are deliberately not part of this replication package. For privacy reasons, we cannot publish these datasets as they contain personal name and email addresses of real people. Anonymizing them is not possible because their actual spellings etc. are necessary to serve as a proper ground truth. However, this replication package contains detailed information on how to get access to the used datasets or how to create these datasets on your own. In case of questions regarding that, please reach out to the authors of this replication package.</p>", "access_right": "open", "creators": [{"name": "Bock, Thomas", "affiliation": null, "orcid": "0000-0001-6906-3489"}, {"name": "Agarwal, Shyam", "affiliation": null, "orcid": "0009-0009-2147-5674"}, {"name": "Atkisson, Curtis", "affiliation": null, "orcid": "0000-0003-3575-6871"}, {"name": "Mockus, Audris", "affiliation": null, "orcid": "0000-0002-7987-7598"}, {"name": "Vasilescu, Bogdan", "affiliation": null, "orcid": "0000-0003-4418-5783"}], "custom": {"code:codeRepository": "https://github.com/bockthom/gitauthority"}, "resource_type": {"title": "Software", "type": "software"}, "license": {"id": "mit-license"}, "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "23790140"}}]}}, "title": "Supplementary Repository for \"Between Accuracy and Privacy: Rethinking Developer-Identity De-Aliasing in Git Repositories\"", "links": {"self": "https://zenodo.org/api/records/23790141", "self_html": "https://zenodo.org/records/23790141", "preview_html": "https://zenodo.org/records/23790141?preview=1", "doi": "https://doi.org/10.5281/zenodo.23790141", "self_doi": "https://doi.org/10.5281/zenodo.23790141", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23790141", "reserve_doi": "https://zenodo.org/api/records/23790141/draft/pids/doi", "parent": "https://zenodo.org/api/records/23790140", "parent_html": "https://zenodo.org/records/23790140", "parent_doi": "https://doi.org/10.5281/zenodo.23