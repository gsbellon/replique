cords/23735615/media-files", "latest": "https://zenodo.org/api/records/23735615/versions/latest", "latest_html": "https://zenodo.org/records/23735615/latest", "versions": "https://zenodo.org/api/records/23735615/versions", "draft": "https://zenodo.org/api/records/23735615/draft", "access_links": "https://zenodo.org/api/records/23735615/access/links", "access_grants": "https://zenodo.org/api/records/23735615/access/grants", "access_users": "https://zenodo.org/api/records/23735615/access/users", "access_request": "https://zenodo.org/api/records/23735615/access/request", "access": "https://zenodo.org/api/records/23735615/access", "communities": "https://zenodo.org/api/records/23735615/communities", "communities-suggestions": "https://zenodo.org/api/records/23735615/communities-suggestions", "request_deletion": "https://zenodo.org/api/records/23735615/request-deletion", "file_modification": "https://zenodo.org/api/records/23735615/file-modification", "quota_increase": "https://zenodo.org/api/records/23735615/quota-increase", "requests": "https://zenodo.org/api/records/23735615/requests"}, "updated": "2026-10-28T15:33:21.539242+00:00", "recid": "23735615", "revision": 4, "files": [{"id": "3e2514c4-dd14-4647-81a2-529709d16cc4", "key": "shiguangzhe666/llm-test-generation-quarantine-v1.0.0.zip", "size": 2606328, "checksum": "md5:81d27bdae77cb3d22f8f36fc87f7275c", "links": {"self": "https://zenodo.org/api/records/23735615/files/shiguangzhe666/llm-test-generation-quarantine-v1.0.0.zip/content"}}], "swh": null, "owners": [{"id": "1972598"}], "status": "published", "stats": {"downloads": 1, "unique_downloads": 1, "views": 4, "unique_views": 4, "version_downloads": 1, "version_unique_downloads": 1, "version_unique_views": 4, "version_views": 4}, "state": "done", "submitted": true}, {"created": "2026-10-28T15:04:33.641150+00:00", "modified": "2026-10-28T15:04:33.863951+00:00", "id": 23732723, "conceptrecid": "23433636", "doi": "10.5281/zenodo.23732723", "conceptdoi": "10.5281/zenodo.23433636", "doi_url": "https://doi.org/10.5281/zenodo.23732723", "metadata": {"title": "Replication package for \"Adaptation to climate-induced macrofinancial risks: top-down and bottom-up solutions\"", "doi": "10.5281/zenodo.23732723", "publication_date": "2026-10-28", "description": "<p>Replication package for Legrenzi, Ciola and Bazzana, &ldquo;Adaptation to climate-induced macrofinancial risks: top-down and bottom-up solutions&rdquo;. The package contains the MATLAB implementation of a Stock-Flow-Consistent Agent-Based Integrated Assessment Model, the empirical calibration and the PSO/RWMH structural estimation routines, the input data on emissions and climate damages, the full simulation output (13 scenarios with 250 Monte Carlo simulations each), and the scripts that regenerate figures and tables in the paper.</p>\n<p>Running \"master_replication.m\" in the package root reproduces the complete set of exhibits. See \"README.txt\" for software requirements, folder structure and a file-by-file description.</p>\n<p>Changes in version 2. The script producing Table D.1 has been renamed to Table_D1_parameters.m, writing Table_D1.csv. A new script, Table_D2_initial_values.m, reproduces Table D.2 (initialized values) by solving the model&rsquo;s initialization system from the same estimated parameter vector; master_replication.m now runs and collects both, and the README documents the two steps. The figures and tables are no longer shipped as files: master_replication.m regenerates every exhibit from the simulation output included in the package.</p>", "access_right": "open", "creators": [{"name": "Legrenzi, Demis", "affiliation": "Universit\u00e0 degli Studi di Brescia", "orcid": "0009-0001-7737-1307"}, {"name": "Ciola, Emanuele", "affiliation": "Universit\u00e0 degli Studi di Firenze", "orcid": "0000-0001-8404-290X"}, {"name": "Bazzana, Davide", "affiliation": "Universit\u00e0 degli Studi di Brescia", "orcid": "0000-0002-9561-3699"}], "keywords": ["integrated assessment model", "agent-based model", "financial stability", "climate change adaptation", "climate-aware monetary policy"], "version": "v2", "language": "eng", "custom": {"code:programmingLanguage": [{"id": "matlab", "title": {"en": "MATLAB"}}, {"id": "r", "title": {"en": "R"}}]}, "resource_type": {"title": "Software", "type": "software"}, "license": {"id": "gpl-3.0-or-later"}, "relations": {"version": [{"index": 1, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "23433636"}}]}}, "title": "Replication package for \"Adaptation to climate-induced macrofinancial risks: top-down and bottom-up solutions\"", "links": {"self": "https://zenodo.org/api/records/23732723", "self_html": "https://zenodo.org/records/23732723", "preview_html": "https://zenodo.org/records/23732723?preview=1", "doi": "https://doi.org/10.5281/zenodo.23732723", "self_doi": "https://doi.org/10.5281/zenodo.23732723", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23732723", "reserve_doi": "https://zenodo.org/api/records/23732723/draft/pids/doi", "parent": "https://zenodo.org/api/records/23433636", "parent_html": "https://zenodo.org/records/23433636", "parent_doi": "https://doi.org/10.5281/zenodo.23433636", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23433636", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:23732723/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:23732723/sequence/default", "files": "https://zenodo.org/api/records/23732723/files", "media_files": "https://zenodo.org/api/records/23732723/media-files", "latest": "https://zenodo.org/api/records/23732723/versions/latest", "latest_html": "https://zenodo.org/records/23732723/latest", "versions": "https://zenodo.org/api/records/23732723/versions", "draft": "https://zenodo.org/api/records/23732723/draft", "access_links": "https://zenodo.org/api/records/23732723/access/links", "access_grants": "https://zenodo.org/api/records/23732723/access/grants", "access_users": "https://zenodo.org/api/records/23732723/access/users", "access_request": "https://zenodo.org/api/records/23732723/access/request", "access": "https://zenodo.org/api/records/23732723/access", "communities": "https://zenodo.org/api/records/23732723/communities", "communities-suggestions": "https://zenodo.org/api/records/23732723/communities-suggestions", "request_deletion": "https://zenodo.org/api/records/23732723/request-deletion", "file_modification": "https://zenodo.org/api/records/23732723/file-modification", "quota_increase": "https://zenodo.org/api/records/23732723/quota-increase", "requests": "https://zenodo.org/api/records/23732723/requests"}, "updated": "2026-10-28T15:04:33.863951+00:00", "recid": "23732723", "revision": 4, "files": [{"id": "b6c86684-f17c-4c9a-ad3b-37f5998c401d", "key": "README.txt", "size": 25499, "checksum": "md5:23318da8234c4aca3c2031ac6df9356f", "links": {"self": "https://zenodo.org/api/records/23732723/files/README.txt/content"}}, {"id": "e53f0c54-c17e-40a4-8a1f-75e9d34ce1d9", "key": "replication_package.zip", "size": 2299984606, "checksum": "md5:ce117883cf1cc49178ebaff0ecac423c", "links": {"self": "https://zenodo.org/api/records/23732723/files/replication_package.zip/content"}}], "swh": null, "owners": [{"id": "1940868"}], "status": "published", "stats": {"downloads": 10, "unique_downloads": 9, "views": 38, "unique_views": 25, "version_downloads": 4, "version_unique_downloads": 4, "version_unique_views": 4, "version_views": 7}, "state": "done", "submitted": true}, {"created": "2026-10-28T11:18:34.997337+00:00", "modified": "2026-10-28T11:29:39.141434+00:00", "id": 23728687, "conceptrecid": "22833607", "doi": "10.5281/zenodo.23728687", "conceptdoi": "10.5281/zenodo.22833607", "doi_url": "https://doi.org/10.5281/zenodo.23728687", "metadata": {"title": "Replication package: Ultra-Hard Discount Entry and Independent Retailers: Staggered Event-Study Evidence from French Establishment Data", "doi": "10.5281/zenodo.23728687", "publication_date": "2026-10-28", "description": "<p>Version 2.0.0 of the replication package. It corresponds to the revised manuscript, which measures the effect of each opening of the chain Action in France on the stock, the entries and the exits of independent retailers (single-establishment legal units in NAF division 47, franchise networks removed) with a staggered event-study design at the level of the bassin de vie and in rings of 0-1, 1-3 and 3-10 km around each store. The design, the hypotheses and their expected signs were pre-registered before estimation (10.5281/zenodo.23669588) and amended once before the secondary analysis (10.5281/zenodo.23670901). The package contains the nineteen scripts of the pipeline (treatment dates from the SIRENE register, panels, minimum detectable effect, event study with the Callaway and Sant'Anna estimator, flows with their own minimum detectable effect and robustness ladder, robustness ladder and stacked re-computation of the stock, rings with bootstrap intervals and a ring-level minimum detectable effect, geocoding, density tests, national panel, format replication, date-shift robustness) and the script of Figure 1, the intermediate datasets they produce, the console output of every run of 26 and 28 October 2026, the pre-registration files with their SHA-256 hashes, and the files of version 1.0.0 that Appendices A and B still use. The raw SIRENE register (about 3 GB) is public and is not included; the README says where to download the release of 1 October 2026. Requirements: Python 3.12 with pandas, pyarrow, duckdb, numpy, scipy, statsmodels, pyproj and python-calamine.</p><p>MD5 of the zip: 4e8549b5e2d1a8f1e9c7e1c9bb9650b1.</p>", "access_right": "open", "creators": [{"name": "Restrepo-Morales, Jorge Anibal", "affiliation": "Universidad Aut\u00f3noma del Per\u00fa; Tecnol\u00f3gico de Antioquia", "orcid": "0000-0001-9764-6622"}, {"name": "Rodr\u00edguez Flores, Eduar Antonio", "affiliation": "Universidad Aut\u00f3noma del Per\u00fa", "orcid": "0000-0003-0807-6686"}, {"name": "Giraldo Betancur, Emerson Andr\u00e9s", "affiliation": "Tecnol\u00f3gico de Antioquia", "orcid": "0000-0002-1779-1262"}, {"name": "Zea Restrepo, Freddy", "affiliation": "Tecnol\u00f3gico de Antioquia", "orcid": "0009-0005-1882-8433"}], "keywords": ["retail", "hard discount", "non-food retail", "economies of density", "assortment rotation", "small prices", "independent stores", "micro-enterprises", "Eurostat", "private equity", "Action", "European retail"], "version": "2.0.0", "language": "eng", "resource_type": {"title": "Software", "type": "software"}, "license": {"id": "cc-by-4.0"}, "relations": {"version": [{"index": 1, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "22833607"}}]}}, "title": "Replication package: Ultra-Hard Discount Entry and Independent Retailers: Staggered Event-Study Evidence from French Establishment Data", "links": {"self": "https://zenodo.org/api/records/23728687", "self_html": "https://zenodo.org/records/23728687", "preview_html": "https://zenodo.org/records/23728687?preview=1", "doi": "https://doi.org/10.5281/zenodo.23728687", "self_doi": "https://doi.org/10.5281/zenodo.23728687", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23728687", "reserve_doi": "https://zenodo.org/api/records/23728687/draft/pids/doi", "parent": "https://zenodo.org/api/records/22833607", "parent_html": "https://zenodo.org/records/22833607", "parent_doi": "https://doi.org/10.5281/zenodo.22833607", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.22833607", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:23728687/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:23728687/sequence/default", "files": "https://zenodo.org/api/records/23728687/files", "media_files": "https://zenodo.org/api/records/23728687/media-files", "latest": "https://zenodo.org/api/records/23728687/versions/latest", "latest_html": "https://zenodo.org/records/23728687/latest", "versions": "https://zenodo.org/api/records/23728687/versions", "draft": "https://zenodo.org/api/records/23728687/draft", "access_links": "https://zenodo.org/api/records/23728687/access/links", "access_grants": "https://zenodo.org/api/records/23728687/access/grants", "access_users": "https://zenodo.org/api/records/23728687/access/users", "access_request": "https://zenodo.org/api/records/23728687/access/request", "access": "https://zenodo.org/api/records/23728687/access", "communities": "https://zenodo.org/api/records/23728687/communities", "communities-suggestions": "https://zenodo.org/api/records/23728687/communities-suggestions", "request_deletion": "https://zenodo.org/api/records/23728687/request-deletion", "file_modification": "https://zenodo.org/api/records/23728687/file-modification", "quota_increase": "https://zenodo.org/api/records/23728687/quota-increase", "requests": "https://zenodo.org/api/records/23728687/requests"}, "updated": "2026-10-28T11:29:39.141434+00:00", "recid": "23728687", "revision": 6, "files": [{"id": "a7ad2e42-08ee-4613-bf67-7f43b4396718", "key": "README.md", "size": 7699, "checksum": "md5:207af8860f8e0d7df37063b706f1e91b", "links": {"self": "https://zenodo.org/api/records/23728687/files/README.md/content"}}, {"id": "b77687c3-650a-4e3e-bb31-40324d37fd42", "key": "77_UltraHardDiscount_Action_replication_v2.zip", "size": 6320479, "checksum": "md5:4e8549b5e2d1a8f1e9c7e1c9bb9650b1", "links": {"self": "https://zenodo.org/api/records/23728687/files/77_UltraHardDiscount_Action_replication_v2.zip/content"}}], "swh": null, "owners": [{"id": "1590675"}], "status": "published", "stats": {"downloads": 21, "unique_downloads": 17, "views": 12, "unique_views": 11, "version_downloads": 2, "version_unique_downloads": 2, "version_unique_views": 2, "version_views": 2}, "state": "done", "submitted": true}, {"created": "2026-10-28T04:31:41.289612+00:00", "modified": "2026-10-28T04:31:41.434158+00:00", "id": 23719338, "conceptrecid": "23704036", "doi": "10.5281/zenodo.23719338", "conceptdoi": "10.5281/zenodo.23704036", "doi_url": "https://doi.org/10.5281/zenodo.23719338", "metadata": {"title": "Stata replication code and certified reference results for \"When Informality Stops Cushioning: Contact Shocks, Automation Exposure, and Worker Reallocation in Mexico\"", "doi": "10.5281/zenodo.23719338", "publication_date": "2026-10-28", "description": "<p>This repository provides a minimal Stata replication package supporting the manuscript &ldquo;When Informality Stops Cushioning: Contact Shocks, Automation Exposure, and Worker Reallocation in Mexico.&rdquo;</p>\n<p>The archive contains analytical code for the baseline formal&ndash;informal transition models, destination decomposition, and contact&ndash;automation extension; aggregate reference tables; the frozen twenty-sector automation exposure measure; and independently certified wild-cluster-bootstrap evidence.</p>\n<p>The joint COVID-period model yields a contact coefficient of 0.059665 under inverse-probability weighting (sector wild-bootstrap p = 0.002). The corresponding automation-susceptibility coefficient is &minus;0.009505 (p = 0.226). Survey-weighted results and all four sets of 499 bootstrap draws are included.</p>\n<p>The public files permit independent verification of the bootstrap results without rerunning regressions. The derived analytical cell datasets are excluded pending a separate disclosure assessment; consequently, the public package alone does not permit full independent re-estimation. The archive does not provide an end-to-end reconstruction from ENOE/ENOEN person-level microdata. Automation measures technical susceptibility, not observed technology adoption or a causal effect.</p>\n<p>Original ENOE/ENOEN data are disseminated by INEGI under its applicable terms of use. Analytical transformations and interpretations are the author's own and do not imply endorsement by INEGI.</p>", "access_right": "open", "creators": [{"name": "Ceballos Mina, Owen Eli", "affiliation": "Universidad Aut\u00f3