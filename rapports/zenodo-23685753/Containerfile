FROM docker.io/library/python:3.12-slim
# Versions du requirements.txt du paquet (readme.log), recopiées telles quelles ; evdspy et xlrd (scripts de téléchargement
# facultatifs, src/data/) non installés. Le canon a tourné sous Python 3.12.15 (environment_report.txt) ; l'image fournit le 3.12 courant.
# Réseau nécessaire à la construction seulement (PyPI) ; les exécutions restent --network none.
# libgomp1 (bibliothèque système OpenMP) : absente de l'image slim, exigée par lightgbm/xgboost (première construction : OSError libgomp.so.1).
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir numpy==2.5.3 pandas==3.0.6 scipy==1.18.1 scikit-learn==1.9.1 xgboost==3.4.1 lightgbm==4.7.0 shap==0.53.0 arch==8.0.0 pyyaml==6.0.3 "pytest>=8.0" matplotlib==3.11.2 requests==2.34.2 python-dotenv==1.2.4 openpyxl==3.1.5 lxml==6.1.3 statsmodels==0.15.0
