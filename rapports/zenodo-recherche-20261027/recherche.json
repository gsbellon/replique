on_downloads": 1, "version_unique_downloads": 1, "version_unique_views": 2, "version_views": 2}, "state": "done", "submitted": true}, {"created": "2026-10-23T12:13:21.972428+00:00", "modified": "2026-10-23T12:13:22.113121+00:00", "id": 23595707, "conceptrecid": "23480916", "doi": "10.5281/zenodo.23595707", "conceptdoi": "10.5281/zenodo.23480916", "doi_url": "https://doi.org/10.5281/zenodo.23595707", "metadata": {"title": "QSurvDiag replication package", "doi": "10.5281/zenodo.23595707", "publication_date": "2026-10-23", "description": "<p>Records and verification scripts for the article &ldquo;Why Quantum Mutants Survive: Separating Observation Limitations from Suite Omissions&rdquo;. Native QUTest and QuCheck executions are archived, not rerun; the scripts recompute every checked value from the archived records with the Python standard library, and an optional analytic tier recomputes the transpilation- and statevector-based values. The archive is mixed-license: provenance/LICENSE_MAP.csv assigns each file, and LICENSES/NOTICE.txt holds the third-party notices.</p>", "access_right": "open", "creators": [{"name": "Ye, Boshuai", "affiliation": null, "orcid": "0009-0000-3480-1234"}], "keywords": ["quantum software engineering; mutation testing; test oracle; replication package"], "dates": [{"type": "available"}], "language": "eng", "resource_type": {"title": "Software", "type": "software"}, "license": {"id": "cc-by-4.0"}, "relations": {"version": [{"index": 3, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "23480916"}}]}}, "title": "QSurvDiag replication package", "links": {"self": "https://zenodo.org/api/records/23595707", "self_html": "https://zenodo.org/records/23595707", "preview_html": "https://zenodo.org/records/23595707?preview=1", "doi": "https://doi.org/10.5281/zenodo.23595707", "self_doi": "https://doi.org/10.5281/zenodo.23595707", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23595707", "reserve_doi": "https://zenodo.org/api/records/23595707/draft/pids/doi", "parent": "https://zenodo.org/api/records/23480916", "parent_html": "https://zenodo.org/records/23480916", "parent_doi": "https://doi.org/10.5281/zenodo.23480916", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23480916", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:23595707/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:23595707/sequence/default", "files": "https://zenodo.org/api/records/23595707/files", "media_files": "https://zenodo.org/api/records/23595707/media-files", "latest": "https://zenodo.org/api/records/23595707/versions/latest", "latest_html": "https://zenodo.org/records/23595707/latest", "versions": "https://zenodo.org/api/records/23595707/versions", "draft": "https://zenodo.org/api/records/23595707/draft", "access_links": "https://zenodo.org/api/records/23595707/access/links", "access_grants": "https://zenodo.org/api/records/23595707/access/grants", "access_users": "https://zenodo.org/api/records/23595707/access/users", "access_request": "https://zenodo.org/api/records/23595707/access/request", "access": "https://zenodo.org/api/records/23595707/access", "communities": "https://zenodo.org/api/records/23595707/communities", "communities-suggestions": "https://zenodo.org/api/records/23595707/communities-suggestions", "request_deletion": "https://zenodo.org/api/records/23595707/request-deletion", "file_modification": "https://zenodo.org/api/records/23595707/file-modification", "quota_increase": "https://zenodo.org/api/records/23595707/quota-increase", "requests": "https://zenodo.org/api/records/23595707/requests"}, "updated": "2026-10-23T12:13:22.113121+00:00", "recid": "23595707", "revision": 4, "files": [{"id": "8ff03771-d155-4c3a-92c0-6316080298f0", "key": "qsurvdiag-replication-v1.3.0.zip", "size": 10865952, "checksum": "md5:017477a57e4cab4708d9bd02cf50ba99", "links": {"self": "https://zenodo.org/api/records/23595707/files/qsurvdiag-replication-v1.3.0.zip/content"}}], "swh": null, "owners": [{"id": "1223869"}], "status": "published", "stats": {"downloads": 7, "unique_downloads": 7, "views": 24, "unique_views": 18, "version_downloads": 1, "version_unique_downloads": 1, "version_unique_views": 4, "version_views": 4}, "state": "done", "submitted": true}, {"created": "2026-10-23T11:46:28.857942+00:00", "modified": "2026-10-23T11:46:29.122650+00:00", "id": 23590804, "conceptrecid": "23590803", "doi": "10.5281/zenodo.23590804", "conceptdoi": "10.5281/zenodo.23590803", "doi_url": "https://doi.org/10.5281/zenodo.23590804", "metadata": {"title": "How Much Do Patterns Help in Architecting Agentic AI Systems for Industrial Plants? \u2014 Replication Package", "doi": "10.5281/zenodo.23590804", "publication_date": "2026-10-23", "description": "<p>Replication package of the paper \"How Much Do Patterns Help in Architecting Agentic AI Systems for Industrial Plants?\" (submitted to the ICSE 2027 Software Engineering in Practice track).</p>\n<p>An agentic AI system (AAIS) controls two simulated industrial plants with an injected fault: FALCON, a four-tank batch mixing plant (OpenModelica), and the Tennessee Eastman Process (Fortran). Five agentic patterns (Plan &amp; Execute, Tree of Thought, ReAct, Sub-Agent Spawning, Debate) and the baseline are each run on four open-weight models (DeepSeek V4 Pro, GLM 5.1, Kimi K2.6, Gemma 4 31B), for 336 runs. Each pattern is compared with the baseline on six metrics for four ISO/IEC 25010 quality attributes.</p>\n<p>Contents:<br>- results/: all 336 runs, with the per-decision trace and the complete LLM call log of each run<br>- analysis/: the analysis that produces every number, table and figure of the paper (docker compose run --rm analysis, about a minute)<br>- falcon/, tep/: the plants, the runners and the code of every pattern<br>- website/: a static results website (open website/index.html); every run can be replayed decision by decision<br>- docs/: study design, architecture, patterns, metrics and replication instructions</p>\n<p>Start with README.md. The analysis needs only Docker; re-running the study needs an Ollama Cloud key.</p>", "access_right": "open", "creators": [{"name": "Sridhar, Chandrasekar", "affiliation": "International Institute of Information Technology, Hyderabad", "orcid": "0009-0009-3679-6331"}, {"name": "Muttannagaru, Pranav Reddy", "affiliation": "International Institute of Information Technology, Hyderabad", "orcid": "0009-0008-8464-4044"}, {"name": "Sharma, Divyasheel", "affiliation": "ABB Corporate Bengaluru", "orcid": "0000-0002-8479-8675"}, {"name": "K R, Chandrika", "affiliation": null, "orcid": "0000-0003-3032-3030"}, {"name": "Vaidhyanathan, Karthik", "affiliation": "International Institute of Information Technology, Hyderabad", "orcid": "0000-0003-2317-6175"}], "keywords": ["Agentic AI", "Agentic Patterns", "Software Architecture", "Software Engineering", "software quality", "ISO/IEC 25010", "industrial automation", "large language models", "Tennessee Eastman Process", "replication package"], "version": "1.0.0", "language": "eng", "custom": {"code:programmingLanguage": [{"id": "python", "title": {"en": "Python"}}, {"id": "fortran", "title": {"en": "Fortran"}}, {"id": "modelica", "title": {"en": "Modelica"}}], "code:developmentStatus": {"id": "inactive", "title": {"en": "Inactive"}}}, "resource_type": {"title": "Software", "type": "software"}, "license": {"id": "cc-by-4.0"}, "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "23590803"}}]}}, "title": "How Much Do Patterns Help in Architecting Agentic AI Systems for Industrial Plants? \u2014 Replication Package", "links": {"self": "https://zenodo.org/api/records/23590804", "self_html": "https://zenodo.org/records/23590804", "preview_html": "https://zenodo.org/records/23590804?preview=1", "doi": "https://doi.org/10.5281/zenodo.23590804", "self_doi": "https://doi.org/10.5281/zenodo.23590804", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23590804", "reserve_doi": "https://zenodo.org/api/records/23590804/draft/pids/doi", "parent": "https://zenodo.org/api/records/23590803", "parent_html": "https://zenodo.org/records/23590803", "parent_doi": "https://doi.org/10.5281/zenodo.23590803", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23590803", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:23590804/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:23590804/sequence/default", "files": "https://zenodo.org/api/records/23590804/files", "media_files": "https://zenodo.org/api/records/23590804/media-files", "latest": "https://zenodo.org/api/records/23590804/versions/latest", "latest_html": "https://zenodo.org/records/23590804/latest", "versions": "https://zenodo.org/api/records/23590804/versions", "draft": "https://zenodo.org/api/records/23590804/draft", "access_links": "https://zenodo.org/api/records/23590804/access/links", "access_grants": "https://zenodo.org/api/records/23590804/access/grants", "access_users": "https://zenodo.org/api/records/23590804/access/users", "access_request": "https://zenodo.org/api/records/23590804/access/request", "access": "https://zenodo.org/api/records/23590804/access", "communities": "https://zenodo.org/api/records/23590804/communities", "communities-suggestions": "https://zenodo.org/api/records/23590804/communities-suggestions", "request_deletion": "https://zenodo.org/api/records/23590804/request-deletion", "file_modification": "https://zenodo.org/api/records/23590804/file-modification", "quota_increase": "https://zenodo.org/api/records/23590804/quota-increase", "requests": "https://zenodo.org/api/records/23590804/requests"}, "updated": "2026-10-23T11:46:29.122650+00:00", "recid": "23590804", "revision": 4, "files": [{"id": "58a0622a-4be6-471e-a47a-3bbe94df64d7", "key": "replication-package.zip", "size": 36436602, "checksum": "md5:599df631f5ab02cd764e36e24b680a1a", "links": {"self": "https://zenodo.org/api/records/23590804/files/replication-package.zip/content"}}], "swh": null, "owners": [{"id": "1960741"}], "status": "published", "stats": {"downloads": 4, "unique_downloads": 2, "views": 7, "unique_views": 6, "version_downloads": 4, "version_unique_downloads": 2, "version_unique_views": 6, "version_views": 7}, "state": "done", "submitted": true}, {"created": "2026-10-23T08:52:44.655459+00:00", "modified": "2026-10-23T08:52:44.803517+00:00", "id": 23591167, "conceptrecid": "23591166", "doi": "10.5281/zenodo.23591167", "conceptdoi": "10.5281/zenodo.23591166", "doi_url": "https://doi.org/10.5281/zenodo.23591167", "metadata": {"title": "Terrain Matters: replication package", "doi": "10.5281/zenodo.23591167", "publication_date": "2026-10-23", "description": "<p>Code, data and outputs of the article <em>Terrain Matters: Does Planar Routing Mislead Energy-Optimal Design of Electric Fleets? Evidence from a Hilly Town</em> by Ahmet Ertu\u011frul Ar\u0131k and M. Ali \u00dclk\u00fc, prepared for <em>Logistics</em> (MDPI).</p><p>The study runs on the real road graph, stop register and operated lines of the minibus (dolmu\u015f) network of \u00dcrg\u00fcp, T\u00fcrkiye. The package holds the segment energy model, the OR-Tools route optimiser, the experiment runners, the inputs, the run outputs with their manifests, and the scripts that redraw every figure and table of the article. README.md explains how to rebuild the elevation grid and re-run the experiments, and SHA256SUMS checks every file.</p><p><strong>Licences.</strong> The licence field of this record refers to the code (MIT, see LICENSE). The road geometry is derived from OpenStreetMap and is available under the Open Database License 1.0 (LICENSE-ODbL), \u00a9 OpenStreetMap contributors, with additions from the Municipality of \u00dcrg\u00fcp. All other data, tables and figures are available under CC BY 4.0 (LICENSE-DATA). The elevation grids (Copernicus DEM GLO-30, ALOS AW3D30) are not redistributed; ATTRIBUTION.md lists the sources and the required notices.</p>", "access_right": "open", "creators": [{"name": "Ar\u0131k, Ahmet Ertu\u011frul", "affiliation": "Cappadocia University", "orcid": "0000-0002-7952-4311"}, {"name": "\u00dclk\u00fc, M. Ali", "affiliation": "Dalhousie University", "orcid": "0000-0002-8495-3364"}], "keywords": ["electric fleet routing", "road grade", "digital elevation model", "regenerative braking", "vehicle routing problem", "green logistics", "replication package"], "related_identifiers": [{"identifier": "https://github.com/elestirmen/terrain-matters/tree/v1.0.0", "relation": "isSupplementTo", "resource_type": "software", "scheme": "url"}], "version": "v1.0.0", "language": "eng", "custom": {"code:codeRepository": "https://github.com/elestirmen/terrain-matters"}, "resource_type": {"title": "Software", "type": "software"}, "license": {"id": "mit-license"}, "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "23591166"}}]}}, "title": "Terrain Matters: replication package", "links": {"self": "https://zenodo.org/api/records/23591167", "self_html": "https://zenodo.org/records/23591167", "preview_html": "https://zenodo.org/records/23591167?preview=1", "doi": "https://doi.org/10.5281/zenodo.23591167", "self_doi": "https://doi.org/10.5281/zenodo.23591167", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23591167", "reserve_doi": "https://zenodo.org/api/records/23591167/draft/pids/doi", "parent": "https://zenodo.org/api/records/23591166", "parent_html": "https://zenodo.org/records/23591166", "parent_doi": "https://doi.org/10.5281/zenodo.23591166", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23591166", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:23591167/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:23591167/sequence/default", "files": "https://zenodo.org/api/records/23591167/files", "media_files": "https://zenodo.org/api/records/23591167/media-files", "latest": "https://zenodo.org/api/records/23591167/versions/latest", "latest_html": "https://zenodo.org/records/23591167/latest", "versions": "https://zenodo.org/api/records/23591167/versions", "draft": "https://zenodo.org/api/records/23591167/draft", "access_links": "https://zenodo.org/api/records/23591167/access/links", "access_grants": "https://zenodo.org/api/records/23591167/access/grants", "access_users": "https://zenodo.org/api/records/23591167/access/users", "access_request": "https://zenodo.org/api/records/23591167/access/request", "access": "https://zenodo.org/api/records/23591167/access", "communities": "https://zenodo.org/api/records/23591167/communities", "communities-suggestions": "https://zenodo.org/api/records/23591167/communities-suggestions", "request_deletion": "https://zenodo.org/api/records/23591167/request-deletion", "file_modification": "https://zenodo.org/api/records/23591167/file-modification", "quota_increase": "https://zenodo.org/api/records/23591167/quota-increase", "requests": "https://zenodo.org/api/records/23591167/requests"}, "updated": "2026-10-23T08:52:44.803517+00:00", "recid": "23591167", "revision": 4, "files": [{"id": "33ae2e88-5761-4169-92c8-161ce0e107bb", "key": "elestirmen/terrain-matters-v1.0.0.zip", "size": 24768864, "checksum": "md5:e9ced4afa814eb640d6e1307b3c20c01", "links": {"self": "https://zenodo.org/api/records/23591167/files/elestirmen/terrain-matters-v1.0.0.zip/content"}}], "swh": null, "owners": [{"id": "1250638"}], "status": "published", "stats": {"downloads": 1, "unique_downloads": 1, "views": 10, "unique_views": 10, "version_downloads": 1, "version_unique_downloads": 1, "version_unique_views": 10, "version_views": 10}, "state": "done", "submitted": true}, {"created": "2026-10-23T04:49:48.846534+00:00", "modified": "2026-10-23T04:49:49.014214+00:00", "id": 23586222, "conceptrecid": "23586221", "doi": "10.5281/zenodo.23586222", "conceptdoi": "10.5281/zenodo.23586221", "doi_url": "https://doi.org/10.5281/zenodo.23586222", "metadata": {"title": "Licensed Assistance: Earning, Keeping, and Regaining the Right to Hand a Skill to Generative AI \u2014 Replication package", "doi": "10.5281/zenodo.23586222", "publication_date": "2026-10-23", "description": "<p>Replication code, meta-analysis extraction and coding records, derived aggregate results, and figures accompanying Licensed Assistance: Earning, Keeping, and Regaining the Right to Hand a Skill to Generative AI, version 8. The manuscript develops a per-skill institutional license for AI assistance based on unaided attestation, a separate error-detection condition, expiry and renewal with a decay margin, and attempt-first correction. Four empirical studies examine its premises, and a seeded population simulation examines renewal under stated design assumptions. The archive contains no raw learner-level records. Provider-restricted source data and publisher full texts are not redistributed; the README and accompanying appendix identify their sources and applicable restrictions. Empirical associations, randomized within-assignment comparisons, and simulated licensing outcomes are distinct; propositions concerning the corrective pathway and error-detection condition are not tested. The package is not evidence of journal acceptance or a guarantee of general causal effectiveness.</p>\n<p>&nbsp;</p>\n<p>The original v8 ZIP is preserved byte-for-byte. Accompanying portability notes distinguish runnable supplied-data stages from analyses requiring independently obtained provider data and document appendix-generation limitations. No additional licence grant for author-created materials is asserted; third-party rights and provider restrictions remain unchanged.</p>", "access_right": "open", "creators": [{"name": "Wright, Craig S.", "affiliation": "University of Exeter", "orcid": "0000-0001-9374-0507"}], "version": "8", "resource_type": {"title": "Software", "type": "software"}, "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "23586221"}}]}}, "title": "Licensed Assistance: Earning, Keeping, and Regaining the Right to Hand a Skill to Generative AI \u2014 Replication package", "links": {"self": "https://zenodo.org/api/records/23586222", "self_html": "https://zenodo.org/records/23586222", "preview_html": "https://zenodo.org/records/23586222?preview=1", "doi": "https://doi.org/10.5281/zenodo.23586222", "self_doi": "https://doi.org/10.5281/zenodo.23586222", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23586222", "reserve_doi": "https://zenodo.org/api/records/23586222/draft/pids/doi", "parent": "https://zenodo.org/api/records/23586221", "parent_html": "https://zenodo.org/records/23586221", "parent_doi": "https://doi.org/10.5281/zenodo.23586221", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23586221", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:23586222/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:23586222/sequence/default", "files": "https://zenodo.org/api/records/23586222/files", "media_files": "https://zenodo.org/api/records/23586222/media-files", "latest": "https://zenodo.org/api/records/23586222/versions/latest", "latest_html": "https://zenodo.org/records/23586222/latest", "versions": "https://zenodo.org/api/records/23586222/versions", "draft": "https://zenodo.org/api/records/23586222/draft", "access_links": "https://zenodo.org/api/records/23586222/access/links", "access_grants": "https://zenodo.org/api/records/23586222/access/grants", "access_users": "https://zenodo.org/api/records/23586222/access/users", "access_request": "https://zenodo.org/api/records/23586222/access/request", "access": "https://zenodo.org/api/records/23586222/access", "communities": "https://zenodo.org/api/records/23586222/communities", "communities-suggestions": "https://zenodo.org/api/records/23586222/communities-suggestions", "request_deletion": "https://zenodo.org/api/records/23586222/request-deletion", "file_modification": "https://zenodo.org/api/records/23586222/file-modification", "quota_increase": "https://zenodo.org/api/records/23586222/quota-increase", "requests": "https://zenodo.org/api/records/23586222/requests"}, "updated": "2026-10-23T04:49:49.014214+00:00", "recid": "23586222", "revision": 4, "files": [{"id": "0f7d6702-3001-47c0-8ece-7edd023b2501", "key": "AMLE_Replication_v8_portability_notes_20261023.zip", "size": 12245, "checksum": "md5:5eecac4a4bd017ae77e045cc2ded41c6", "links": {"self": "https://zenodo.org/api/records/23586222/files/AMLE_Replication_v8_portability_notes_20261023.zip/content"}}, {"id": "b025feec-f69e-45f3-b1e6-f2365edad1ba", "key": "AMLE_Replication_v8.zip", "size": 3302264, "checksum": "md5:c78610f6d0930c88bca2969d50fcad53", "links": {"self": "https://zenodo.org/api/records/23586222/files/AMLE_Replication_v8.zip/content"}}], "swh": null, "owners": [{"id": "1549985"}], "status": "published", "stats": {"downloads": 6, "unique_downloads": 4, "views": 7, "unique_views": 6, "version_downloads": 6, "version_unique_downloads": 4, "version_unique_views": 6, "version_views": 7}, "state": "done", "submitted": true}, {"created": "2026-10-23T04:39:32.125922+00:00", "modified": "2026-10-23T04:39:32.434912+00:00", "id": 23585999, "conceptrecid": "23558752", "doi": "10.5281/zenodo.23585999", "conceptdoi": "10.5281/zenodo.23558752", "doi_url": "https://doi.org/10.5281/zenodo.23585999", "metadata": {"title": "Replication package: AI Income Rights and the Identification of Declining Work", "doi": "10.5281/zenodo.23585999", "publication_date": "2026-10-23", "description": "<p>I provide the complete offline replication materials accompanying manuscript v0024 of AI Income Rights and the Identification of Declining Work. This version adds the flagship joint-information figure and its reproducible plotting code and data while retaining the existing scientific results.</p>\n<p>&nbsp;</p>\n<p>The package includes constructed model experiments, interval certificates, numerical checks, figures, and public 2022/2025 Survey of Consumer Finances inputs with replicate-weight descriptive uncertainty calculations. All 39 programs were run and the five raw-input hashes verified before release. Constructed experiments are not empirical calibration; the SCF results do not estimate an AI effect or establish structural validity.</p>\n<p>&nbsp;</p>\n<p>Download all three numbered ZIP files and extract them into the same empty folder. Together they reconstruct the complete 222-file distribution. The separately named complete ZIP in ARTIFACT_HASHES.json is an equivalent local packaging alternative, not an additional required download here. DOWNLOAD_AND_EXTRACT.txt provides the commands. Federal Reserve provenance and rights are retained, and no additional licence grant for author-created material is asserted. SHA256_MANIFEST.json within the scientific archive identifies the exact distribution bytes.</p>", "access_right": "open", "creators": [{"name": "Wright, Craig Steven", "affiliation": "University of Exeter", "orcid": "0000-0001-9374-0507"}], "version": "v0024", "resource_type": {"title": "Software", "type": "software"}, "relations": {"version": [{"index": 1, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "23558752"}}]}}, "title": "Replication package: AI Income Rights and the Identification of Declining Work", "links": {"self": "https://zenodo.org/api/records/23585999", "self_html": "https://zenodo.org/records/23585999", "preview_html": "https://zenodo.org/records/23585999?preview=1", "doi": "https://doi.org/10.5281/zenodo.23585999", "self_doi": "https://doi.org/10.5281/zenodo.23585999", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23585999", "reserve_doi": "https://zenodo.org/api/records/23585999/draft/pids/doi", "parent": "https://zenodo.org/api/records/23558752", "parent_html": "https://zenodo.org/records/23558752", "parent_doi": "https://doi.org/10.5281/zenodo.23558752", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23558752", "self_iiif_m