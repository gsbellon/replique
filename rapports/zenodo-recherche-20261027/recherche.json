cords/23598169", "parent_doi": "https://doi.org/10.5281/zenodo.23598169", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23598169", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:23598170/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:23598170/sequence/default", "files": "https://zenodo.org/api/records/23598170/files", "media_files": "https://zenodo.org/api/records/23598170/media-files", "latest": "https://zenodo.org/api/records/23598170/versions/latest", "latest_html": "https://zenodo.org/records/23598170/latest", "versions": "https://zenodo.org/api/records/23598170/versions", "draft": "https://zenodo.org/api/records/23598170/draft", "access_links": "https://zenodo.org/api/records/23598170/access/links", "access_grants": "https://zenodo.org/api/records/23598170/access/grants", "access_users": "https://zenodo.org/api/records/23598170/access/users", "access_request": "https://zenodo.org/api/records/23598170/access/request", "access": "https://zenodo.org/api/records/23598170/access", "communities": "https://zenodo.org/api/records/23598170/communities", "communities-suggestions": "https://zenodo.org/api/records/23598170/communities-suggestions", "request_deletion": "https://zenodo.org/api/records/23598170/request-deletion", "file_modification": "https://zenodo.org/api/records/23598170/file-modification", "quota_increase": "https://zenodo.org/api/records/23598170/quota-increase", "requests": "https://zenodo.org/api/records/23598170/requests"}, "updated": "2026-10-23T13:49:49.386980+00:00", "recid": "23598170", "revision": 4, "files": [{"id": "fa234eef-69ba-41be-9f2e-48ac6165f6bf", "key": "Sadra-Emami/green_code_or_costly_code-v1.0.0.zip", "size": 58754514, "checksum": "md5:20572bca307036ca586fbb42f243e727", "links": {"self": "https://zenodo.org/api/records/23598170/files/Sadra-Emami/green_code_or_costly_code-v1.0.0.zip/content"}}], "swh": null, "owners": [{"id": "1961238"}], "status": "published", "stats": {"downloads": 1, "unique_downloads": 1, "views": 48, "unique_views": 36, "version_downloads": 1, "version_unique_downloads": 1, "version_unique_views": 36, "version_views": 48}, "state": "done", "submitted": true}, {"created": "2026-10-23T13:03:18.758931+00:00", "modified": "2026-10-23T13:03:18.957099+00:00", "id": 23597057, "conceptrecid": "23597056", "doi": "10.5281/zenodo.23597057", "conceptdoi": "10.5281/zenodo.23597056", "doi_url": "https://doi.org/10.5281/zenodo.23597057", "metadata": {"title": "Replication package: Perceived employer care and quit intentions across European sectors (EWCS 2024).", "doi": "10.5281/zenodo.23597057", "publication_date": "2026-10-23", "description": "<p>Replication package for the article \"Perceived employer care and quit intentions across European sectors: evidence from the 2024 European Working Conditions Survey\" (Personnel Review).</p>\n<p>The package contains the code (R, Python and Stata) used to produce all estimates, tables and figures reported in the article, and a derived dataset of country-by-NACE-section labour market indicators for 2024 built from open European Commission (DG ECFIN Business and Consumer Surveys) and Eurostat (jvs_a_rate_r2, lfsa_egdn2) data.</p>\n<p>EWCS 2024 microdata are not included. They are available to registered users from the UK Data Service (Eurofound, European Working Conditions Survey, 2024, SN 9511, doi:10.5255/UKDA-SN-9511-1) under the End User Licence. README.md describes where to place the data files and the order in which to run the scripts.</p>\n<p>Contents: code/R (design-based estimates with the survey package, independent replication with cluster-robust inference, KHB mediation with country-cluster bootstrap, multilevel model, Oster bounds, random-effects meta-analysis, sensitivity analyses for the sector contrast); code/python (first implementation with statsmodels and construction of the external indicators); code/stata (the same specifications for Stata 18 and a cross-check script); code/figures (Figures 1-3 and table documents); data_external/ext_country_section_2024.csv.</p>\n<p>Licence: code MIT; derived external indicators CC BY 4.0 (sources: European Commission, Eurostat).</p>", "access_right": "open", "creators": [{"name": "Bondarenko, Svitlana", "affiliation": "Kyiv National Economic University named after Vadym Hetman", "orcid": "0000-0002-1687-1172"}, {"name": "Kozak, Petro", "affiliation": "Lutsk National Technical University", "orcid": "0009-0005-6973-3979"}, {"name": "Kryvtsova, Marina", "affiliation": "Odessa national economic university", "orcid": "0000-0001-6069-9691"}, {"name": "Balinska, IzabelaDorota", "affiliation": "University of Internal Security in \u0141\u00f3d\u017a", "orcid": "0000-0002-0417-4126"}, {"name": "Gamova, Iryna", "affiliation": "State University of Trade and Economics", "orcid": "0000-0002-2032-8578"}, {"name": "Kazarian, Henrikh", "affiliation": "Interregional Academy of Personnel Management", "orcid": "0000-0002-9139-9461"}], "keywords": ["employee retention; turnover intention; perceived organizational support; European Working Conditions Survey; replication"], "version": "1.0.0", "language": "eng", "resource_type": {"title": "Software", "type": "software"}, "license": {"id": "cc-by-4.0"}, "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "23597056"}}]}}, "title": "Replication package: Perceived employer care and quit intentions across European sectors (EWCS 2024).", "links": {"self": "https://zenodo.org/api/records/23597057", "self_html": "https://zenodo.org/records/23597057", "preview_html": "https://zenodo.org/records/23597057?preview=1", "doi": "https://doi.org/10.5281/zenodo.23597057", "self_doi": "https://doi.org/10.5281/zenodo.23597057", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23597057", "reserve_doi": "https://zenodo.org/api/records/23597057/draft/pids/doi", "parent": "https://zenodo.org/api/records/23597056", "parent_html": "https://zenodo.org/