letion", "file_modification": "https://zenodo.org/api/records/23541830/file-modification", "quota_increase": "https://zenodo.org/api/records/23541830/quota-increase", "requests": "https://zenodo.org/api/records/23541830/requests"}, "updated": "2026-10-23T14:45:36.841279+00:00", "recid": "23541830", "revision": 4, "files": [{"id": "b2849776-7e97-486e-b714-e71353d291d5", "key": "reviewerlens_replication.zip", "size": 439607413, "checksum": "md5:e81981b49957ea9508a2b57110c20bff", "links": {"self": "https://zenodo.org/api/records/23541830/files/reviewerlens_replication.zip/content"}}], "swh": null, "owners": [{"id": "1045822"}], "status": "published", "stats": {"downloads": 1, "unique_downloads": 1, "views": 11, "unique_views": 6, "version_downloads": 1, "version_unique_downloads": 1, "version_unique_views": 6, "version_views": 11}, "state": "done", "submitted": true}, {"created": "2026-10-23T13:49:49.250140+00:00", "modified": "2026-10-23T13:49:49.386980+00:00", "id": 23598170, "conceptrecid": "23598169", "doi": "10.5281/zenodo.23598170", "conceptdoi": "10.5281/zenodo.23598169", "doi_url": "https://doi.org/10.5281/zenodo.23598170", "metadata": {"title": "Replication package for: Green Code or Costly Code? Evaluating the Energy Costs of Iterative LLM-Based Code Optimizations", "doi": "10.5281/zenodo.23598170", "publication_date": "2026-10-23", "description": "Replication package for a study of the energy cost of iterative LLM based code optimization. Using the EffiLearner self refinement pipeline, 11 open source models and four decoding configurations were evaluated on all 1000 EffiBench problems, with hardware level energy measurements for both inference and execution. The optimized code is compared with canonical human reference solutions, and break even points are computed for the energy spent on generation. In 42 of 44 configurations the optimized code uses more execution energy than the human reference.", "access_right": "open", "creators": [{"name": "Emami, Sadra"