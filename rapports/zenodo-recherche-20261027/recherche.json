23624408/communities", "communities-suggestions": "https://zenodo.org/api/records/23624408/communities-suggestions", "request_deletion": "https://zenodo.org/api/records/23624408/request-deletion", "file_modification": "https://zenodo.org/api/records/23624408/file-modification", "quota_increase": "https://zenodo.org/api/records/23624408/quota-increase", "requests": "https://zenodo.org/api/records/23624408/requests"}, "updated": "2026-10-24T18:57:36.546804+00:00", "recid": "23624408", "revision": 4, "files": [{"id": "9fd344d8-bb35-4dfd-8d01-91411c180f71", "key": "DEA-MP-H_v1.1.0_artigo_v11.zip", "size": 121764, "checksum": "md5:f9755f3b9de2fa4fc2346ebeb3257be1", "links": {"self": "https://zenodo.org/api/records/23624408/files/DEA-MP-H_v1.1.0_artigo_v11.zip/content"}}], "swh": null, "owners": [{"id": "1669653"}], "status": "published", "stats": {"downloads": 1, "unique_downloads": 1, "views": 9, "unique_views": 8, "version_downloads": 1, "version_unique_downloads": 1, "version_unique_views": 8, "version_views": 9}, "state": "done", "submitted": true}, {"created": "2026-10-24T16:48:57.849631+00:00", "modified": "2026-10-24T16:49:39.972040+00:00", "id": 23622666, "conceptrecid": "23622665", "doi": "10.5281/zenodo.23622666", "conceptdoi": "10.5281/zenodo.23622665", "doi_url": "https://doi.org/10.5281/zenodo.23622666", "metadata": {"title": "Replication package for: Software issue triage without the ticket text: what metadata delivers, what local language models recover, and what masking costs", "doi": "10.5281/zenodo.23622666", "publication_date": "2026-10-24", "description": "<div>\n<div>Code, configuration, pre-registered protocol, prompts, harmonisation maps and aggregate results for a two-sided&nbsp;study of automated software issue triage without ticket text: the value of text over creation-time metadata on eight&nbsp;open-source software projects' public Jira trackers (term-frequency and fine-tuned transformer models, locally run open-weight language models&nbsp;of 9 and 27 billion parameters), metadata-only triage on the de-identified issue tracker of an industrial software&nbsp;organisation, the agreement of the metadata signal across trackers, and the accuracy cost of entity masking.&nbsp;Every number, table and figure in the accompanying article is traced to a file in `results/`. The industrial&nbsp;records are confidential and not included; the public issues are available from the Public Jira Dataset under&nbsp;its licence. Code: Apache License 2.0. Documents, tables and figures: CC BY 4.0.</div>\n</div>", "access_right": "open", "creators": [{"name": "Nuviadenu, Johnson", "affiliation": "University of South Africa", "orcid": "0009-0002-2994-8797"}, {"name": "Masombuka, Themba", "affiliation": "University of South Africa", "orcid": "0000-0002-8855-2445"}, {"name": "Mnkandla, Ernest", "affiliation": "University of South Africa", "orcid": "0000-0003-3989-5617"}, {"name": "Sibiya, Malusi", "affiliation": "University of South Africa", "orcid": "0000-0001-5617-768X"}], "keywords": ["software engineering", "issue triage", "priority prediction", "bug assignment", "data privacy", "large language models", "survival   analysis", "industrial case study"], "dates": [{"type": "available"}], "language": "eng", "resource_type": {"title": "Software", "type": "software"}, "license": {"id": "cc-by-4.0"}, "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "23622665"}}]}}, "title": "Replication package for: Software issue triage without the ticket text: what metadata delivers, what local language models recover, and what masking costs", "links": {"self": "https://zenodo.org/api/records/23622666", "self_html": "https://zenodo.org/records/23622666", "preview_html": "https://zenodo.org/records/23622666?preview=1", "doi": "https://doi.org/10.5281/zenodo.23622666", "self_doi": "https://doi.org/10.5281/zenodo.23622666", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23622666", "reserve_doi": "https://zenodo.org/api/records/23622666/draft/pids/doi", "parent": "https://zenodo.org/api/records/23622665", "parent_html": "https://zenodo.org/records/23622665", "parent_doi": "https://doi.org/10.5281/zenodo.23622665", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23622665", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:23622666/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:23622666/sequence/default", "files": "https://zenodo.org/api/records/23622666/files", "media_files": "https://zenodo.org/api/records/23622666/media-files", "latest": "https://zenodo.org/api/records/23622666/versions/latest", "latest_html": "https://zenodo.org/records/23622666/latest", "versions": "https://zenodo.org/api/records/23622666/versions", "draft": "https://zenodo.org/api/records/23622666/draft", "access_links": "https://zenodo.org/api/records/23622666/access/links", "access_grants": "https://zenodo.org/api/records/23622666/access/grants", "access_users": "https://zenodo.org/api/records/23622666/access/users", "access_request": "https://zenodo.org/api/records/23622666/access/request", "access": "https://zenodo.org/api/records/23622666/access", "communities": "https://zenodo.org/api/records/23622666/communities", "communities-suggestions": "https://zenodo.org/api/records/23622666/communities-suggestions", "request_deletion": "https://zenodo.org/api/records/23622666/request-deletion", "file_modification": "https://zenodo.org/api/records/23622666/file-modification", "quota_increase": "https://zenodo.org/api/records/23622666/quota-increase", "requests": "https://zenodo.org/api/records/23622666/requests"}, "updated": "2026-10-24T16:49:39.972040+00:00", "recid": "23622666", "revision": 6, "files": [{"id": "654bdfd1-d95c-4fe4-85d4-6b538c8605c4", "key": "replication_package_v1.0.0.zip", "size": 45317786, "checksum": "md5:e3e9d86ec10fd2557c059c9a876b2f27", "links": {"self": "https://zenodo.org/api/records/23622666/files/replication_package_v1.0.0.zip/content"}}], "swh": null, "owners": [{"id": "1535914"}], "status": "published", "stats": {"downloads": 2, "unique_downloads": 2, "views": 6, "unique_views": 5, "version_downloads": 2, "version_unique_downloads": 2, "version_unique_views": 5, "version_views": 6}, "state": "done", "submitted": true}, {"created": "2026-10-24T14:18:28.676365+00:00", "modified": "2026-10-24T14:18:28.785490+00:00", "id": 23619914, "conceptrecid": "23601278", "doi": "10.5281/zenodo.23619914", "conceptdoi": "10.5281/zenodo.23601278", "doi_url": "https://doi.org/10.5281/zenodo.23619914", "metadata": {"title": "FAST: Fair Assessment of Student\u2013Teacher Distillation for Issue Classification", "doi": "10.5281/zenodo.23619914", "publication_date": "2026-10-24", "description": "<h2>FAST: replication package</h2>\n<p>Code, data, teacher models and results for <em>FAST</em> . The study distils released DistilRoBERTa issue classifiers (teachers) into cheaper students: a TF-IDF SVM, a DAN, CatBoost, fastText, and fine-tuned MiniLM.</p>\n<h3>Contents</h3>\n<table>\n<tbody>\n<tr>\n<th>Path</th>\n<th>What</th>\n</tr>\n</tbody>\n<tbody>\n<tr>\n<td><code>scripts/r12.py</code></td>\n<td>Drives the whole study: <code>data</code>, <code>rq</code>, <code>search</code>, <code>explore</code>, <code>design</code>, <code>report</code></td>\n</tr>\n<tr>\n<td><code>scripts/r12_revision.py</code></td>\n<td>Extra analyses: fastText, label channels, teacher&ndash;gold agreement, OOD saliency sweep, substring relabelling, energy calibration, ONNX serving</td>\n</tr>\n<tr>\n<td><code>scripts/r12_report.py</code>, <code>scripts/r12_paper_tables.py</code></td>\n<td>Result tables (<code>results/r12_spark/report/</code>) and LaTeX tables (<code>paper/</code>)</td>\n</tr>\n<tr>\n<td><code>scripts/r12_qualitative.py</code></td>\n<td>Samples items for human annotation and scores the returned sheets</td>\n</tr>\n<tr>\n<td><code>scripts/build_fresh_testset.py</code></td>\n<td>Builds the post-cutoff (temporal) test set; its cleaning rules are reused by <code>r12.py</code></td>\n</tr>\n<tr>\n<td><code>src/fast/</code>, <code>configs/</code>, <code>tests/</code></td>\n<td>Library code, hyperparameters, unit tests</td>\n</tr>\n<tr>\n<td><code>models/binary_classification_train_*</code></td>\n<td>The 9 teacher heads (7 quality attributes, TD, test debt)</td>\n</tr>\n<tr>\n<td><code>cache/frames/</code>, <code>cache/onnx/</code></td>\n<td>Raw labelled issue corpora; ONNX exports of the two heads released without one</td>\n</tr>\n<tr>\n<td><code>data/fresh/</code></td>\n<td>Post-cutoff GitHub issues (2024-11 to 2026-09), the temporal OOD set</td>\n</tr>\n<tr>\n<td><code>results/r12_spark/</code></td>\n<td>All outputs: cleaned splits and OOD sets (<code>data/</code>), RQ1&ndash;RQ4 (<code>rq/</code>), RQ2b (<code>rq2b/</code>), students &times; signals (<code>explore/</code>), serving design (<code>design/</code>), revision analyses (<code>revision/</code>), tables (<code>report/</code>), hardware (<code>ENV.json</code>)</td>\n</tr>\n<tr>\n<td><code>Qualitative-annotations/</code></td>\n<td>Human annotation sheets from three annotators (see below)</td>\n</tr>\n</tbody>\n</table>\n<h3>Where each research question comes from</h3>\n<table>\n<tbody>\n<tr>\n<th>RQ</th>\n<th>Stage</th>\n<th>Output</th>\n</tr>\n</tbody>\n<tbody>\n<tr>\n<td><strong>RQ1</strong> &ndash; Teacher vs. students, in and out of distribution</td>\n<td><code>r12.py rq</code>, <code>explore</code></td>\n<td><code>rq/</code>, <code>explore/</code>, <code>report/summary_vs_teacher.csv</code></td>\n</tr>\n<tr>\n<td><strong>RQ2</strong> &ndash; Which teacher signals help which students (vs. placebos)</td>\n<td><code>r12.py rq</code>, <code>search</code>, <code>explore</code>; <code>r12_revision.py sweep_ood</code></td>\n<td><code>rq2b/</code>, <code>report/signals.csv</code>, <code>revision/sweep_ood/</code></td>\n</tr>\n<tr>\n<td><strong>RQ3</strong> &ndash; Teacher as annotator</td>\n<td><code>r12_revision.py channels</code>, <code>agree</code></td>\n<td><code>revision/channels/</code>, <code>revision/agree/</code></td>\n</tr>\n<tr>\n<td><strong>RQ4</strong> &ndash; Serving cost, break-even, best config per latency budget</td>\n<td><code>r12.py design</code>, <code>report</code>; <code>r12_revision.py calib</code>, <code>onnx</code></td>\n<td><code>design/</code>, <code>report/cost.csv</code>, <code>report/design_*.csv</code></td>\n</tr>\n</tbody>\n</table>\n<h3>Reproduce</h3>\n<p>Run from this directory (teacher paths are relative to it).</p>\n<pre><code>python3 -m venv .venv &amp;&amp; . .venv/bin/activate\npip install -r requirements.txt\nmake test PY=python                      # offline unit tests\n\nexport R12_ALLOW_ANY_HOST=1              # the driver otherwise insists on the GB10 it ran on\nexport FAST_TRUST_UNSIGNED_CACHE=1       # accept the shipped extraction pickles\nmake r12 PY=python                       # main study\nmake revision PY=python                  # extra analyses (run energy stages on an idle GPU)\nmake tables PY=python                    # LaTeX tables -&gt; paper/paper_r12/tables</code></pre>\n<p><strong>Notes</strong></p>\n<ul>\n<li>Stages skip outputs that already exist. To rerun one, move its directory under <code>results/r12_spark/</code> aside.</li>\n<li>Extraction pickles are HMAC-signed with a per-machine key that is not shipped, hence <code>FAST_TRUST_UNSIGNED_CACHE=1</code>. Unpickling runs code, so set it only for files from this archive; otherwise delete <code>results/r12_spark/data/extract/</code> and the teachers re-extract (GPU recommended).</li>\n<li><code>sentence-transformers/all-MiniLM-L6-v2</code>, <code>-L12-v2</code> and the <code>distilroberta-base</code> tokenizer download from Hugging Face on first use.</li>\n<li>Teachers load with <code>attn_implementation=\"eager\"</code>; SDPA/flash kernels return no attention.</li>\n<li>Seeds 13, 17, 19. Latency and energy depend on hardware: the original run used an NVIDIA DGX Spark (GB10, 20-core Arm), see <code>results/r12_spark/ENV.json</code>.</li>\n</ul>\n<h3>Qualitative annotations</h3>\n<p><code>Qualitative-annotations/annotator_{A,B,C}.csv</code> hold the returned human annotation sheets. Each annotator labelled 60 issues (<code>item_id</code> <code>TS-NNNN</code>); 20 items are shared by all three (inter-annotator agreement), the other 40 per sheet are unique, 140 issues in total.</p>\n<p>Every item is a disagreement: two models, blinded as A and B, tag the same quality attribute, one as <code>&lt;attribute&gt;</code> and the other as <code>NOT &lt;attribute&gt;</code>. Model identities and annotators are anonymised; the A/B keys will be released on publication.</p>\n<table>\n<tbody>\n<tr>\n<th>Column</th>\n<th>Meaning</th>\n</tr>\n</tbody>\n<tbody>\n<tr>\n<td><code>item_id</code></td>\n<td>Pseudonymous item ID</td>\n</tr>\n<tr>\n<td><code>issue</code></td>\n<td>Issue title and body, as shown to the annotator</td>\n</tr>\n<tr>\n<td><code>model_A_tag</code>, <code>model_B_tag</code></td>\n<td>The two blinded model predictions</td>\n</tr>\n<tr>\n<td><code>your_label</code></td>\n<td>Annotator's own quality attribute (free text; <code>none</code>/<code>unusable</code> when no attribute applies)</td>\n</tr>\n<tr>\n<td><code>your_label_confidence (1-5)</code></td>\n<td>Annotator's confidence in <code>your_label</code></td>\n</tr>\n<tr>\n<td><code>A_correct (yes/no)</code>, <code>B_correct (yes/no)</code></td>\n<td>Whether each model's tag is right</td>\n</tr>\n</tbody>\n</table>\n<p><code>annotator_A.csv</code> is <code>;</code>-separated, B and C are <code>,</code>-separated with a UTF-8 BOM. A few rows are left blank (8, 2 and 6 in A, B, C). The labels are kept as returned, spelling included.</p>\n<h3>Anonymisation</h3>\n<p>Identifying Hugging Face IDs were rewritten: teachers point to the bundled <code>models/</code>, datasets read <code>anonymous/...</code> (never fetched, the corpora ship in <code>cache/frames/</code>). Host names and local paths are scrubbed, and the code no longer records host names, git commits or local time zones. Original IDs will be restored on publication.</p>\n<p><strong>Release.</strong> This package is shared for review only. The full, de-anonymised replication package will be released publicly after the review.</p>", "access_right": "open", "creators": [{"name": "anon", "affiliation": null}], "resource_type": {"title": "Software", "type": "software"}, "license": {"id": "cc-by-4.0"}, "relations": {"version": [{"index": 1, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "23601278"}}]}}, "title": "FAST: Fair Assessment of Student\u2013Teacher Distillation for Issue Classification", "links": {"self": "https://zenodo.org/api/records/23619914", "self_html": "https://zenodo.org/records/23619914", "preview_html": "https://zenodo.org/records/23619914?preview=1", "doi": "https://doi.org/10.5281/zenodo.23619914", "self_doi": "https://doi.org/10.5281/zenodo.23619914", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23619914", "reserve_doi": "https://zenodo.org/api/records/23619914/draft/pids/doi", "parent": "https://zenodo.org/api/records/23601278", "parent_html": "https://zenodo.org/records/23601278", "parent_doi": "https://doi.org/10.5281/zenodo.23601278", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23601278", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:23619914/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:23619914/sequence/default", "files": "https://zenodo.org/api/records/23619914/files", "media_files": "https://zenodo.org/api/records/23619914/media-files", "latest": "https://zenodo.org/api/records/23619914/versions/latest", "latest_html": "https://zenodo.org/records/23619914/latest", "versions": "https://zenodo.org/api/records/23619914/versions", "draft": "https://zenodo.org/api/records/23619914/draft", "access_links": "https://zenodo.org/api/records/23619914/access/links", "access_grants": "https://zenodo.org/api/records/23619914/access/grants", "access_users": "https://zenodo.org/api/records/23619914/access/users", "access_request": "https://zenodo.org/api/records/23619914/access/request", "access": "https://zenodo.org/api/records/23619914/access", "communities": "https://zenodo.org/api/records/23619914/communities", "communities-suggestions": "https://zenodo.org/api/records/23619914/communities-suggestions", "request_deletion": "https://zenodo.org/api/records/23619914/request-deletion", "file_modification": "https://zenodo.org/api/records/23619914/file-modification", "quota_increase": "https://zenodo.org/api/records/23619914/quota-increase", "requests": "https://zenodo.org/api/records/23619914/requests"}, "updated": "2026-10-24T14:18:28.785490+00:00", "recid": "23619914", "revision": 4, "files": [{"id": "d5b4907f-05bf-4817-8ad6-09a20c211d39", "key": "FAST-replication.zip", "size": 7456629377, "checksum": "md5:f492eb893ff6deb4fe4b3463a90463cc", "links": {"self": "https://zenodo.org/api/records/23619914/files/FAST-replication.zip/content"}}], "swh": null, "owners": [{"id": "328280"}], "status": "published", "stats": {"downloads": 0, "unique_downloads": 0, "views": 15, "unique_views": 12, "version_downloads": 0, "version_unique_downloads": 0, "version_unique_views": 6, "version_views": 7}, "state": "done", "submitted": true}, {"created": "2026-10-24T14:01:03.848788+00:00", "modified": "2026-10-24T14:01:04.012936+00:00", "id": 23619187, "conceptrecid": "23619186", "doi": "10.5281/zenodo.23619187", "conceptdoi": "10.5281/zenodo.23619186", "doi_url": "https://doi.org/10.5281/zenodo.23619187", "metadata": {"title": "Replication package for \"Paid for the extra hours? Homeworking access, unpaid overtime and the sectoral terms of discretion in UK employment\"", "doi": "10.5281/zenodo.23619187", "publication_date": "2026-10-24", "description": "<p>This package provides Stata/SE 19.5 code, aggregate analysis tables, a construct dictionary and execution instructions for research on homeworking access and the remuneration of extra working time. The analyses use 119,332 employee interviews from 42,839 people in Understanding Society Waves 2, 4, 6, 8, 10, 12 and 14, covering 2010-2024. Files cover data preparation, measurement checks, pooled and person-fixed-effects models, sector comparisons, sensitivity analyses and secondary bootstrap calculations. A standalone Stata script reproduces the coefficient figure without microdata. All findings are associational. No person-level survey data or respondent identifiers are included.</p>", "access_right": "open", "creators": [{"name": "Naqvi, Ariz", "affiliation": "American University of the Middle East", "orcid": "0000-0002-8539-7953"}, {"name": "Naqvi, Farah", "affiliation": "University of Wolverhampton", "orcid": "0000-0002-2944-3425"}], "keywords": ["homeworking; unpaid overtime; paid overtime; working time; employment relations; Understanding Society; panel data; Stata."], "related_identifiers": [{"identifier": "10.5255/UKDA-SN-6614-22", "relation": "isSourceOf", "resource_type": "dataset", "scheme": "doi"}], "version": "1.0.0", "resource_type": {"title": "Computational notebook", "type": "software", "subtype": "computationalnotebook"}, "license": {"id": "cc-by-4.0"}, "communities": [{"id": "ariznaqvi"}], "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "23619186"}}]}}, "title": "Replication package for \"Paid for the extra hours? Homeworking access, unpaid overtime and the sectoral terms of discretion in UK employment\"", "links": {"self": "https://zenodo.org/api/records/23619187", "self_html": "https://zenodo.org/records/23619187", "preview_html": "https://zenodo.org/records/23619187?preview=1", "doi": "https://doi.org/10.5281/zenodo.23619187", "self_doi": "https://doi.org/10.5281/zenodo.23619187", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23619187", "reserve_doi": "https://zenodo.org/api/records/23619187/draft/pids/doi", "parent": "https://zenodo.org/api/records/23619186", "parent_html": "https://zenodo.org/records/23619186", "parent_doi": "https://doi.org/10.5281/zenodo.23619186", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23619186", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:23619187/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:23619187/sequence/default", "files": "https://zenodo.org/api/records/23619187/files", "media_files": "https://zenodo.org/api/records/23619187/media-files", "latest": "https://zenodo.org/api/records/23619187/versions/latest", "latest_html": "https://zenodo.org/records/23619187/latest", "versions": "https://zenodo.org/api/records/23619187/versions", "draft": "https://zenodo.org/api/records/23619187/draft", "access_links": "https://zenodo.org/api/records/23619187/access/links", "access_grants": "https://zenodo.org/api/records/23619187/access/grants", "access_users": "https://zenodo.org/api/records/23619187/access/users", "access_request": "https://zenodo.org/api/records/23619187/access/request", "access": "https://zenodo.org/api/records/23619187/access", "communities": "https://zenodo.org/api/records/23619187/communities", "communities-suggestions": "https://zenodo.org/api/records/23619187/communities-suggestions", "request_deletion": "https://zenodo.org/api/records/23619187/request-deletion", "file_modification": "https://zenodo.org/api/records/23619187/file-modification", "quota_increase": "https://zenodo.org/api/records/23619187/quota-increase", "requests": "https://zenodo.org/api/records/23619187/requests"}, "updated": "2026-10-24T14:01:04.012936+00:00", "recid": "23619187", "revision": 4, "files": [{"id": "cb0d283a-0c8d-4604-a8a9-129910de2d39", "key": "Homeworking_Access_Replication.zip", "size": 186369, "checksum": "md5:18d0351c6ff25a1cb8c7380b13747ba3", "links": {"self": "https://zenodo.org/api/records/23619187/files/Homeworking_Access_Replication.zip/content"}}], "swh": null, "owners": [{"id": "1671942"}], "status": "published", "stats": {"downloads": 1, "unique_downloads": 1, "views": 5, "unique_views": 5, "version_downloads": 1, "version_unique_downloads": 1, "version_unique_views": 5, "version_views": 5}, "state": "done", "submitted": true}, {"created": "2026-10-24T11:11:27.315553+00:00", "modified": "2026-10-24T11:11:27.548987+00:00", "id": 23614843, "conceptrecid": "23614842", "doi": "10.5281/zenodo.23614843", "conceptdoi": "10.5281/zenodo.23614842", "doi_url": "https://doi.org/10.5281/zenodo.23614843", "metadata": {"title": "Replication Package for \"InfraLink: Can LLM Agents Infer Missing Infrastructure as Code Dependencies?\"", "doi": "10.5281/zenodo.23614843", "publication_date": "2026-10-24", "description": "<p>To be able to use the replication package follow the steps:</p>\n<ul>\n<li>Install Docker by following the instructions for your operating system described&nbsp;<a href=\"https://docs.docker.com/engine/install/\">here</a>.</li>\n<li>Run <code>docker load &lt; infralink.tar</code> in the folder with the tar file previously downloaded.</li>\n<li>Run <code>docker run -it --name infralink infralink:v1 /bin/bash</code> if you only want to run the steps that do not require LLM inference. If you want to run the steps that involve using LLM inference, you will need to have an <a href=\"https://openrouter.ai/\">OpenRouter</a> key with credits (we estimate a cost of around $100 to run everything) and you can run instead <code>docker run -e OPENROUTER_API_KEY:&lt;your-api-key&gt; -it --name infralink infralink:v1 /bin/bash</code>.</li>\n<li>To be able to return to the container, run <code>docker attach infralink</code>.</li>\n</ul>\n<p>The docker container is ready to use!</p>\n<p>It is important to mention that these instructions were tested with a MacOS Tahoe 26.2 system. For other operating systems, some adjustments may need to be made.</p>\n<p>After these steps, check the README on the root folder.</p>\n<h2>Running on x86 machines</h2>\n<p>To run this image in an x86 machine, you might need to use emulation.</p>\n<ul>\n<li>On the first time, run&nbsp;<code>docker run --privileged --rm tonistiigi/binfmt --install all</code>.</li>\n<li>Then, simply add the flag <code>--platform=linux/arm64</code> on the <code>docker run</code> command shown in the replication steps.</li>\n</ul>\n<p>The Docker container includes depends-off's code, the code to replicate the evaluation, and the obtained results.</p>", "access_right": "open", "creators": [{"name": "Anonymous", "affiliation": null}], "resource_type": {"title": "Software", "type": "software"}, "license": {"id": "cc-by-4.0"}, "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "23614842"}}]}}, "title": "Replication Package for \"InfraLink: Can LLM Agents Infer Missing Infrastructure as Code Dependencies?\"", "links": {"self": "https://zenodo.org/api/records/23614843", "self_html": "https://zenodo.org/records/23614843", "preview_html": "https://zenodo.org/records/23614843?preview=1", "doi": "https://doi.org/10.5281/zenodo.23614843", "self_doi": "https://doi.org/10.5281/zenodo.23614843", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23614843", "reserve_doi": "https://zenodo.org/api/records/23614843/draft/pids/doi", "parent": "https://zenodo.org/api/records/23614842", "parent_html": "https://zenodo.org/records/23614842", "parent_doi": "https://doi.org/10.5281/zenodo.23614842", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23614842", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:23614843/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:23614843/sequence/default", "files": "https://zenodo.org/api/records/23614843/files", "media_files": "https://zenodo.org/api/records/23614843/media-files", "latest": "https://zenodo.org/api/records/23614843/versions/latest", "latest_html": "https://zenodo.org/records/23614843/latest", "versions": "https://zenodo.org/api/records/23614843/versions", "draft": "https://zenodo.org/api/records/23614843/draft", "access_links": "https://zenodo.org/api/records/23614843/access/links", "access_grants": "https://zenodo.org/api/records/23614843/access/grants", "access_users": "https://zenodo.org/api/records/23614843/access/users", "access_request": "https://zenodo.org/api/records/23614843/access/request", "access": "https://zenodo.org/api/records/23614843/access", "communities": "https://zenodo.org/api/records/23614843/communities", "communities-suggestions": "https://zenodo.org/api/records/23614843/communities-suggestions", "request_deletion": "https://zenodo.org/api/records/23614843/request-deletion", "file_modification": "https://zenodo.org/api/records/23614843/file-modification", "quota_increase": "https://zenodo.org/api/records/23614843/quota-increase", "requests": "https://zenodo.org/api/records/23614843/requests"}, "updated": "2026-10-24T11:11:27.548987+00:00", "recid": "23614843", "revision": 4, "files": [{"id": "c68ad019-daa6-467b-9083-584f9f22247d", "key": "infralink.tar", "size": 988676608, "checksum": "md5:75ca1ab521d770314d955817bb49dd01", "links": {"self": "https://zenodo.org/api/records/23614843/files/infralink.tar/content"}}], "swh": null, "owners": [{"id": "1836331"}], "status": "published", "stats": {"downloads": 1, "unique_downloads": 1, "views": 11, "unique_views": 6, "version_downloads": 1, "version_unique_downloads": 1, "version_unique_views": 6, "version_views": 11}, "state": "done", "submitted": true}, {"created": "2026-10-24T10:40:34.015794+00:00", "modified": "2026-10-24T10:40:34.166057+00:00", "id": 23614142, "conceptrecid": "23614141", "doi": "10.5281/zenodo.23614142", "conceptdoi": "10.5281/zenodo.23614141", "doi_url": "https://doi.org/10.5281/zenodo.23614142", "metadata": {"title": "Replication Package for: Does Graph Structure Still Help? Replicating and Extending IR-Augmented LLM Vulnerability Detection", "doi": "10.5281/zenodo.23614142", "publication_date": "2026-10-24", "description": "<p>This is the replication package for the paper:<br>\"Does Graph Structure Still Help? Replicating and Extending IR-Augmented LLM Vulnerability Detection\"</p>\n<p><strong>Overview:</strong><br>This package contains all code, prompts, intermediate representations (IR), evaluation scripts, and experimental results for:</p>\n<ol>\n<li>Replicating the GRACE vulnerability detection framework on the Devign and ReVeal datasets using three LLMs (GPT-5.6-Luna, DeepSeek-Flash, and Claude Sonnet 5).</li>\n<li>Extending IR-augmented vulnerability detection across 7 programming languages using the REEF benchmark.</li>\n<li>Evaluating the impact of IR generation environments and representations (no IR, legacy IR, modern IR, aligned IR, and incremental transformation stages G1-G4).</li>\n</ol>\n<p><strong>Contents:</strong></p>\n<ul>\n<li>data/: Raw benchmark data, external reproduction subsets, and generated inputs (including all IR conditions: no_ir, old_ir, modern_ir, aligned_ir, and RQ4 ablation variants).</li>\n<li>scripts/: Python and bash scripts for data preparation, IR extraction and transformation via Joern, LLM inference, and evaluation metric calculation.</li>\n<li>results/: Complete experimental outputs (predictions, metrics, raw responses) matching the findings reported in the paper.</li>\n</ul>\n<p>Note on terminology:<br>The condition referred to as \"legacy IR\" in the paper is labeled as \"old_ir\" (or \"old IR\") in the directory names, data files, and experimental scripts within this package.</p>\n<p>For prerequisites, environment setup, and instructions to reproduce the results, please see README.md inside the package.<br>See the LICENSE file in the package for the specific scope of each component.</p>", "access_right": "open", "creators": [{"name": "Anonymous, Author(s)", "affiliation": null}], "resource_type": {"title": "Software", "type": "software"}, "license": {"id": "mit-license"}, "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "23614141"}}]}}, "title": "Replication Package for: Does Graph Structure Still Help? Replicating and Extending IR-Augmented LLM Vulnerability Detection", "links": {"self": "https://zenodo.org/api/records/23614142", "self_html": "https://zenodo.org/records/23614142", "preview_html": "https://zenodo.org/records/23614142?preview=1", "doi": "https://doi.org/10.5281/zenodo.23614142", "self_doi": "https://doi.org/10.5281/zenodo.23614142", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23614142", "reserve_doi": "https://zenodo.org/api/records/23614142/draft/pids/doi", "parent": "https://zenodo.org/api/records/23614141", "parent_html": "https://zenodo.org/records/23614141", "parent_doi": "https://doi.org/10.5281/zenodo.23614141", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23614141", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:23614142/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:23614142/sequence/default", "files": "https://zenodo.org/api/records/23614142/files", "media_files": "https://zenodo.org/api/records/23614142/media-files", "latest": "https://zenodo.org/api/records/23614142/versions/latest", "latest_html": "https://zenodo.org/records/23614142/latest", "versions": "https://zenodo.org/api/records/23614142/versions", "draft": "https://zenodo.org/api/records/23614142/draft", "access_links": "https://zenodo.org/api/records/23614142/access/links", "access_grants": "https://zenodo.org/api/records/23614142/access/grants", "access_users": "https://zenodo.org/api/records/23614142/access/users", "access_request": "https://zenodo.org/api/records/23614142/access/request", "access": "https://zenodo.org/api/records/23614142/access", "communities": "https://zenodo.org/api/records/23614142/communities", "communities-suggestions": "https://zenodo.org/api/records/23614142/communities-suggestions", "request_deletion": "https://zenodo.org/api/records/23614142/request-deletion", "file_modification": "https://zenodo.org/api/records/23614142/file-modification", "quota_increase": "https://zenodo.org/api/records/23614142/quota-increase", "requests": "https://zenodo.org/api/records/23614142/requests"}, "updated": "2026-10-24T10:40:34.166057+00:00", "recid": "23614142", "revision": 4, "files": [{"id": "6c22f7b1-015c-4d2a-bb8f-f754aef0748d", "key": "replication_package.zip", "size": 111338442, "checksum": "md5:99151a6f5286661552f46682285b3b12", "links": {"self": "https://zenodo.org/api/records/23614142/files/replication_package.zip/content"}}], "swh": null, "owners": [{"id": "1962579"}], "status": "published", "stats": {"downloads": 1, "unique_downloads": 1, "views": 5, "unique_views": 5, "version_downloads": 1, "version_unique_downloads": 1, "version_unique_views": 5, "version_views": 5}, "state": "done", "submitted": true}, {"created": "2026-10-24T10:16:18.209159+00:00", "modified": "2026-10-24T10:16:18.654338+00:00", "id": 23615180, "conceptrecid": "23615179", "doi": "10.5281/zenodo.23615180", "conceptdoi": "10.5281/zenodo.23615179", "doi_url": "https://doi.org/10.5281/zenodo.23615180", "metadata": {"title": "STRATUM: Repository Memory for Coding Agents \u2014 Replication Package", "doi": "10.5281/zenodo.23615180", "publication_date": "2026-10-24", "description": "<p>Anonymous replication package for a double-blind submission arguing that coding agents need persistent, experience-aware repository memory rather than a larger context window.</p><p>Contains every script and raw measurement behind the paper's motivating study and preliminary experiments:</p><ul><li><b>F1</b> \u2014 token census of six open-source repositories and the representation-cost gap between storing knowledge as indexed text vs. as model key-value (KV) cache state (e.g. ~4 GB as text vs. ~298 TB as fp16 KV state per billion tokens, 70B model).</li><li><b>F2</b> \u2014 the working-set size of 752 real bug-fix commits: the median fix touches two files, and the one-hop import closure is 2.7-9.9% of the repository.</li><li><b>F3</b> \u2014 how much of real file co-change is visible to static analysis (852 commits, 4 repositories): 47.3% of co-edited file pairs remain disconnected even under transitive import reachability and test-name links.</li><li><b>E4</b> \u2014 retrieval latency over a synthetic 10^6-node SQLite+HNSW store: 1.70 ms median / 2.76 ms p99 end-to-end.</li><li><b>E5</b> \u2014 a real multi-session agent experiment on 8 real bugs using the Claude API: a reader model that inherits a different (writer) model's memory diagnoses the bug correctly in 21/24 trials vs. 6/24 for a retrieval-only baseline (one-sided Fisher exact p = 1.27e-05), at 4.5x lower median token cost; accumulated memory (26 pooled notes) stays at 8/8; a whole-repository-in-context baseline matches memory's success rate at 3.8x the per-call token cost and no persistence.</li></ul><p>The package also includes the paper's architecture figure (hand-authored SVG, no third-party icon assets) and a full requirements/setup README.</p><p><b>Anonymity note:</b> creator metadata is intentionally set to Anonymous for double-blind review. Author identity will be added after the review process concludes.</p>", "access_right": "open", "creators": [{"name": "Anonymous", "affiliation": null}], "keywords": ["coding agents", "LLM memory", "repository mining", "software engineering", "replication package", "context management", "retrieval-augmented generation"], "resource_type": {"title": "Software", "type": "software"}, "license": {"id": "cc-by-4.0"}, "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "23615179"}}]}, "notes": "Prepared for anonymous double-blind peer review. Does not include the LaTeX paper source or third-party repository source code (regenerable from the included scripts)."}, "title": "STRATUM: Repository Memory for Coding Agents \u2014 Replication Package", "links": {"self": "https://zenodo.org/api/records/23615180", "self_html":