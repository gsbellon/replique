FROM docker.io/library/r-base:latest
# Ajouts exigés par README.md du paquet ("Requirements") : data.table, lpSolve, rDEA (GLPK), unzip, awk.
# Réseau nécessaire à la construction seulement : dépôts Debian (apt) et CRAN (cloud.r-project.org). Les exécutions restent --network none.
RUN apt-get update && apt-get install -y --no-install-recommends unzip gawk libglpk-dev r-cran-data.table r-cran-lpsolve && rm -rf /var/lib/apt/lists/*
RUN Rscript -e 'install.packages("rDEA", repos="https://cloud.r-project.org"); stopifnot(requireNamespace("rDEA"))'
