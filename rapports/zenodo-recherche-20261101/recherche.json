/files/runs_s23.zip.008/content"}}, {"id": "6bdf9419-9c4a-4449-bcfc-b50354777947", "key": "runs_s23.zip.012", "size": 25000000, "checksum": "md5:10936d1730377dc9d797f51bf375e7b1", "links": {"self": "https://zenodo.org/api/records/23304267/files/runs_s23.zip.012/content"}}, {"id": "598a11d7-9af2-4672-97ad-88225c5346ed", "key": "runs_s23.zip.020", "size": 2055290, "checksum": "md5:212af754d29f9f29acd7659a92de2817", "links": {"self": "https://zenodo.org/api/records/23304267/files/runs_s23.zip.020/content"}}, {"id": "bf6972ad-7029-4d10-b634-4cf9561712ed", "key": "runs_s23.zip.013", "size": 25000000, "checksum": "md5:74f9472a2d965296a0d3b77df18de84c", "links": {"self": "https://zenodo.org/api/records/23304267/files/runs_s23.zip.013/content"}}, {"id": "f130f2ea-0b34-4851-a1c9-36066394cc78", "key": "runs_s23.zip.019", "size": 25000000, "checksum": "md5:90d376185380f8224fce595a0c141036", "links": {"self": "https://zenodo.org/api/records/23304267/files/runs_s23.zip.019/content"}}, {"id": "1842a6e2-5800-4136-b036-e302a569c39b", "key": "runs_s23.zip.017", "size": 25000000, "checksum": "md5:1783303af8d1b744c3f08b337fe2aa7a", "links": {"self": "https://zenodo.org/api/records/23304267/files/runs_s23.zip.017/content"}}], "swh": null, "owners": [{"id": "1844757"}], "status": "published", "stats": {"downloads": 7, "unique_downloads": 6, "views": 8, "unique_views": 8, "version_downloads": 7, "version_unique_downloads": 6, "version_unique_views": 8, "version_views": 8}, "state": "done", "submitted": true}, {"created": "2026-10-30T17:00:59.780154+00:00", "modified": "2026-10-30T17:00:59.996338+00:00", "id": 23778983, "conceptrecid": "22548161", "doi": "10.5281/zenodo.23778983", "conceptdoi": "10.5281/zenodo.22548161", "doi_url": "https://doi.org/10.5281/zenodo.23778983", "metadata": {"title": "Reproducibility package for From Anomaly Detection to Cause-Aware Response: Counterfactual Resilience Control for Cloud-Native Microservices", "doi": "10.5281/zenodo.23778983", "publication_date": "2026-10-30", "description": "<p><strong>Replication package for &ldquo;From Anomaly Detection to Cause-Aware Response: Counterfactual Resilience Control for Cloud-Native Microservices&rdquo; &mdash; Version 4.2</strong></p>\n<p>This record provides the complete synthetic-data replication package supporting the study <em>From Anomaly Detection to Cause-Aware Response: Counterfactual Resilience Control for Cloud-Native Microservices</em>. It incorporates the original ten-master-seed benchmark in full (12,200 synthetic episode specifications, including NORMAL reference episodes, and 109,800 candidate-action outcomes), together with the code, inputs, stored results, and verification tools for all subsequent analyses reported in the revised manuscript. Users do not need a separate download of the earlier benchmark version.</p>\n<p>The archive contains the original simulator and evaluation pipeline, an independent sampled replay (M1), matched-action comparisons (M2), actuator-selectivity experiments including 23,700 additional synthetic simulator rollouts (M3), graph reachability and physical-fault diagnostics (M4), classifier-error and action-regret analyses (M5), and cause-aware versus cause-agnostic loss decomposition with subgroup analyses (M6).</p>\n<p>It also includes supplementary tables S1, S2, S2b, and S3, all seven vector figures, pinned Python dependencies, a manuscript-to-evidence map, reproducibility instructions, validation scripts, a complete SHA-256 file manifest, and a version changelog.</p>\n<p>All measurements and outcomes are generated in an abstract simulated microservice environment. No deployed Kubernetes cluster, production telemetry, or field-effectiveness assessment is included. Model comparisons and subgroup analyses should be interpreted within the stated simulator assumptions. Secondary analyses are exploratory, and uncertainty is evaluated at the master-seed level.</p>\n<p>The archive contains stored reference results and executable scripts for independent verification and regeneration. A complete rerun of the more computationally intensive simulations may require substantial computing time.</p>\n<p><strong>Licensing:</strong> Author-owned software and executable configurations are provided under the MIT License. Author-owned synthetic data, numerical results, tables, figures, and scientific documentation are provided under Creative Commons Attribution 4.0 International (CC BY 4.0). The files <code>LICENSE.md</code>, <code>LICENSE-CODE</code>, and <code>LICENSE-DATA</code> specify the scope of each license.</p>\n<p><strong>Version-specific DOI:</strong> <a href=\"https://doi.org/10.5281/zenodo.23778983\">https://doi.org/10.5281/zenodo.23778983</a></p>", "access_right": "open", "creators": [{"name": "Bondaruk, Tymofii", "affiliation": "G.E. Pukhov Institute for Modelling in Energy Engineering of the National Academy of Sciences of Ukraine", "orcid": "0009-0000-8120-2787"}, {"name": "Shkarupylo, Vadym", "affiliation": "G.E. Pukhov Institute for Modelling in Energy Engineering of the National Academy of Sciences of Ukraine", "orcid": "0000-0002-0523-8910"}, {"name": "Artemchuk, Volodymyr", "affiliation": "G.E. Pukhov Institute for Modelling in Energy Engineering of NAS of Ukraine", "orcid": "0000-0001-8819-4564"}], "keywords": ["cloud-native resilience", "microservices", "cause-aware control", "counterfactual simulation", "autoscaling", "distributed denial of service", "root cause analysis", "self-healing systems", "uncertainty quantification"], "version": "4.2", "language": "eng", "resource_type": {"title": "Software", "type": "software"}, "license": {"id": "cc-by-4.0"}, "relations": {"version": [{"index": 1, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "22548161"}}]}}, "title": "Reproducibility package for From Anomaly Detection to Cause-Aware Response: Counterfactual Resilience Control for Cloud-Native Microservices", "links": {"self": "https://zenodo.org/api/records/23778983", "self