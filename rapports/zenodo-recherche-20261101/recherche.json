lf_iiif_sequence": "https://zenodo.org/api/iiif/record:23820270/sequence/default", "files": "https://zenodo.org/api/records/23820270/files", "media_files": "https://zenodo.org/api/records/23820270/media-files", "latest": "https://zenodo.org/api/records/23820270/versions/latest", "latest_html": "https://zenodo.org/records/23820270/latest", "versions": "https://zenodo.org/api/records/23820270/versions", "draft": "https://zenodo.org/api/records/23820270/draft", "access_links": "https://zenodo.org/api/records/23820270/access/links", "access_grants": "https://zenodo.org/api/records/23820270/access/grants", "access_users": "https://zenodo.org/api/records/23820270/access/users", "access_request": "https://zenodo.org/api/records/23820270/access/request", "access": "https://zenodo.org/api/records/23820270/access", "communities": "https://zenodo.org/api/records/23820270/communities", "communities-suggestions": "https://zenodo.org/api/records/23820270/communities-suggestions", "request_deletion": "https://zenodo.org/api/records/23820270/request-deletion", "file_modification": "https://zenodo.org/api/records/23820270/file-modification", "quota_increase": "https://zenodo.org/api/records/23820270/quota-increase", "requests": "https://zenodo.org/api/records/23820270/requests"}, "updated": "2026-10-31T08:13:28.958017+00:00", "recid": "23820270", "revision": 4, "files": [{"id": "4f147335-3570-43b1-b1ed-590e77509a7c", "key": "strobilus-occ-benchmarks.tar.gz", "size": 24953200, "checksum": "md5:bd264e405809e73615d8a5bea4f1aaa7", "links": {"self": "https://zenodo.org/api/records/23820270/files/strobilus-occ-benchmarks.tar.gz/content"}}], "swh": null, "owners": [{"id": "1978372"}], "status": "published", "stats": {"downloads": 1, "unique_downloads": 1, "views": 6, "unique_views": 6, "version_downloads": 1, "version_unique_downloads": 1, "version_unique_views": 6, "version_views": 6}, "state": "done", "submitted": true}, {"created": "2026-10-30T17:49:55.388236+00:00", "modified": "2026-10-30T17:49:59.061524+00:00", "id": 23304267, "conceptrecid": "23304266", "doi": "10.5281/zenodo.23304267", "conceptdoi": "10.5281/zenodo.23304266", "doi_url": "https://doi.org/10.5281/zenodo.23304267", "metadata": {"title": "Replication package: Integrity-Preserving Peer-to-Peer Energy Trading Under Asynchronous Negotiation in Distribution Networks", "doi": "10.5281/zenodo.23304267", "publication_date": "2026-10-11", "description": "<p>Code, input data, and aggregated results reproducing every table and figure of the paper: the causality-based peer-to-peer trading engine with asynchronous negotiation on the IEEE 33-bus (single-phase) and IEEE 123-bus (three-phase unbalanced) feeders, the bounded update and the rule-based dropout detector, the asynchronous consensus-ADMM baseline, the step-size and response-delay stability campaign, the threshold-sensitivity and false-positive campaigns, the feeder-end manipulation case, and the analysis scripts that compute same-set, harmed-group and residual-optimum welfare at the averaged schedule. Each table of the paper is mapped to the script and command that produce it in README.md.</p>", "access_right": "open", "creators": [{"name": "Chu, Yeonouk", "affiliation": "Seoul National University"}, {"name": "Kim, Hyunjoong", "affiliation": "Hanbat National University"}, {"name": "Yoon, Yongtae", "affiliation": "Seoul National University"}], "keywords": ["peer-to-peer energy trading", "asynchronous negotiation", "distribution network", "causality-based cost allocation", "market integrity", "three-phase unbalanced power flow", "consensus ADMM"], "language": "eng", "resource_type": {"title": "Software", "type": "software"}, "license": {"id": "mit-license"}, "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "23304266"}}]}}, "title": "Replication package: Integrity-Preserving Peer-to-Peer Energy Trading Under Asynchronous Negotiation in Distribution Networks", "links": {"self": "https:/