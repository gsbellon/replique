ants", "access_users": "https://zenodo.org/api/records/23856205/access/users", "access_request": "https://zenodo.org/api/records/23856205/access/request", "access": "https://zenodo.org/api/records/23856205/access", "communities": "https://zenodo.org/api/records/23856205/communities", "communities-suggestions": "https://zenodo.org/api/records/23856205/communities-suggestions", "request_deletion": "https://zenodo.org/api/records/23856205/request-deletion", "file_modification": "https://zenodo.org/api/records/23856205/file-modification", "quota_increase": "https://zenodo.org/api/records/23856205/quota-increase", "requests": "https://zenodo.org/api/records/23856205/requests"}, "updated": "2026-11-01T10:06:33.644679+00:00", "recid": "23856205", "revision": 4, "files": [{"id": "0ae11395-1ac4-4e1d-9eac-3923d85ea07e", "key": "xc-tcp-replication-v1.3.0 (1).zip", "size": 3729265, "checksum": "md5:6248325af16a89282afdf19a6e3911f1", "links": {"self": "https://zenodo.org/api/records/23856205/files/xc-tcp-replication-v1.3.0%20(1).zip/content"}}], "swh": null, "owners": [{"id": "1915797"}], "status": "published", "stats": {"downloads": 0, "unique_downloads": 0, "views": 62, "unique_views": 57, "version_downloads": 0, "version_unique_downloads": 0, "version_unique_views": 1, "version_views": 1}, "state": "done", "submitted": true}, {"created": "2026-11-01T09:44:11.680605+00:00", "modified": "2026-11-01T09:44:11.922818+00:00", "id": 23846180, "conceptrecid": "23846179", "doi": "10.5281/zenodo.23846180", "conceptdoi": "10.5281/zenodo.23846179", "doi_url": "https://doi.org/10.5281/zenodo.23846180", "metadata": {"title": "Replication package for \"Recruitment and Recurrent Career Transitions in Mexico's National System of Researchers: A 35-Year Institutional Study\" (UAZ\u2013SNII, 1990\u20132025)", "doi": "10.5281/zenodo.23846180", "publication_date": "2026-10-31", "description": "<p>Replication package for a 35-year institutional study of recruitment into, and recurrent career transitions within, Mexico's National System of Researchers (SNI/SNII) at the Universidad Aut&oacute;noma de Zacatecas, 1990&ndash;2025. The package contains the analysis code (Python 3.12) and 18 reviewed aggregate files: the annual series of active members and first institutional appearances, doctoral-faculty totals and nominal gap, origin&ndash;destination transition probabilities, model comparison and validation scores, sensitivity analyses and the conditional 2025&rarr;2026 forecast. The aggregate route regenerates Figures 2&ndash;6 and the numerical sources of Tables 3&ndash;7; a separate script set reproduces the negative binomial recruitment reanalysis (Table 4, Appendix Tables A1&ndash;A2, Figure 3). Person-level records, identity crosswalks and affiliation evidence are not included because they could identify individual researchers through linkage with public rolls. Documentation covers the data dictionary, reproducibility scope, privacy controls and verification record. Code is released under the MIT licence; data and documentation under CC BY 4.0.</p>", "access_right": "open", "creators": [{"name": "Bautista-Capetillo, Carlos", "affiliation": "Universidad Aut\u00f3noma de Zacatecas \"Francisco Garc\u00eda Salinas\"", "orcid": "0000-0003-2100-7415"}, {"name": "Gonzalez Perez, Georgia Aralu", "affiliation": "Universidad Aut\u00f3noma de Zacatecas \"Francisco Garc\u00eda Salinas\"", "orcid": "0000-0002-3201-8147"}], "version": "2.1.0", "language": "eng", "resource_type": {"title": "Software", "type": "software"}, "license": {"id": "cc-by-4.0"}, "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "23846179"}}]}}, "title": "Replication package for \"Recruitment and Recurrent Career Transitions in Mexico's National System of Researchers: A 35-Year Institutional Study\" (UAZ\u2013SNII, 1990\u20132025)", "links": {"self": "https://zenodo.org/api/records/23846180", "self_html": "https://zenodo.org/records/23846180", "preview_html": "https://zenodo.org/records/23846180?preview=1", "doi": "https://doi.org/10.5281/zenodo.23846180", "self_doi": "https://doi.org/10.5281/zenodo.23846180", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23846180", "reserve_doi": "https://zenodo.org/api/records/23846180/draft/pids/doi", "parent": "https://zenodo.org/api/records/23846179", "parent_html": "https://zenodo.org/records/23846179", "parent_doi": "https://doi.org/10.5281/zenodo.23846179", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23846179", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:23846180/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:23846180/sequence/default", "files": "https://zenodo.org/api/records/23846180/files", "media_files": "https://zenodo.org/api/records/23846180/media-files", "latest": "https://zenodo.org/api/records/23846180/versions/latest", "latest_html": "https://zenodo.org/records/23846180/latest", "versions": "https://zenodo.org/api/records/23846180/versions", "draft": "https://zenodo.org/api/records/23846180/draft", "access_links": "https://zenodo.org/api/records/23846180/access/links", "access_grants": "https://zenodo.org/api/records/23846180/access/grants", "access_users": "https://zenodo.org/api/records/23846180/access/users", "access_request": "https://zenodo.org/api/records/23846180/access/request", "access": "https://zenodo.org/api/records/23846180/access", "communities": "https://zenodo.org/api/records/23846180/communities", "communities-suggestions": "https://zenodo.org/api/records/23846180/communities-suggestions", "request_deletion": "https://zenodo.org/api/records/23846180/request-deletion", "file_modification": "https://zenodo.org/api/records/23846180/file-modification", "quota_increase": "https://zenodo.org/api/records/23846180/quota-increase", "requests": "https://zenodo.org/api/records/23846180/requests"}, "updated": "2026-11-01T09:44:11.922818+00:00", "recid": "23846180", "revision": 4, "files": [{"id": "1f40f07f-8ce8-4e9a-a14f-aea78fe3a535", "key": "UAZ_SNII_repositorio_publico_v2.1.0.zip", "size": 323131, "checksum": "md5:a2e80a855e1b8d125f67857840baf011", "links": {"self": "https://zenodo.org/api/records/23846180/files/UAZ_SNII_repositorio_publico_v2.1.0.zip/content"}}], "swh": null, "owners": [{"id": "1980258"}], "status": "published", "stats": {"downloads": 0, "unique_downloads": 0, "views": 4, "unique_views": 4, "version_downloads": 0, "version_unique_downloads": 0, "version_unique_views": 4, "version_views": 4}, "state": "done", "submitted": true}, {"created": "2026-10-31T23:43:50.941691+00:00", "modified": "2026-10-31T23:43:51.146802+00:00", "id": 23849169, "conceptrecid": "23512823", "doi": "10.5281/zenodo.23849169", "conceptdoi": "10.5281/zenodo.23512823", "doi_url": "https://doi.org/10.5281/zenodo.23849169", "metadata": {"title": "Replication Package for: Two-Regime Volume\u2013Area Scaling of Earth's Terrestrial Landmasses: A Global Digital-Elevation Analysis", "doi": "10.5281/zenodo.23849169", "publication_date": "2026-10-31", "description": "<p>Terrestrial landmasses vary by more than five orders of magnitude in planimetric area, yet the relationship between their area and subaerial volume remains incompletely quantified. The present study extends previous empirical testing of the self-affine model of topography by separating sub-ice bedrock from ice-surface volume and comparing islands with whole continents. We make use of the global Copernicus GLO-90 Digital Elevation Model supplemented by BedMachine sub-ice bedrock topography and cross-validated against NOAA ETOPO 2022 and ETOPO1 to analyse volume--area scaling ($V_{\\text{bed}} = c\\,A^\\beta$) across 470 non-continental bedrock islands ($\\ge 500\\,\\text{km}^2$) and Earth's major continents. We identify a two-regime allometric hierarchy in Earth's subaerial topography. Non-continental landmasses exhibit superlinear scaling with $\\beta \\approx 1.15\\text{--}1.24$ ($R^2 = 0.70\\text{--}0.84$, cluster-robust $p &lt; 10^{-9}$), reflecting the self-affine accumulation of relief with island size ($\\bar{z} \\propto A^{0.15\\text{--}0.24}$). Whole continents at sea level follow a significantly steeper global relation, $\\beta \\approx 1.61\\text{--}1.75$ ($R^2 = 0.98$). However, continents scatter along a three-tier structure, which suggests that, locally, continental scaling may still exhibit alignment with islands scaling.</p>\n<p>Changelog:</p>\n<ul>\n<li><em>Updated title and narrative structure to reflect submission to Geomorphology.</em></li>\n<li><em>Streamlined focus on the two-regime hierarchy (470 islands vs. 7 continents) and size-governed tectonic tiers.</em></li>\n<li><em>Updated diagnostic figures and submission manuscript PDF.</em></li>\n</ul>", "access_right": "open", "creators": [{"name": "Ben\u021ba, Marius Ion", "affiliation": null, "orcid": "0000-0002-8930-1090"}], "keywords": ["systemic allometric scaling", "hypsometry", "digital elevation model", "continental volume"], "version": "1.1.0", "language": "eng", "custom": {"code:codeRepository": "https://github.com/baeckett/landmass-allometry", "code:programmingLanguage": [{"id": "python", "title": {"en": "Python"}}]}, "resource_type": {"title": "Software", "type": "software"}, "license": {"id": "cc-by-4.0"}, "relations": {"version": [{"index": 1, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "23512823"}}]}}, "title": "Replication Package for: Two-Regime Volume\u2013Area Scaling of Earth's Terrestrial Landmasses: A Global Digital-Elevation Analysis", "links": {"self": "https://zenodo.org/api/records/23849169", "self_html": "https://zenodo.org/records/23849169", "preview_html": "https://zenodo.org/records/23849169?preview=1", "doi": "https://doi.org/10.5281/zenodo.23849169", "self_doi": "https://doi.org/10.5281/zenodo.23849169", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23849169", "reserve_doi": "https://zenodo.org/api/records/23849169/draft/pids/doi", "parent": "https://zenodo.org/api/records/23512823", "parent_html": "https://zenodo.org/records/23512823", "parent_doi": "https://doi.org/10.5281/zenodo.23512823", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23512823", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:23849169/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:23849169/sequence/default", "files": "https://zenodo.org/api/records/23849169/files", "media_files": "https://zenodo.org/api/records/23849169/media-files", "latest": "https://zenodo.org/api/records/23849169/versions/latest", "latest_html": "https://zenodo.org/records/23849169/latest", "versions": "https://zenodo.org/api/records/23849169/versions", "draft": "https://zenodo.org/api/records/23849169/draft", "access_links": "https://zenodo.org/api/records/23849169/access/links", "access_grants": "https://zenodo.org/api/records/23849169/access/grants", "access_users": "https://zenodo.org/api/records/23849169/access/users", "access_request": "https://zenodo.org/api/records/23849169/access/request", "access": "https://zenodo.org/api/records/23849169/access", "communities": "https://zenodo.org/api/records/23849169/communities", "communities-suggestions": "https://zenodo.org/api/records/23849169/communities-suggestions", "request_deletion": "https://zenodo.org/api/records/23849169/request-deletion", "file_modification": "https://zenodo.org/api/records/23849169/file-modification", "quota_increase": "https://zenodo.org/api/records/23849169/quota-increase", "requests": "https://zenodo.org/api/records/23849169/requests"}, "updated": "2026-10-31T23:43:51.146802+00:00", "recid": "23849169", "revision": 4, "files": [{"id": "9fa0c1a2-7b1d-4c92-9e98-c28b3d77082f", "key": "zenodo_deposit_v1.1.0.zip", "size": 6058153, "checksum": "md5:68ba3d69963868f7080060d4fe2a8f7d", "links": {"self": "https://zenodo.org/api/records/23849169/files/zenodo_deposit_v1.1.0.zip/content"}}], "swh": null, "owners": [{"id": "58856"}], "status": "published", "stats": {"downloads": 3, "unique_downloads": 3, "views": 26, "unique_views": 19, "version_downloads": 0, "version_unique_downloads": 0, "version_unique_views": 4, "version_views": 7}, "state": "done", "submitted": true}, {"created": "2026-10-31T22:20:30.756190+00:00", "modified": "2026-11-01T20:03:44.786247+00:00", "id": 23847236, "conceptrecid": "23838384", "doi": "10.5281/zenodo.23847236", "conceptdoi": "10.5281/zenodo.23838384", "doi_url": "https://doi.org/10.5281/zenodo.23847236", "metadata": {"title": "Replication package: Are colour-coded economies empirically distinct? A cross-country test of economic specialisation", "doi": "10.5281/zenodo.23847236", "publication_date": "2026-10-31", "description": "<p>This archive contains the replication package for the article \"Are colour-coded economies empirically distinct? A cross-country test of economic specialisation\" (submitted to Structural Change and Economic Dynamics). It includes four Google Colab notebooks that reproduce all results, a fifth notebook that assembles the package, the HS 2017 product lists used to define the trade colours (UNCTADstat classifications), the activity-to-colour concordance files, all processed data, the supplementary workbook (Supplementary_Data.xlsx) and a data dictionary. Employment specialisation is computed from ILOSTAT (ISIC Rev. 4 divisions) and export specialisation from CEPII BACI (HS 2017, version 202601) for 2017&ndash;2024. Raw source files are not redistributed; the notebooks download them from the providers. Code is released under the MIT licence; derived data and product lists under CC BY 4.0.</p>", "access_right": "open", "creators": [{"name": "Allahverdi, Metin", "affiliation": "Sel\u00e7uk University", "orcid": "0000-0002-8247-4167"}], "resource_type": {"title": "Software", "type": "software"}, "license": {"id": "cc-by-4.0"}, "relations": {"version": [{"index": 3, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "23838384"}}]}}, "title": "Replicati