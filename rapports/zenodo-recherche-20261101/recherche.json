elected test identifiers are not redistributed; source locations and retrieval information are documented in the manifests. The adaptive reserve is reported as a conditional comparator rather than a universally optimal policy.</p>", "access_right": "open", "creators": [{"name": "Wang, FengQi", "affiliation": "Hubei University"}], "keywords": ["continuous integration", "software testing", "test selection", "feedback leakage", "budgeted evaluation", "empirical software engineering", "reproducibility", "EWMA", "reserve allocation"], "version": "R6", "language": "eng", "custom": {"code:programmingLanguage": [{"id": "python", "title": {"en": "Python"}}]}, "resource_type": {"title": "Software", "type": "software"}, "license": {"id": "cc-by-4.0"}, "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "23792429"}}]}}, "title": "An Auditable Evaluation Protocol for Budgeted Continuous-Integration Test Selection under Partial Feedback: Replication Package", "links": {"self": "https://zenodo.org/api/records/23792430", "self_html": "https://zenodo.org/records/23792430", "preview_html": "https://zenodo.org/records/23792430?preview=1", "doi": "https://doi.org/10.5281/zenodo.23792430", "self_doi": "https://doi.org/10.5281/zenodo.23792430", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23792430", "reserve_doi": "https://zenodo.org/api/records/23792430/draft/pids/doi", "parent": "https://zenodo.org/api/records/23792429", "parent_html": "https://zenodo.org/records/23792429", "parent_doi": "https://doi.org/10.5281/zenodo.23792429", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23792429", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:23792430/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:23792430/sequence/default", "files": "https://zenodo.org/api/records/23792430/files", "media_files": "https://zenodo.org/api/records/23792430/media-files", "latest": "https://zenodo.org/api/records/2